helperCreateMap: () Map<Str, Int32> {
    Map<Str, Int32> { }
}

pub Point: Mutable<Any> {
    pub x: Mutable<Int32>
    pub y: Mutable<Int32>

    pub dist: () Float64 {
        (x * x + y * y) as Float64
    }
}

Printable: Any {
    toStr: () Str
}

pub Circle: Mutable<Any> {
    pub center: Point
    pub radius: Mutable<Int32>

    pub area: () Float64 {
        3.14159 * (radius as Float64) * (radius as Float64)
    }
}

RED: Str = "red"
GREEN: Str = "green"
BLUE: Str = "blue"

compute: (values: List<Int32>) Int32 {
    acc: Mutable<Int32> = 0
    for i: Size in 0..values.size() {
        acc = acc + values[i]
    }
    acc
}


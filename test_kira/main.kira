helperCreateMap: () Map<Str, Int32> {
    return Map<Str, Int32> { }
}

pub Point: Any {
    pub mut x: Int32
    pub mut y: Int32

    pub dist: () Float64 {
        return (x * x + y * y) as Float64
    }
}

Printable: Any {
    toStr: () Str
}

pub Circle: Any {
    pub center: Point
    pub mut radius: Int32

    pub area: () Float64 {
        return 3.14159 * (radius as Float64) * (radius as Float64)
    }
}

RED: Str = "red"
GREEN: Str = "green"
BLUE: Str = "blue"

compute: (values: List<Int32>) Int32 {
    mut acc: Int32 = 0
    for mut i: 0..(values.size() - 1) {
        acc = acc + values[i]
    }
    return acc
}


ffi.cpp.app.shape as shape
ffi.cpp.app.shape.Box as Box
ffi.cpp.app.shape.LIMIT as LIMIT
ffi.cpp.app.shape.cLen as cLen
ffi.cpp.app.shape.countTo as countTo
ffi.cpp.app.shape.hypotSq as hypotSq
ffi.cpp.app.shape.makeBox as makeBox

// A Kira program over a C++ class, three C functions and a C macro constant, through extern.

main: () Int32 {
    box: Box = makeBox(3, 4)
    trace(box.area())
    box.grow(2)
    trace(box.area())
    trace(hypotSq(3, 4))
    trace(cLen("kira-ffi"))
    mut count: Int32 = 0
    countTo(mut count, 7)
    trace(count)
    trace(LIMIT)
    0
}

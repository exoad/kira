// Kira's view of native/shape.hxx (a C++ class) and native/cshape.h (C functions).
// An extern module emits drift checks against those headers, never a copy of them
// (design 7.2); the C++ side stays C++.

pub @_extern(cpp = "shape::Box", header = "shape.hxx") Box: Mutable<Any> {
    pub width: () Int32;
    pub height: () Int32;
    pub area: () Int32;
    pub @_mutates grow: (by: Int32) Void;
}

// The seam: a 3-line C++ factory, since a Kira class value is a kira::Rc<Box>.
pub @_extern(cpp = "shape::makeBox", header = "shape.hxx") makeBox: (w: Int32, h: Int32) Box;

// C functions (design 7.3): `c =` names the C symbol, and the C++ backend includes
// cshape.h inside extern "C" { }, which cshape.h's own guard tolerates and a header
// without one needs. A Str goes in as const char*.
pub @_extern(c = "cshape_hypot_sq", header = "cshape.h") hypotSq: (a: Int32, b: Int32) Int32;

pub @_extern(c = "cshape_len", header = "cshape.h") cLen: (s: Str) Size;

// A C constant is a macro (`#define CSHAPE_LIMIT 42`): the check and the read both
// spell it as written, since `::CSHAPE_LIMIT` would be `::42`.
pub @_extern(c = "CSHAPE_LIMIT", header = "cshape.h") LIMIT: Int32;

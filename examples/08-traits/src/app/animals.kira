Speaker: Any {
    pub speak: () Str
    pub name: () Str
}

Noisy: Speaker {
    pub loudness: () Int32
}

Dog: Noisy {
    pub label: Str

    pub speak: () Str {
        return "woof"
    }

    pub name: () Str {
        return label
    }

    pub loudness: () Int32 {
        return 8
    }
}

Cat: Speaker {
    pub label: Str

    pub speak: () Str {
        return "meow"
    }

    pub name: () Str {
        return label
    }
}

announce: (s: Speaker) Void {
    trace(s.name())
    trace(s.speak())
}

noiseLevel: (s: Noisy) Int32 {
    return s.loudness()
}

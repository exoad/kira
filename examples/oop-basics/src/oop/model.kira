module "oop:model"

pub class Point {
    require pub x: Int32
    require pub y: Int32
}

pub class Rectangle {
    require pub topLeft: Point
    require pub bottomRight: Point

    pub fx perimeter(): Int32 {
        width: Int32 = bottomRight.x - topLeft.x
        height: Int32 = topLeft.y - bottomRight.y
        return (width + height) * 2
    }
}

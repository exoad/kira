PROJECT: Project = Project { } with {
    name = "pico"
    srcDir = "src"
    target = "cpp"
    cpp = Cpp {
        layout = "beside",
        lineDirectives = false,
        headerOnly = @listOf("selftest:blink"),
        freestanding = @listOf("selftest:blink")
    }
    dependencies = @mapOf("kira_stdlib", "../../../../../kira")
}

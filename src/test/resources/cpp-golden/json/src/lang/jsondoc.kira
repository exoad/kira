module "lang:jsondoc"

use "kira:json"
use "kira:bytes"

// kira:json (D60-D63): py-golden/jsondoc runs this source and must print this case's C++ output,
// seeded values' every form and documents mutated from them last, as digests.

FNV_BASIS: UInt64 = 0x4BF29CE484222325
FNV_PRIME: UInt64 = 0x100000001B3

// UTF-8 past ASCII, and the controls but a newline, as <xx>: Python's piped stdout may be cp1252.
fx shown: (s: Str) Str {
    b: List<UInt8> = s.bytes()
    mut out: Str = ""
    mut i: Size = 0
    while i < b.size() {
        if b[i] == 0x0A || (b[i] >= 0x20 && b[i] < 0x7F) {
            out = out + "${b[i] as Char}"
        } else {
            out = out + "<" + b[i].toHex().padStart(2, '0') + ">"
        }
        i += 1
    }
    return out
}

pub class Digest {
    pub mut h: UInt64 = FNV_BASIS
    pub mut count: Int64 = 0
    pub mut total: Int64 = 0

    pub mut fx add: (s: Str) Void {
        b: List<UInt8> = s.bytes()
        mut i: Size = 0
        while i < b.size() {
            h = (h ^ (b[i] as UInt64)) * FNV_PRIME
            i += 1
        }
        h = (h ^ 0xFF) * FNV_PRIME
        count += 1
        total += b.size() as Int64
    }

    pub fx said: () Str {
        return "${count} texts, ${total} bytes, digest ${h.toHex()}"
    }
}

pub class Rng {
    pub mut s: UInt64 = 20261005

    pub mut fx next: () UInt64 {
        s = s ^ (s << 13)
        s = s ^ (s >> 7)
        s = s ^ (s << 17)
        return s
    }

    pub mut fx below: (n: UInt64) UInt64 {
        return next() % n
    }
}

pub class Holder {
    pub require doc: Json
    pub mut seen: List<Json> = []
}

fx pieces: () List<Str> {
    return ["a", "Kira", " ", "\"", "\\", "/", "\n", "\t", "\r", "é", "ÿ", "€", "中", "😀", "${0 as Char}", "ok", "", "\$"]
}

fx piece: (r: Rng) Str {
    k: UInt64 = r.below(24)
    p: List<Str> = pieces()
    if k < (p.size() as UInt64) {
        return p[k as Size]
    }
    if k < 22 {
        return "${(r.below(32) as UInt8) as Char}"
    }
    return "${127 as Char}"
}

fx words: (r: Rng) Str {
    n: UInt64 = r.below(6)
    mut s: Str = ""
    mut i: UInt64 = 0
    while i < n {
        s = s + piece(r)
        i += 1
    }
    return s
}

fx aFloat: (r: Rng) Float64 {
    k: UInt64 = r.below(10)
    if k < 4 {
        mut buf: List<UInt8> = [0, 0, 0, 0, 0, 0, 0, 0]
        writeU64Le(buf.view(), 0, r.next())
        return readF64Le(buf, 0)
    }
    if k < 7 {
        return (r.below(2000000) as Float64) / 1000.0 - 1000.0
    }
    if k < 8 {
        return (r.next() as Int64) as Float64
    }
    edges: List<Float64> = floatEdges(0.0)
    return edges[r.below(edges.size() as UInt64) as Size]
}

fx floatEdges: (zero: Float64) List<Float64> {
    third: Float64 = 1.0 / 3.0
    nan: Float64 = zero / zero
    inf: Float64 = 1.0 / zero
    ninf: Float64 = -1.0 / zero
    sum: Float64 = 0.1 + 0.2
    return [1.0, 0.0001, 0.00001, 1e16, 1e15, 1.5e300, -0.0, sum, third, 5e-324, nan, inf, ninf, 123456789012345680.0, 1e22, 100.0, 2.5e-7, 0.0, 9007199254740993.0]
}

fx intEdges: () List<Int64> {
    lowest: Int64 = -9223372036854775807 - 1
    return [0, -1, 9223372036854775807, lowest, 9007199254740993, 4294967296]
}

fx anInt: (r: Rng) Int64 {
    k: UInt64 = r.below(4)
    if k == 0 {
        edges: List<Int64> = intEdges()
        return edges[r.below(edges.size() as UInt64) as Size]
    }
    if k == 1 {
        return r.next() as Int64
    }
    return (r.below(2001) as Int64) - 1000
}

fx value: (r: Rng, depth: Int32) Json {
    k: UInt64 = r.below(10)
    if depth >= 4 || k < 5 {
        c: UInt64 = r.below(8)
        if c == 0 {
            return Json.null()
        }
        if c == 1 {
            return Json.of(r.below(2) == 0)
        }
        if c < 4 {
            return Json.of(anInt(r))
        }
        if c < 6 {
            return Json.of(aFloat(r))
        }
        return Json.of(words(r))
    }
    n: UInt64 = r.below(6)
    mut i: UInt64 = 0
    if k < 8 {
        a: Json = Json.arr()
        while i < n {
            a.add(value(r, depth + 1))
            i += 1
        }
        return a
    }
    o: Json = Json.obj()
    keys: List<Str> = [words(r), words(r)]
    while i < n {
        if r.below(3) == 0 {
            o.put(keys[r.below(2) as Size], value(r, depth + 1))
        } else {
            o.put(words(r), value(r, depth + 1))
        }
        i += 1
    }
    return o
}

fx junk: () List<UInt8> {
    return [0x2C, 0x5D, 0x7D, 0x5B, 0x7B, 0x22, 0x5C, 0x3A, 0x30, 0x2D, 0x65, 0x2E, 0x6E, 0x4E, 0x20, 0x0A, 0x01, 0x75, 0xC3, 0xA9, 0x80, 0xFF]
}

fx mutated: (r: Rng, doc: Str) Str {
    mut b: List<UInt8> = doc.bytes()
    mut times: UInt64 = r.below(3) + 1
    while times > 0 {
        at: Size = r.below((b.size() as UInt64) + 1) as Size
        k: UInt64 = r.below(3)
        mut out: List<UInt8> = List<UInt8> { }
        mut i: Size = 0
        while i < b.size() {
            if i == at && k == 2 {
                j: List<UInt8> = junk()
                out.add(j[r.below(j.size() as UInt64) as Size])
            }
            if !(i == at && k == 0) && !(i >= at && k == 1) {
                out.add(b[i])
            }
            i += 1
        }
        b = out
        times -= 1
    }
    return Str.of(b)
}

fx reason: (text: Str) Str {
    v: Json = Json.parse(text)
    if Json.error() == "" {
        return "ok " + v.dump()
    }
    return Json.error()
}

fx deep: (n: Int32, inner: Str) Str {
    mut s: Str = ""
    mut i: Int32 = 0
    while i < n {
        s = "[" + s + "]"
        i += 1
    }
    return s.substring(0, n as Size) + inner + s.substring(n as Size, s.size())
}

// What py-golden/jsondoc's driver hands over from Python, each a panic but floatOf.
pub fx putOn: (j: Json) Void {
    j.put("k", Json.null())
}

pub fx addTo: (j: Json) Void {
    j.add(Json.null())
}

pub fx holdsItself: () Str {
    a: Json = Json.arr()
    same: Json = a
    a.add(same)
    return a.dump()
}

pub fx floatOf: (x: Float64) Str {
    return Json.of(x).dump()
}

fx main: () Void {
    o: Json = Json.obj()
    o.put("null", Json.null())
    o.put("bool", Json.of(true))
    o.put("int", Json.of(-42))
    o.put("float", Json.of(2.5))
    o.put("str", Json.of("é \"q\" 😀"))
    a: Json = Json.arr()
    a.add(Json.of(1))
    a.add(Json.obj())
    a.add(Json.arr())
    o.put("arr", a)
    o.put("int", Json.of(7))
    trace(o.dump())
    trace(o.pretty(2, true))
    trace(shown(o.pretty(0, false)))
    trace(shown(o.pretty(4, false)))

    floats: Json = Json.arr()
    fs: List<Float64> = floatEdges(0.0)
    mut i: Size = 0
    while i < fs.size() {
        floats.add(Json.of(fs[i]))
        i += 1
    }
    trace(floats.dump())
    ints: Json = Json.arr()
    ns: List<Int64> = intEdges()
    i = 0
    while i < ns.size() {
        ints.add(Json.of(ns[i]))
        i += 1
    }
    ints.add(Json.of(-9223372036854775807 - 1))
    trace(ints.dump())
    controls: Str = "${1 as Char}${8 as Char}${12 as Char}${31 as Char}${127 as Char}"
    esc: Json = Json.of("q\" b\\ s/ n\n t\t r\r " + controls + " é€中😀")
    trace(esc.dump())
    trace(shown(esc.pretty(0, false)))
    nothing: Maybe<Float64> = null
    some: Maybe<Str> = "s"
    trace(Json.of(nothing).dump() + " " + Json.of(some).dump() + " " + Json.of(Json.error()).dump())

    p: Json = Json.parse("{\"a\": [1, 2.5, -0, 1E400, -1e-400, \"\\u00e9\\ud83d\\ude00\\ud800\", true, null], \"b\": -Infinity, \"a\": {\"dup\": NaN, \"n\": 3}}")
    trace(p.dump() + " [" + Json.error() + "]")
    trace("${p.isObj()} ${p.has("a")} ${p.has("z")} ${p.size()} ${p.keys().size()} ${p.get("a").isObj()} ${p.get("a").get("dup").isFloat()}")
    trace("${p.get("a").get("n").isInt()} ${p.get("a").get("n").asInt64().unwrapOr(-1)} ${p.get("a").get("n").asFloat64().unwrapOr(-1.0)} ${p.get("b").asInt64().isNone()}")
    trace("${p.get("z").isNull()} ${p.get("z").at(3).get("y").isNull()} ${p.get("a").at(0).isNull()} ${p.get("b").size()} ${p.get("b").keys().size()}")
    q: Json = Json.parse("[\"s\", true, 0, 0.0]")
    trace("${q.at(0).asStr().unwrapOr("-")} ${q.at(1).asBool().unwrapOr(false)} ${q.at(2).asBool().isNone()} ${q.at(2).isInt()} ${q.at(3).isInt()} ${q.at(3).isFloat()} ${q.at(4).isNull()} ${q.size()}")
    trace(q.at(0).asStr().unwrap() + q.at(9).dump() + Json.parse("null").dump() + Json.error())

    bads: List<Str> = ["[1,]", "{\"a\" 1}", "[1] x", "", "  ", "nul", "9223372036854775808", "-9223372036854775809", "[\"\\x\"]", "\"\\u12\"", "{\"a\":1,}", "[01]", "\"abc", "[1 2]", "{1: 2}", "[\"a\nb\"]", "\n\n  [1,\n  ]", "[\"é\", x]", "[1] // c", "'a'", "[-]", "[1.]", "[.5]", "[1e]", "{\"a\": }", "NaN1", "[Infinity, -Inf]"]
    mut k: Size = 0
    while k < bads.size() {
        trace(reason(bads[k]))
        k += 1
    }
    bom: List<UInt8> = [0xEF, 0xBB, 0xBF, 0x5B, 0x5D]
    trace(reason(Str.of(bom)))
    trace(reason(deep(512, "")).substring(0, 20))
    trace(reason(deep(513, "")))
    trace(reason(deep(513, "1")))
    trace(reason(deep(600, "x")))
    trace(reason(deep(100, "x")))

    shared: Json = Json.obj()
    other: Json = shared
    other.put("x", Json.of(1))
    xs: List<Json> = [shared]
    mut ys: List<Json> = xs
    ys.add(Json.null())
    ys[0].put("y", Json.of(2))
    h: Holder = Holder { doc = shared }
    h.seen.add(shared)
    h.doc.put("z", Json.of(3))
    trace(shared.dump() + " " + "${xs.size()} ${ys.size()} ${h.seen[0].size()}")

    r: Rng = Rng { }
    forms: Digest = Digest { }
    docs: Digest = Digest { }
    mut roundTrips: Int32 = 0
    mut refused: Int32 = 0
    mut n: Int32 = 0
    while n < 2500 {
        v: Json = value(r, 0)
        d: Str = v.dump()
        forms.add(d)
        forms.add(v.pretty(0, true))
        forms.add(v.pretty(1, false))
        forms.add(v.pretty(2, true))
        forms.add(v.pretty(4, false))
        if Json.parse(d).dump() == d && Json.error() == "" {
            roundTrips += 1
        }
        m: Str = mutated(r, d)
        back: Json = Json.parse(m)
        if Json.error() == "" {
            docs.add("ok " + back.pretty(1, false))
        } else {
            docs.add(Json.error())
            refused += 1
        }
        n += 1
    }
    trace("values: " + forms.said() + ", ${roundTrips} parse back to their dump")
    trace("mutated documents: " + docs.said() + ", ${refused} refused")
}

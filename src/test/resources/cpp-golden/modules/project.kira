PROJECT: Project = Project { } with {
    name = "golden.modules"
    srcDir = "src"
    target = "cpp"
    cpp = Cpp {
        layout = "beside",
        lineDirectives = false,
        namespaces = @mapOf("golden.modules.lib.units", "golden::units"),
        headerOnly = @listOf("golden.modules.lib.units")
    }
    types = "strict"
    dependencies = @mapOf("kira_stdlib", "../../../../../kira")
}

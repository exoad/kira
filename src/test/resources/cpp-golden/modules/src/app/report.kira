golden.modules.lib.units as units

// A module in another directory: it includes lib/units by relative path, and
// every name it takes from there is fully qualified.

pub Line: Struct {
    pub label: Str = ""
    pub pct: Int32 = 0
}

bar: (pct: Int32) Str {
    mut out: Str = ""
    mut i: Int32 = 0
    while i < pct / 10 {
        out = out + "#"
        i += 1
    }
    return out
}

pub line: (label: Str, part: Int32, whole: Int32 = SCALE) Line {
    return Line { label = label, pct = percent(part, whole) }
}

pub render: (l: Line) Str {
    return "${l.label}: ${l.pct}% ${bar(l.pct)}"
}

// The class model: reference types held by Rc, traits with parameters and
// default bodies, inheritance, a generic class, and the spec's Ref and Weak.

pub Pet: Any {
    pub name: Str
}

// A getter that returns a field: a copy of the reference, never a second owner
// of one count (the C backend double-frees this).
pub Owner: Any {
    pet: Pet

    pub getPet: () Pet {
        return pet
    }
}

pub Scaler: Any {
    pub scale: (v: Int32) Int32;
    pub factor: () Int32;
    pub describe: () Str {
        return "scales by ${factor()}"
    }
}

pub Doubler: Scaler {
    k: Int32

    override pub scale: (v: Int32) Int32 {
        return v * k
    }

    override pub factor: () Int32 {
        return k
    }
}

pub apply: (s: Scaler, v: Int32) Int32 {
    return s.scale(v)
}

pub Animal: Any {
    pub name: Str

    pub sound: () Str {
        return "..."
    }

    pub describe: () Str {
        return "${name} says ${sound()}"
    }
}

pub Dog: Animal {
    mut tricks: Int32 = 0

    override pub sound: () Str {
        return "woof"
    }

    pub mut learn: () Int32 {
        tricks += 1
        return tricks
    }
}

pub Box<T>: Any {
    pub value: T

    pub get: () T {
        return value
    }
}

pub boxed: (v: Int32) Box<Int32> {
    return Box<Int32> { value = v }
}

pub makeCounter: () Ref<Int32> {
    return Ref<Int32> { value = 0 }
}

pub bump: (c: Ref<Int32>) Int32 {
    c.value = c.value + 1
    return c.value
}

pub petName: (w: Weak<Pet>) Str {
    p: Maybe<Pet> = w.upgrade()
    if p.isNone() {
        return "gone"
    }
    return p.unwrap().name
}

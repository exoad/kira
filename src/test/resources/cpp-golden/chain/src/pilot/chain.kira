// The behaviour chain: the one class hierarchy bibo has, and Maybe<Class>.

pub ID_WASD: Str = "net.exoad.tt02bibo.wasd"
pub ID_STOP: Str = "net.exoad.tt02bibo.stop"

pub ACT_NOTHING: Int32 = 0
pub ACT_CLAMP: Int32 = 1
pub ACT_PROPOSE: Int32 = 2

pub Reply: Struct {
    pub act: Int32 = ACT_NOTHING
    pub throttle: Float32 = 0.0
    pub steer: Float32 = 0.0
}

pub Pass: Struct {
    pub dtMs: Int32 = 0
    pub nowMs: Int64 = 0
    pub haveHolder: Bool = false
}

// A trait lowers to an abstract C++ class; a default body is a virtual with a
// body, so a C++ test double overrides exactly what it needs.
pub Behaviour: Any {
    pub id: () Str;
    pub name: () Str;
    pub mayDrive: () Bool {
        return false
    }
    pub mut onLoad: () Void {
    }
    pub mut onUnload: () Void {
    }
    pub mut step: (p: Pass) Reply;
}

Stop: Behaviour {
    override pub id: () Str {
        return ID_STOP
    }
    override pub name: () Str {
        return "stop"
    }
    override pub mut step: (p: Pass) Reply {
        return Reply { act = ACT_CLAMP, throttle = 0.0 }
    }
}

pub make: (wanted: Str) Maybe<Behaviour> {
    if wanted == ID_STOP {
        return Stop {}
    }
    return null
}

pub Chain: Any {
    mut loaded: List<Behaviour> = List<Behaviour> {}

    pub mut load: (b: Maybe<Behaviour>, mut why: Str) Bool {
        if b.isNone() {
            why = "no behaviour"
            return false
        }
        it: Behaviour = b.unwrap()
        wanted: Str = it.id()
        if wanted.isEmpty() {
            why = "a behaviour with no id"
            return false
        }
        if has(wanted) {
            why = "already loaded: ${wanted}"
            return false
        }
        it.onLoad()
        loaded.add(it)
        return true
    }

    pub size: () Size {
        return loaded.size()
    }

    pub has: (wanted: Str) Bool {
        for b: Behaviour in loaded {
            if b.id() == wanted {
                return true
            }
        }
        return false
    }

    pub at: (i: Size) Maybe<Behaviour> {
        if i >= loaded.size() {
            return null
        }
        return loaded[i]
    }
}

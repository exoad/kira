    srcDir = "src"
    target = "cpp"
    cpp = Cpp {
        layout = "beside",
        lineDirectives = false,
        headerOnly = @listOf("golden.unilidar.pilot.unilidar")
    }
    types = "strict"
    dependencies = @mapOf("kira_stdlib", "../../../../../kira")
}

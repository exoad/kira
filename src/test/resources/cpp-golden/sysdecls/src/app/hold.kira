kira.sync as sync

// Declarations that hold kira:sync's classes. A `@_magic` class of a system
// module is the runtime's class held as kira::Rc, so `BlockingQueue<Str> {}`
// is std::make_shared of kira::sync::BlockingQueue, never a null pointer:
// in a field, in module state, in a constant, and in the .cxx's private
// state alike. The header includes the runtime's kira/sync.hxx, and no
// kira/std/sync.kira.hxx is emitted: kira:sync has nothing of its own to
// write.

pub Holder: Mutable<Any> {
    pub q: BlockingQueue<Str> = BlockingQueue<Str> {}
    pub worker: Maybe<Thread> = null
    pub count: Int32 = 0
}

pub inbox: Mutable<BlockingQueue<Str>> = BlockingQueue<Str> {}
pub OUTBOX: BlockingQueue<Int32> = BlockingQueue<Int32> {}
backlog: Mutable<BlockingQueue<Int32>> = BlockingQueue<Int32> {}

pub wait: (t: Thread, m: Mutex<Int32>) Void;
pub go: () Void;

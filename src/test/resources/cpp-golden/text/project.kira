PROJECT: Project = Project { } with {
    name = "golden.text"
    srcDir = "src"
    target = "cpp"
    cpp = Cpp {
        layout = "beside",
        lineDirectives = false,
        namespaces = @mapOf("golden.text.lib.text", "bibo::text"),
        freestanding = @listOf("golden.text.lib.text")
    }
    types = "strict"
    dependencies = @mapOf("kira_stdlib", "../../../../../kira")
}

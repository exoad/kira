kira.bytes as bytes

// text - string handling on a caller's buffer: no allocation, no ownership, no
// state. FREESTANDING: Str allocates, so it is refused in this module, and text
// is View<Char> or a StrBuf. A string literal in a View<Char> context is a
// static view.

isBlank: (c: Char) Bool {
    c == ' ' || c == '\t'
}

// Matches w as a WHOLE word at the start of s, returning the offset of what
// follows, the spaces skipped: the caller slices, s.from(at). A bare command
// returns s.size(), NOT none: "matched, nothing after it" and "did not match"
// stay apart. A view is never held, so the offset is what comes back.
pub wordEnd: (s: View<Char>, w: View<Char>) Maybe<Size> {
    n: Size = w.size()
    if s.size() < n || s.slice(0, n) != w {
        null
    } else if s.size() > n && s[n] != ' ' {
        null
    } else {
        at: Mutable<Size> = n
        while at < s.size() && s[at] == ' ' {
            at += 1
        }
        at
    }
}

// The length without trailing CR, LF, space and tab. A terminal picks its own
// line ending, and "PING\r" is not "PING".
pub trimEnd: (s: View<Char>) Size {
    n: Mutable<Size> = s.size()
    while n > 0 && (s[n - 1] == '\r' || s[n - 1] == '\n' || isBlank(s[n - 1])) {
        n -= 1
    }
    n
}

// STRICT: surrounding space is allowed and anything else is a refusal (none), where
// atoi("12abc") is 12.
pub toInt: (s: View<Char>) Maybe<Int32> {
    from: Mutable<Size> = 0
    while from < s.size() && isBlank(s[from]) {
        from += 1
    }
    end: Size = trimEnd(s)
    if from >= end {
        null
    } else {
        v: Maybe<Int64> = parseInt64(s.slice(from, end - from))
        v.isNone() ? null : v.unwrap() as Int32
    }
}

// The drive reply into a caller's buffer. Interpolation into a StrBuf appends
// in place: no Str, so no heap.
pub driveReply: (servo: Int32, esc: Int32, out: StrBuf<32>) Void {
    out.set("OK drive servo=${servo} esc=${esc}")
}

// A reading into a caller's buffer: addFixed rounds as FloatNum.fixed (D50).
pub speedReply: (mps: Float64, places: Int32, out: StrBuf<32>) Void {
    out.set("SPEED ")
    out.addFixed(mps, places)
}

pub isCommand: (s: View<Char>, verb: View<Char>) Bool {
    !wordEnd(s, verb).isNull()
}

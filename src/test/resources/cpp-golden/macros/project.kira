PROJECT: Project = Project { } with {
    name = "golden.macros"
    srcDir = "src"
    target = "cpp"
    cpp = Cpp {
        layout = "beside",
        lineDirectives = false,
        headerOnly = @listOf("golden.macros.win.names")
    }
    types = "strict"
    dependencies = @mapOf("kira_stdlib", "../../../../../kira")
}

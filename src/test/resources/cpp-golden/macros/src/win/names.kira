module "win:names"

// Names that <windows.h> defines as function-like macros: min and max. The
// generated header includes kira/macro_push.hxx after its own includes, so it
// compiles after <windows.h> (the driver includes that first, without
// NOMINMAX), and kira/macro_pop.hxx gives the caller its macros back: the
// driver checks that MAX_PATH still expands afterwards. Header-only; the
// functions are bodiless, and the driver defines them under the same guard.

pub INTERVAL: Int32 = 5

pub struct Range {
    pub lo: Int32 = 0
    pub hi: Int32 = INTERVAL

    pub fx min: () Int32;
    pub fx max: () Int32;
}

pub fx min: (a: Int32, b: Int32) Int32;
pub fx max: (a: Int32, b: Int32) Int32;

// Conformance on classes and traits, `shape == Circle`: a run-time test (a dynamic_cast), and a
// passing one narrows the name for the rest of the `&&`, the body, and after an `if` that leaves.

pub Shape: Any {
    pub area: () Int32;
}

pub Named: Any {
    pub label: () Str;
}

pub Circle: Shape, Named {
    pub radius: Int32

    override pub area: () Int32 {
        3 * radius * radius
    }

    override pub label: () Str {
        "circle ${radius}"
    }
}

pub Square: Shape {
    pub side: Int32

    override pub area: () Int32 {
        side * side
    }
}

pub Animal: Any {
    pub name: Str

    pub sound: () Str {
        "..."
    }
}

pub Dog: Animal {
    pub tricks: Int32 = 2

    override pub sound: () Str {
        "woof"
    }
}

pub made: Mutable<Int32> = 0

pub make: (r: Int32) Shape {
    made += 1
    r > 0 ? Circle { radius = r } : Square { side = -r }
}

// The rest of the `&&` and the body see a Circle.
pub big: (shape: Shape) Bool {
    shape == Circle && shape.radius > 10 ? shape.radius < 100 : false
}

// After an `if` that always leaves, the rest sees what its failing proved.
pub describe: (s: Shape) Str {
    s != Circle ? "not a circle" : "circle of ${s.radius}"
}

// A trait.
pub tagged: (s: Shape) Str {
    s == Named ? s.label() : "untagged"
}

// `!=` narrows the else branch.
pub sideOr: (s: Shape) Int32 {
    s != Square ? -1 : s.side
}

// An else-if chain: each branch sees its own test passing.
pub kind: (s: Shape) Str {
    s == Circle ? "r=${s.radius}" : s == Square ? "side=${s.side}" : "other"
}

// The rest of an `||` sees the left side false.
pub smallOrNot: (s: Shape) Bool {
    s != Circle || s.radius < 5
}

// An if-expression's arms.
pub radiusOr: (s: Shape) Int32 {
    r: Int32 = s == Circle ? s.radius + 0 : 0
    r
}

// A Maybe of a class: the test is false when it holds nothing.
pub tricks: (a: Maybe<Animal>) Int32 {
    a == Dog ? a.tricks : a == Animal ? 0 : -1
}

// In a loop, after a `continue`.
pub radii: (xs: List<Shape>) Int32 {
    total: Mutable<Int32> = 0
    for s: Shape in xs {
        if s != Circle {
            continue
        }
        total += s.radius
    }
    total
}

// The value of a test that is no name is evaluated once.
pub madeCircle: (r: Int32) Bool {
    make(r) == Circle
}

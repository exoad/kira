// The Pico's newline-terminated ASCII line protocol.
//
//     OK <verb> [key=value ...]
//     ERR <reason>
//     INFO <topic> [key=value ...]
//
// Fields are read BY NAME. Pure: no sockets, serial or clock.

pub KIND_OK: Int32 = 0
pub KIND_ERR: Int32 = 1
pub KIND_INFO: Int32 = 2
// None of the above, and NOT an error: boot banners, a person typing.
pub KIND_OTHER: Int32 = 3
pub KIND_EMPTY: Int32 = 4

// One line from the board, split but not interpreted.
pub Reply: Struct {
    pub kind: Int32 = KIND_EMPTY
    pub topic: Str = ""
    pub rest: Str = ""
    pub line: Str = ""
}

isSpace: (c: Char) Bool {
    c == ' ' || c == '\t'
}

// [begin, end) of the first word at or after `from`.
wordAt: (s: Str, from: Size, mut begin: Size, mut end: Size) Void {
    mut at: Size = from
    while at < s.length() && isSpace(s[at]) {
        at += 1
    }
    begin = at
    while at < s.length() && !isSpace(s[at]) {
        at += 1
    }
    end = at
}

tailFrom: (s: Str, from: Size) Str {
    mut at: Size = from
    while at < s.length() && isSpace(s[at]) {
        at += 1
    }
    at < s.length() ? s.substring(at, s.length()) : ""
}

trimEnd: (s: Str) Str {
    mut n: Size = s.length()
    while n > 0 && (s[n - 1] == '\r' || s[n - 1] == '\n' || isSpace(s[n - 1])) {
        n -= 1
    }
    s.substring(0, n)
}

// Classifies one line. Strips CR, so a caller may hand it either ending.
pub read: (line: Str) Reply {
    mut out: Reply = Reply { line = trimEnd(line) }
    mut b: Size = 0
    mut e: Size = 0
    wordAt(out.line, 0, mut b, mut e)
    if b >= e {
        out.kind = KIND_EMPTY
        out
    } else {
        head: Str = out.line.substring(b, e)
        if head == "ERR" {
            out.kind = KIND_ERR
            out.rest = tailFrom(out.line, e)
            out
        } else if head == "OK" || head == "INFO" {
            out.kind = head == "OK" ? KIND_OK : KIND_INFO
            mut tb: Size = 0
            mut te: Size = 0
            wordAt(out.line, e, mut tb, mut te)
            if tb < te {
                out.topic = out.line.substring(tb, te)
                out.rest = tailFrom(out.line, te)
            }
            out
        } else {
            out.kind = KIND_OTHER
            out.rest = out.line
            out
        }
    }
}

// The value of `key` in `text`, running to the next space. MATCHES ON TOKEN
// BOUNDARIES: "esc=" is never found inside "desc=".
pub field: (text: Str, key: Str, mut out: Str) Bool {
    if key.isEmpty() {
        false
    } else {
        klen: Size = key.length()
        mut i: Size = 0
        mut result: Bool = false
        while i + klen <= text.length() {
            boundary: Bool = i == 0 || isSpace(text[i - 1])
            if boundary && text.substring(i, i + klen) == key {
                mut to: Size = i + klen
                while to < text.length() && !isSpace(text[to]) {
                    to += 1
                }
                out = text.substring(i + klen, to)
                result = true
                break
            }
            i += 1
        }
        result
    }
}

// False when the key is absent OR the value is not wholly a number.
pub fieldInt: (text: Str, key: Str, mut out: Int32) Bool {
    mut raw: Str = ""
    if !field(text, key, mut raw) {
        false
    } else {
        v: Maybe<Int64> = raw.toInt64()        // strict decimal, locale-free: "1541abc" is refused
        if v.isNone() {
            false
        } else {
            out = v.unwrap() as Int32
            true
        }
    }
}

pub fieldFloat: (text: Str, key: Str, mut out: Float32) Bool {
    mut raw: Str = ""
    if !field(text, key, mut raw) {
        false
    } else {
        v: Maybe<Float64> = raw.toFloat64()
        if v.isNone() {
            false
        } else {
            out = v.unwrap() as Float32
            true
        }
    }
}

// Three decimals from integers, NOT a %f: that honours the C locale. The
// literals take v's type, so this is Float32 arithmetic, as the C++ was.
fixed3: (value: Float32) Str {
    neg: Bool = value < 0.0
    v: Float32 = neg ? -value : value
    scaled: Int32 = (v * 1000.0 + 0.5) as Int32
    whole: Int32 = scaled / 1000
    frac: Int32 = scaled % 1000
    sign: Str = neg ? "-" : ""
    "${sign}${whole}.${(frac as Str).padStart(3, '0')}"
}

// A fraction of this car's steering travel, clamped to -1..1.
pub steer: (fraction: Float32) Str {
    mut f: Float32 = fraction
    if f < -1.0 {
        f = -1.0
    }
    if f > 1.0 {
        f = 1.0
    }
    "STEER ${fixed3(f)}"
}

pub escUs: (us: Int32) Str {
    "ESC ${us}"
}

pub stop: () Str {
    "STOP"
}

// Assembled without a format string, so a '%' in args is a plain character.
pub command: (verb: Str, args: Str = "") Str {
    verb.isEmpty() ? "" : args.isEmpty() ? verb : "${verb} ${args}"
}

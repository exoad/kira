// The Pico's newline-terminated ASCII line protocol.
//
//     OK <verb> [key=value ...]
//     ERR <reason>
//     INFO <topic> [key=value ...]
//
// Fields are read BY NAME. Pure: no sockets, serial or clock.

pub KIND_OK: Int32 = 0
pub KIND_ERR: Int32 = 1
pub KIND_INFO: Int32 = 2
// None of the above, and NOT an error: boot banners, a person typing.
pub KIND_OTHER: Int32 = 3
pub KIND_EMPTY: Int32 = 4

// One line from the board, split but not interpreted.
pub Reply: Struct {
    pub kind: Int32 = KIND_EMPTY
    pub topic: Str = ""
    pub rest: Str = ""
    pub line: Str = ""
}

isSpace: (c: Char) Bool {
    c == ' ' || c == '\t'
}

// [begin, end) of the first word at or after `from`.
wordAt: (s: Str, from: Size) Tuple2<Size, Size> {
    at: Mutable<Size> = from
    while at < s.length() && isSpace(s[at]) {
        at += 1
    }
    begin: Size = at
    while at < s.length() && !isSpace(s[at]) {
        at += 1
    }
    Tuple2<Size, Size> { begin, at }
}

tailFrom: (s: Str, from: Size) Str {
    at: Mutable<Size> = from
    while at < s.length() && isSpace(s[at]) {
        at += 1
    }
    at < s.length() ? s.substring(at, s.length()) : ""
}

trimEnd: (s: Str) Str {
    n: Mutable<Size> = s.length()
    while n > 0 && (s[n - 1] == '\r' || s[n - 1] == '\n' || isSpace(s[n - 1])) {
        n -= 1
    }
    s.substring(0, n)
}

// Classifies one line. Strips CR, so a caller may hand it either ending.
pub read: (line: Str) Reply {
    kept: Str = trimEnd(line)
    word: Tuple2<Size, Size> = wordAt(kept, 0)
    b: Size = word.first
    e: Size = word.second
    if b >= e {
        Reply { kind = KIND_EMPTY, line = kept }
    } else {
        head: Str = kept.substring(b, e)
        if head == "ERR" {
            Reply { kind = KIND_ERR, rest = tailFrom(kept, e), line = kept }
        } else if head == "OK" || head == "INFO" {
            topic: Tuple2<Size, Size> = wordAt(kept, e)
            tb: Size = topic.first
            te: Size = topic.second
            named: Bool = tb < te
            Reply { kind = head == "OK" ? KIND_OK : KIND_INFO, topic = named ? kept.substring(tb, te) : "", rest = named ? tailFrom(kept, te) : "", line = kept }
        } else {
            Reply { kind = KIND_OTHER, rest = kept, line = kept }
        }
    }
}

// The value of `key` in `text`, running to the next space, or none. MATCHES ON TOKEN
// BOUNDARIES: "esc=" is never found inside "desc=".
pub field: (text: Str, key: Str) Maybe<Str> {
    if key.isEmpty() {
        null
    } else {
        klen: Size = key.length()
        i: Mutable<Size> = 0
        result: Mutable<Maybe<Str>> = null
        while i + klen <= text.length() {
            boundary: Bool = i == 0 || isSpace(text[i - 1])
            if boundary && text.substring(i, i + klen) == key {
                to: Mutable<Size> = i + klen
                while to < text.length() && !isSpace(text[to]) {
                    to += 1
                }
                result = text.substring(i + klen, to)
                break
            }
            i += 1
        }
        result
    }
}

// None when the key is absent OR the value is not wholly a number.
pub fieldInt: (text: Str, key: Str) Maybe<Int32> {
    raw: Maybe<Str> = field(text, key)
    if raw.isNone() {
        null
    } else {
        v: Maybe<Int64> = raw.unwrap().toInt64()        // strict decimal, locale-free: "1541abc" is refused
        v.isNone() ? null : v.unwrap() as Int32
    }
}

pub fieldFloat: (text: Str, key: Str) Maybe<Float32> {
    raw: Maybe<Str> = field(text, key)
    if raw.isNone() {
        null
    } else {
        v: Maybe<Float64> = raw.unwrap().toFloat64()
        v.isNone() ? null : v.unwrap() as Float32
    }
}

// Three decimals from integers, NOT a %f: that honours the C locale. The
// literals take v's type, so this is Float32 arithmetic, as the C++ was.
fixed3: (value: Float32) Str {
    neg: Bool = value < 0.0
    v: Float32 = neg ? -value : value
    scaled: Int32 = (v * 1000.0 + 0.5) as Int32
    whole: Int32 = scaled / 1000
    frac: Int32 = scaled % 1000
    sign: Str = neg ? "-" : ""
    "${sign}${whole}.${(frac as Str).padStart(3, '0')}"
}

// A fraction of this car's steering travel, clamped to -1..1.
pub steer: (fraction: Float32) Str {
    f: Mutable<Float32> = fraction
    if f < -1.0 {
        f = -1.0
    }
    if f > 1.0 {
        f = 1.0
    }
    "STEER ${fixed3(f)}"
}

pub escUs: (us: Int32) Str {
    "ESC ${us}"
}

pub stop: () Str {
    "STOP"
}

// Assembled without a format string, so a '%' in args is a plain character.
pub command: (verb: Str, args: Str = "") Str {
    verb.isEmpty() ? "" : args.isEmpty() ? verb : "${verb} ${args}"
}

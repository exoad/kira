// Declarations only: every row of design 5.2 that needs no function body.
// The functions are bodiless on purpose (the driver defines them), so this
// case proves the declaration emitter by itself: structs, constants,
// aliases, defaults, placement and includes. Header-only, in the namespace
// golden::shapes (build.cpp.namespaces), used from another directory by
// app:panel.

pub KIND_DOT: Int32 = 0
pub KIND_LINE: Int32 = 1
pub KIND_BOX: Int32 = 2

// A narrow type, and hex values that keep their spelling.
pub MASK_NONE: Int16 = 0x00
pub MASK_LOW: Int16 = 0x0F
pub MASK_HIGH: Int16 = 0xF0

// Str constants.
pub UNIT_MM: Str = "mm"
pub UNIT_IN: Str = "in"

pub SCALE: Int32 = 100
pub MAX_POINTS: Size = 8
pub EPSILON: Float32 = 0.001
pub HALF: Float64 = 0.5
pub NAME: Str = "shapes"
// Every trigraph: the header must not spell "??=" and the rest, which gcc and
// clang refuse under -Wall -Werror, so the second '?' of each pair is escaped.
pub TRIGRAPHS: Str = "??= ??/ ??' ??( ??) ??! ??< ??> ??- ???= ?"
pub TAG: Char = 'S'
pub SIGNED: Bool = true
pub BIG: Int64 = 5000000000
pub MASK_ALL: UInt32 = 0xFFFFFFFF
pub ORDER: Arr<UInt8, 4> = @arrOf(0x03, 0x01, 0x02, 0x00)
pub DELTAS: Arr<Int8, 3> = @arrOf(-1, 0, 1)

pub Arr<Int32, MAX_POINTS> as Outline

// Declared before Point and holding one by value: the header must define
// Point first, whatever the source order says.
pub Box: Struct {
    pub origin: Point
    pub size: Int32 = SCALE
    pub kind: Int32 = KIND_BOX
    pub unit: Str = UNIT_MM
    pub label: Str = ""
    pub outline: Outline

    pub area: () Int32;
}

pub Point: Struct {
    pub x: Int32 = 0
    pub y: Int32 = 0

    pub manhattan: () Int32;
    pub shifted: (dx: Int32, dy: Int32 = 0) Point;
}

pub created: Mutable<Int32> = 0

pub scaled: (v: Int32, by: Int32 = SCALE, unit: Str = UNIT_MM) Int32;
pub describe: (b: Box, label: Str = "box??") Str;
pub first: (points: Outline) Int32;
pub total: (points: View<Int32>) Int32;

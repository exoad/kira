module "app:evalorder"

// D33: Kira evaluates a call's receiver and arguments, and an operator's operands, left
// to right, and locates an assignment's target before its value runs. C++ leaves the
// arguments and operands unsequenced (gcc and clang disagree on x86-64, measured in the
// design's probes-B/evalorder) and runs the right side of `=` first, so the emitter spills
// them into typed temporaries, in order, whenever one has an effect and another is not
// pure (R19): a call is copied, a read of shared state is copied before the effect runs
// (a Str, a struct or a container too, which C++ would otherwise hand the callee as the
// effect left it), and a place (a mut argument, an assignment's target, the receiver a mut
// fx writes, a container a call lends a view from) is never copied and never held by
// reference: the values along its path (each index) are ordered like any other, and the
// path is applied where the call or assignment uses it. Every line below would print
// something else on some compiler, or read freed memory, if it did not.

mut ticks: Int32 = 0
mut idx: Size = 0
mut row: Size = 1
mut garr: Arr<Int32, 4> = [10, 20, 30, 40]
mut gl: List<Int32> = List<Int32> { }
mut gm: Map<Int32, Int32> = Map<Int32, Int32> { }

fx next: () Int32 {
    ticks += 1
    return ticks
}

fx nextSize: () Size {
    idx += 1
    return idx
}

fx sub: (a: Int32, b: Int32) Int32 {
    return a - b
}

fx store: (mut into: Int32, tens: Int32, ones: Int32) Void {
    into = tens * 10 + ones
}

pub struct Box {
    pub v: Int32 = 0

    pub fx pair: (a: Int32, b: Int32) Int32 {
        return v * 100 + a * 10 + b
    }

    pub mut fx grow: (a: Int32, b: Int32) Void {
        v = v * 100 + a * 10 + b
    }
}

fx makeBox: () Box {
    ticks += 1
    return Box { v = ticks }
}

fx putKey: () Int32 {
    gm.put(1, 99)
    return 1
}

fx setFirst: () Size {
    gl.set(0, 50)
    return 0
}

mut gs: Str = "a"
mut gb: Box = Box { v = 1 }

fx changeS: () Int32 {
    gs = "b"
    return 1
}

fx bumpB: () Int32 {
    gb.v = 9
    return 0
}

fx resetL: () Int32 {
    gl = List<Int32> { values = [8] }
    return 0
}

fx pairS: (s: Str, k: Int32) Str {
    return "${s}${k}"
}

fx sumB: (b: Box, k: Int32) Int32 {
    return b.v + k
}

fx firstL: (xs: List<Int32>, k: Int32) Int32 {
    return xs.get(0) + k
}

fx tail: (xs: List<Int32>, at: Size) View<Int32> {
    return xs.from(at)
}

fx total: (v: View<Int32>) Int32 {
    mut s: Int32 = 0
    for x: Int32 in v {
        s += x
    }
    return s
}

fx sumTail: (xs: List<Int32>) Int32 {
    return total(tail(xs, nextSize()))
}

fx main: () Void {
    // The design's probe: 1 - 2.
    trace(sub(next(), next()))
    // An operator's operands: 3 - 4.
    trace(next() - next())
    // Nested: (5 - 6) - 7.
    trace(sub(sub(next(), next()), next()))
    // A mut argument is a place and stays one; its siblings are spilled: 8, 9.
    mut slot: Int32 = 0
    store(mut slot, next(), next())
    trace(slot)
    // Interpolation holes are the arguments of kira::cat: 10, then 11.
    trace("${next()}/${next()}")
    // One impure operand needs nothing: 12 - 100.
    trace(sub(next(), 100))
    // A read of shared state beside an effect is copied first: 12 - 13.
    trace(sub(ticks, next()))
    // The same in an interpolation hole: 13, then 14.
    trace("${ticks}/${next()}")
    // A compound assignment reads its target before an impure value runs: 14 + 15.
    ticks += next()
    trace(ticks)
    // An impure receiver runs before the spilled arguments: 30, then 31 and 32.
    trace(makeBox().pair(next(), next()))
    // A mut argument's index runs before its siblings: slot 1 takes 33 and 34.
    mut slots: Arr<Int32, 4> = [0, 0, 0, 90]
    store(mut slots[nextSize()], next(), next())
    trace(slots[1])
    // A place assignment locates its target before the value runs: slot 2 takes 35.
    slots[nextSize()] = next()
    trace(slots[2])
    // A checked compound assignment locates its target once: slot 3 halves, idx is 3.
    two: Int32 = 2
    slots[nextSize()] /= two
    trace(slots[3])
    trace(idx)
    // The receiver of a mut fx is the element itself, never a copy: box 0 takes 36 and 37.
    mut boxes: Arr<Box, 1> = [Box { }]
    idx = 0
    boxes[nextSize() - 1].grow(next(), next())
    trace(boxes[0].v)
    // A nested element place orders both indexes and writes the element itself, never a
    // copy of the row: grid[1][2] takes 5, then 6.
    mut grid: Arr<Arr<Int32, 3>, 3> = [[0, 0, 0], [0, 0, 0], [0, 0, 0]]
    idx = 0
    grid[nextSize()][nextSize()] = 5
    trace(grid[1][2] * 10 + grid[2][1])
    idx = 0
    grid[nextSize()][nextSize()] += 1
    trace(grid[1][2] * 10 + grid[2][1])
    // A mut argument two elements deep, its row a read of shared state: grid[1][1] takes 38 and 39.
    idx = 0
    store(mut grid[row][nextSize()], next(), next())
    trace(grid[1][1])
    // The receiver of a mut fx two elements deep is that element: cell [1][2] takes 40 and 41.
    mut cells: Arr<Arr<Box, 3>, 3> = [[Box { }, Box { }, Box { }], [Box { }, Box { }, Box { }], [Box { }, Box { }, Box { }]]
    idx = 0
    cells[nextSize()][nextSize()].grow(next(), next())
    trace(cells[1][2].v)
    // A view lent from a List parameter beside an effect points at the caller's list, not
    // at a copy that dies with the lambda: 2 + 3 + 4.
    idx = 0
    trace(sumTail(List<Int32> { values = [1, 2, 3, 4] }))
    // A view lent from a global: 20 + 30 + 40.
    idx = 0
    trace(total(garr.from(nextSize())))
    // A Map or a List receiver beside an effect is read before it, whichever binding spells
    // the call: the copy holds 42, not the 99 putKey() writes, and 1, not the 50 setFirst() writes.
    gm.put(1, 42)
    trace(gm.get(putKey()).unwrapOr(-1))
    gl.add(1)
    gl.add(2)
    trace(gl.get(setFirst()))
    // A Str, a struct and a List global beside a call that reassigns or writes it are read
    // before the call: a1, a:1, 1, then 1 (C++'s const& would hand the callee b, b, 9 and 8).
    trace(pairS(gs, changeS()))
    gs = "a"
    trace("${gs}:${changeS()}")
    trace(sumB(gb, bumpB()))
    gl.set(0, 1)
    trace(firstL(gl, resetL()))
    // A binding that names its receiver twice (StrBuf.set) and a StrBuf interpolation, one
    // call per piece, locate the receiver once: idx ends at 1 both times, and bufs[1] holds
    // a2b, 3 characters.
    mut bufs: Arr<StrBuf<8>, 3> = [StrBuf<8> { }, StrBuf<8> { }, StrBuf<8> { }]
    idx = 0
    bufs[nextSize()].set("x")
    trace(idx)
    idx = 0
    bufs[nextSize()].set("a${two}b")
    trace(idx)
    trace(bufs[1].size())
    // A view the callee stores through a mut fx receiver (attach) or a mut argument (fill)
    // points at the caller's list, never at a copy that dies with the lambda, though the
    // result is Void: 11, 22 and 1, then 33 and 2.
    gl = List<Int32> { values = [11, 22, 33] }
    idx = 0
    mut w: Win = Win { v = other, k = 0 }
    w.attach(gl, nextSize())
    trace(w.v.get(0) * 100 + w.v.get(1))
    trace(w.k)
    mut w2: Win = Win { v = other, k = 0 }
    fill(mut w2, gl, nextSize())
    trace(w2.v.get(2) * 10 + (w2.k as Int32))
    // A Str beside an effect is read before it whatever the callee returns: adder makes an
    // Fx of its own captures and no view, so it takes the "aaa" changeS() replaces: 3 + 1.
    gs = "aaa"
    f: Fx<Tuple1<Int32>, Int32> = adder(gs, changeS())
    trace(f(0))
    // A struct receiver beside a mut fx that writes it reads the same however it is named:
    // the global, this, and an implicit this all give 110, never the 210 of the state after.
    trace(ga.plus(bumpA()))
    mut a: Acc = Acc { }
    trace(a.viaThis())
    mut b: Acc = Acc { }
    trace(b.viaImplicit())
    // A mut argument writes its variable while the call runs, so a read of that variable
    // beside the call is made first: x is 5 there (gcc printed 14, clang 4), and xs has
    // 2 elements, read as a List and through a View: 5 - 1, 2, 2.
    mut x: Int32 = 5
    trace(sub(x, inc(mut x)))
    mut xs: List<Int32> = List<Int32> { values = [1, 2] }
    trace(lenOf(xs, pushTo(mut xs)))
    mut ys: List<Int32> = List<Int32> { values = [1, 2] }
    trace(countOf(ys, pushTo(mut ys)))
    // A compound assignment reads its target before a value that writes it: 5 + 1.
    mut z: Int32 = 5
    z += inc(mut z)
    trace(z)
    // A List converted to a View for a parameter that keeps no view is read before the
    // effect like any container, though growL() moves gl's storage: 3.
    gl = List<Int32> { values = [1, 2, 3] }
    trace(countOf(gl, growL()))
    // A generic callee that stores its T, instantiated with a view, points at gl and never
    // at a copy that dies with the lambda: 11, then 1.
    gl = List<Int32> { values = [11, 22, 33] }
    idx = 0
    mut h: Holder<View<Int32>> = Holder<View<Int32>> { v = other, k = 0 }
    keep<View<Int32>>(mut h, gl, nextSize())
    trace(h.v.get(0))
    trace(h.k)
    // A view the callee keeps is made after its siblings' effects (the open D33 question in
    // docs/cpp-known-issues/w2-3-emit-exprs.md): made before growL() moved gl, it would
    // point at freed storage. 11, then 67.
    keep<View<Int32>>(mut h, gl, growL())
    trace(h.v.get(0))
    trace(h.v.size())
    // A function used as a value takes its Fx parameter as a kira::Fn, never a template: 10.
    g: Fx<Tuple2<Fx<Tuple1<Int32>, Int32>, Int32>, Int32> = applyTo
    trace(g(twice, 5))
    // The receiver of a mut fx and a mut argument at an element of a List are located after
    // a sibling that grows the List: C++ bound the element first and wrote into the storage the
    // growth freed. gll[0] ends [1, 7] beside 64 more rows, and gls[0] takes 71 beside 64 more.
    gll.add(List<Int32> { values = [1] })
    gll[0].add(growGll())
    trace(gll[0].size())
    trace(gll[0].get(1))
    trace(gll.size())
    gls.add(100)
    store(mut gls[0], growGls(), 1)
    trace(gls.get(0))
    trace(gls.size())
    // A read through a view is a read of the storage behind it, made before a sibling writes
    // that storage (gcc and MSVC printed 8): 1 - 1.
    v: View<Int32> = gv.view()
    trace(sub(v.get(0), setGv()))
    // A MutView a closure captured, or a List holds, writes what it was lent from: a read of
    // that local is made before any sibling's call (gcc and MSVC printed 8): 1 - 1, twice.
    mut ws: List<Int32> = List<Int32> { values = [1, 2, 3] }
    mv: MutView<Int32> = ws.from(0)
    pk: Fx<Tuple0, Int32> = fx () Int32 {
        mv.set(0, 9)
        return 1
    }
    trace(sub(ws[0], pk()))
    ws.set(0, 1)
    mut ms: List<MutView<Int32>> = List<MutView<Int32>> { }
    ms.add(ws.from(0))
    trace(sub(ws[0], pokeAll(ms)))
    // A MutView a user callee lends out of a mut argument or a mut fx's receiver writes
    // that variable from wherever it went: returned from a function (a List and an Arr),
    // from a struct's mut fx, stored in a global, or returned by an Fx value. Each read is
    // made before the sibling that writes through the view (gcc and MSVC printed 8, clang
    // 0): 1 - 1, five times.
    mut us: List<Int32> = List<Int32> { values = [1, 2, 3] }
    mu: MutView<Int32> = lendList(mut us)
    pu: Fx<Tuple0, Int32> = fx () Int32 {
        mu.set(0, 9)
        return 1
    }
    trace(sub(us[0], pu()))
    mut ua: Arr<Int32, 3> = [1, 2, 3]
    ma: MutView<Int32> = lendArr(mut ua)
    pa: Fx<Tuple0, Int32> = fx () Int32 {
        ma.set(0, 9)
        return 1
    }
    trace(sub(ua[0], pa()))
    mut lb: Lender = Lender { }
    mb: MutView<Int32> = lb.lend()
    pb: Fx<Tuple0, Int32> = fx () Int32 {
        mb.set(0, 9)
        return 1
    }
    trace(sub(lb.xs[0], pb()))
    mut ug: List<Int32> = List<Int32> { values = [1, 2, 3] }
    lendGlobal(mut ug)
    trace(sub(ug[0], writeLent()))
    lendFx: Fx<Tuple1<mut List<Int32>>, MutView<Int32>> = fx (mut zs: List<Int32>) MutView<Int32> {
        return zs.from(0)
    }
    mut uf: List<Int32> = List<Int32> { values = [1, 2, 3] }
    mf: MutView<Int32> = lendFx(mut uf)
    pf: Fx<Tuple0, Int32> = fx () Int32 {
        mf.set(0, 9)
        return 1
    }
    trace(sub(uf[0], pf()))
}

fx lendList: (mut xs: List<Int32>) MutView<Int32> {
    return xs.from(0)
}

fx lendArr: (mut a: Arr<Int32, 3>) MutView<Int32> {
    return a.from(0)
}

pub struct Lender {
    pub xs: List<Int32> = List<Int32> { values = [1, 2, 3] }

    pub mut fx lend: () MutView<Int32> {
        return xs.from(0)
    }
}

mut glent: Maybe<MutView<Int32>> = null

fx lendGlobal: (mut xs: List<Int32>) Void {
    glent = xs.from(0)
}

fx writeLent: () Int32 {
    glent.unwrap().set(0, 9)
    return 1
}

mut gll: List<List<Int32>> = List<List<Int32>> { }
mut gls: List<Int32> = List<Int32> { }
mut gv: List<Int32> = List<Int32> { values = [1, 2, 3] }

// Appends past any capacity gll had: its rows move.
fx growGll: () Int32 {
    mut i: Int32 = 0
    while i < 64 {
        gll.add(List<Int32> { values = [i] })
        i += 1
    }
    return 7
}

// Appends past any capacity gls had: its storage moves.
fx growGls: () Int32 {
    mut i: Int32 = 0
    while i < 64 {
        gls.add(i)
        i += 1
    }
    return 7
}

fx setGv: () Int32 {
    gv.set(0, 9)
    return 1
}

fx pokeAll: (ms: List<MutView<Int32>>) Int32 {
    ms.get(0).set(0, 9)
    return 1
}

fx inc: (mut v: Int32) Int32 {
    v += 10
    return 1
}

fx pushTo: (mut into: List<Int32>) Size {
    into.add(7)
    return 0
}

fx lenOf: (items: List<Int32>, k: Size) Size {
    return items.size()
}

fx countOf: (v: View<Int32>, k: Size) Size {
    return v.size()
}

// Appends past any capacity gl had: its storage moves.
fx growL: () Size {
    mut i: Int32 = 0
    while i < 64 {
        gl.add(i)
        i += 1
    }
    return 0
}

pub struct Holder<T> {
    pub v: T
    pub k: Size = 0
}

fx keep<T>: (mut into: Holder<T>, value: T, k: Size) Void {
    into.v = value
    into.k = k
}

fx applyTo: (f: Fx<Tuple1<Int32>, Int32>, n: Int32) Int32 {
    return f(n)
}

fx twice: (n: Int32) Int32 {
    return n * 2
}

pub struct Win {
    pub v: View<Int32>
    pub k: Size = 0

    pub mut fx attach: (src: View<Int32>, k: Size) Void {
        v = src
        this.k = k
    }
}

mut other: List<Int32> = List<Int32> { values = [1, 2, 3] }

fx fill: (mut w: Win, xs: List<Int32>, k: Size) Void {
    w.v = xs.from(0)
    w.k = k
}

fx adder: (s: Str, k: Int32) Fx<Tuple1<Int32>, Int32> {
    n: Int32 = s.length() as Int32
    return fx (x: Int32) Int32 {
        return x + n + k
    }
}

pub struct Acc {
    pub n: Int32 = 1

    pub mut fx bump: () Int32 {
        n = 2
        return 10
    }

    pub fx plus: (k: Int32) Int32 {
        return n * 100 + k
    }

    pub mut fx viaThis: () Int32 {
        return this.plus(bump())
    }

    pub mut fx viaImplicit: () Int32 {
        return plus(bump())
    }
}

mut ga: Acc = Acc { }

fx bumpA: () Int32 {
    ga.n = 2
    return 10
}

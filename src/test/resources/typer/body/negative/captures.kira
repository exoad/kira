module "fixture:body.captures"

// A lambda's capture is an immutable copy (spec): a `mut fx` on one writes it, like assigning
// it or passing it as `mut`. A type parameter reaches only its bounds' members (a cyclic
// bound reaches none). A magic call whose C++ binding is not constexpr is no constant, and
// neither is a read of a global whose type C++ builds at run time (an Arr<T> or List<T> is a
// std::vector, no literal type on the gcc 11.4 floor): `inline constexpr` cannot hold the
// result, and a static assert on one has no C++ spelling at all.

pub trait Shape {
    pub fx area: () Float64;
}

pub struct Pt {
    pub x: Int32 = 0

    pub mut fx shift: (d: Int32) Void {
        x += d
    }

    pub fx shifter: () Fx<Tuple0, Void> {
        return fx() Void {
            shift(1)                       // @error types.lambda.assign-capture
        }
    }

    pub fx shifterThis: () Fx<Tuple0, Void> {
        return fx() Void {
            this.shift(1)                  // @error types.lambda.assign-capture
        }
    }
}

pub struct Frame {
    pub origin: Pt = Pt { }
}

pub fx captures: (mut q: Pt, mut fr: Frame) Int32 {
    mut xs: List<Int32> = List<Int32> { }
    mut p: Pt = Pt { }
    mut buf: StrBuf<64> = StrBuf<64> { }
    mut ages: Map<Str, Int32> = Map<Str, Int32> { }
    mut ptsInside: Arr<Pt> = [Pt { }]
    g: Fx<Tuple0, Void> = fx() Void {
        xs.add(1)                          // @error types.lambda.assign-capture
        p.shift(2)                         // @error types.lambda.assign-capture
        q.shift(3)                         // @error types.lambda.assign-capture
        buf.clear()                        // @error types.lambda.assign-capture
        ages.put("a", 1)                   // @error types.lambda.assign-capture
        fr.origin.shift(4)                 // @error types.lambda.assign-capture
        ptsInside[0].shift(5)              // @error types.lambda.assign-capture
        n: Size = xs.size()                // no error: a read
    }
    g()
    return p.x
}

pub fx unbounded<T>: (s: T) Float64 {
    return s.area()                        // @error types.member.unknown
}

pub fx wrongBound<T: Shape>: (s: T) Float64 {
    return s.perimeter()                   // @error types.member.unknown
}

pub fx noField<T: Shape>: (s: T) Float64 {
    return s.side                          // @error types.member.unknown
}

pub fx cyclic<T: T>: (s: T) Float64 {
    return s.area()                        // @error types.member.unknown
}

pub fx mutual<T: U, U: T>: (s: T, u: U) Float64 {
    return s.area() + u.area()             // @error types.member.unknown ; @error types.member.unknown
}

pub ROOT2: Float64 = sqrt(2.0)             // @error types.const.not-constant
pub SCALED: Float64 = sqrt(2.0) * 2.0      // @error types.const.not-constant
pub mut SEED: Float64 = sqrt(4.0)          // @error types.global.mut-init
@_static_assert(floor(1.5) == 1.0, "no")  // @error types.static-assert.not-constant

pub struct Bag {
    pub items: List<Int32> = []
    pub n: Int32 = 1
}

pub DYN: Arr<Int32> = [1, 2, 3]            // no error: built at run time from literals, in no order (D49)
pub DSIZE: Size = DYN.size()               // @error types.const.not-constant
pub DFIRST: Int32 = DYN.get(0)             // @error types.const.not-constant
pub DV: View<Int32> = DYN.view()           // @error types.const.not-constant; @error rules.view.type
pub DCOPY: Arr<Int32> = DYN.clone()        // @error types.const.not-constant
pub mut SEED0: Int32 = DYN.get(0) + 1      // @error types.global.mut-init
pub LST: List<Int32> = [4, 5]
pub L0: Int32 = LST[0]                     // @error types.const.not-constant
pub BAG: Bag = Bag { }
pub BN: Int32 = BAG.n                      // @error types.const.not-constant
pub mut BAGS: Bag = Bag { n = BAG.n }      // @error types.global.mut-init
@_static_assert(DYN.size() == 3, "x")     // @error types.static-assert.not-constant
@_static_assert(BAG.n == 1, "x")          // @error types.static-assert.not-constant

// A construction that leaves a field to its default runs the default (C++: `W{}` over a default
// member initializer), and a call that leaves a parameter to its default passes the default.
fx seed: () Int32 {
    return 4
}

pub struct Seeded {
    pub n: Int32 = seed()
}

pub struct Sized {
    pub n: Size = DYN.size()
}

pub struct SizedBag {
    pub items: List<Int32> = []
    pub n: Size = DYN.size()
}

pub KS: Seeded = Seeded { }                // @error types.const.not-constant
pub KSN: Int32 = KS.n                      // no error: KS is a constant of a literal type, and its own line said why
pub KG: Seeded = Seeded { 5 }              // no error: the default does not run
pub mut GS: Sized = Sized { }              // @error types.global.mut-init
pub mut GG: Sized = Sized { 3 }
pub mut GB: SizedBag = SizedBag { }        // @error types.global.mut-init
pub mut GBG: SizedBag = SizedBag { n = 3 }

pub @_const fx firstOf: (xs: Arr<Int32> = DYN) Int32 { // @error rules.const.type
    return xs.get(0)
}

pub @_const fx addTo: (a: Int32, b: Int32 = 2) Int32 {
    return a + b
}

pub FD: Int32 = firstOf()                  // @error types.const.not-constant
pub AK: Int32 = addTo(1)                   // no error: the default is a literal

// An operator with an @op_* overload is a call of that function: constant only when it is @_const.
pub struct V2 {
    pub x: Int32 = 0
}

pub fx @op_add: (a: V2, b: V2) V2 {
    return V2 { a.x + b.x }
}

pub fx @op_eq: (a: V2, b: V2) Bool {
    return a.x == b.x
}

pub A: V2 = V2 { 1 }
pub B: V2 = A + A                          // @error types.const.not-constant
pub BX: Int32 = (A + A).x                  // @error types.const.not-constant
pub EQ: Bool = A == A                      // @error types.const.not-constant
pub mut MV: V2 = A + A                     // @error types.global.mut-init
@_static_assert(A == A, "eq")             // @error types.static-assert.not-constant

// s[i] on a Str is kira::str::at, which is not constexpr, even on a folded Str constant.
pub SEP: Str = ","
pub SC: Char = SEP[0]                      // @error types.const.not-constant
pub mut MC: Char = SEP[0]                  // @error types.global.mut-init
@_static_assert(SEP[0] == ',', "sep")     // @error types.static-assert.not-constant
@_static_assert(","[0] == ',', "lit")     // @error types.static-assert.not-constant

// A struct that contains itself has no C++ spelling, so it is no literal type: a constant of
// it is built at run time, and reading it is no constant.
pub struct Node {
    pub v: Int32 = 0
    pub next: Maybe<Node> = null
}

pub struct NA {
    pub b: Maybe<NB> = null
}

pub struct NB {
    pub a: Maybe<NA> = null
}

pub N0: Node = Node { }                    // no error: built at run time from literals, in no order
pub mut HEAD: Node = Node { }
pub NV: Int32 = N0.v                       // @error types.const.not-constant
pub NA0: NA = NA { }
pub NAB: Maybe<NB> = NA0.b                 // @error types.const.not-constant

// A generic struct instance is literal when its arguments make its fields so.
pub struct Box<T> {
    pub v: T
}

pub BL: Box<List<Int32>> = Box<List<Int32>> { [] }
pub BLN: Size = BL.v.size()                // @error types.const.not-constant

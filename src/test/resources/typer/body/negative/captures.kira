// A lambda's capture of a value that is not Mutable is an immutable copy (spec): assigning it is refused,
// while a Mutable value is shared, so a lambda may change it (stage 4). A type parameter reaches only its bounds' members (a cyclic
// bound reaches none). A magic call whose C++ binding is not constexpr is no constant, and
// neither is a read of a global whose type C++ builds at run time (an Arr<T> or List<T> is a
// std::vector, no literal type on the gcc 11.4 floor): `inline constexpr` cannot hold the
// result, and a static assert on one has no C++ spelling at all.

pub Shape: Any {
    pub area: () Float64;
}

pub Pt: Struct {
    pub x: Int32 = 0

    pub moved: (d: Int32) Pt {
        Pt { x + d }
    }
}

pub captures: (q: Pt) Int32 {
    n: Mutable<Int32> = 0
    p: Mutable<Pt> = Pt { }
    g: Fx<Tuple0, Void> = () Void {
        n = 1                              // @error types.lambda.assign-capture
        p = p.moved(2)                     // @error types.lambda.assign-capture
        k: Int32 = n + q.x                 // no error: a read
    }
    g()
    p.x
}

pub unbounded<T>: (s: T) Float64 {
    s.area()                        // @error types.member.unknown
}

pub wrongBound<T: Shape>: (s: T) Float64 {
    s.perimeter()                   // @error types.member.unknown
}

pub noField<T: Shape>: (s: T) Float64 {
    s.side                          // @error types.member.unknown
}

pub cyclic<T: T>: (s: T) Float64 {
    s.area()                        // @error types.member.unknown
}

pub mutual<T: U, U: T>: (s: T, u: U) Float64 {
    s.area() + u.area()             // @error types.member.unknown ; @error types.member.unknown
}

pub ROOT2: Float64 = sqrt(2.0)             // @error types.const.not-constant
pub SCALED: Float64 = sqrt(2.0) * 2.0      // @error types.const.not-constant
pub SEED: Mutable<Float64> = sqrt(4.0)          // @error types.global.mut-init
@_static_assert(floor(1.5) == 1.0, "no")  // @error types.static-assert.not-constant

pub Bag: Mutable<Any> {
    pub items: List<Int32> = @listOf()
    pub n: Int32 = 1
}

pub DYN: Arr<Int32> = @arrOf(1, 2, 3)            // no error: built at run time from literals, in no order (D49)
pub DSIZE: Size = DYN.size()               // @error types.const.not-constant
pub DFIRST: Int32 = DYN.get(0)             // @error types.const.not-constant
pub DV: View<Int32> = DYN.view()           // @error types.const.not-constant; @error rules.view.type
pub DCOPY: Arr<Int32> = DYN.clone()        // @error types.const.not-constant
pub SEED0: Mutable<Int32> = DYN.get(0) + 1      // @error types.global.mut-init
pub LST: List<Int32> = @listOf(4, 5)
pub L0: Int32 = LST[0]                     // @error types.const.not-constant
pub BAG: Bag = Bag { }
pub BN: Int32 = BAG.n                      // @error types.const.not-constant
pub BAGS: Mutable<Bag> = Bag { n = BAG.n }      // @error types.global.mut-init
@_static_assert(DYN.size() == 3, "x")     // @error types.static-assert.not-constant
@_static_assert(BAG.n == 1, "x")          // @error types.static-assert.not-constant

// A construction that leaves a field to its default runs the default (C++: `W{}` over a default
// member initializer), and a call that leaves a parameter to its default passes the default.
seed: () Int32 {
    4
}

pub Seeded: Struct {
    pub n: Int32 = seed()
}

pub Sized: Struct {
    pub n: Size = DYN.size()
}

pub SizedBag: Mutable<Any> {
    pub items: List<Int32> = @listOf()
    pub n: Size = DYN.size()
}

pub KS: Seeded = Seeded { }                // @error types.const.not-constant
pub KSN: Int32 = KS.n                      // no error: KS is a constant of a literal type, and its own line said why
pub KG: Seeded = Seeded { 5 }              // no error: the default does not run
pub GS: Mutable<Sized> = Sized { }              // @error types.global.mut-init
pub GG: Mutable<Sized> = Sized { 3 }
pub GB: Mutable<SizedBag> = SizedBag { }        // @error types.global.mut-init
pub GBG: Mutable<SizedBag> = SizedBag { n = 3 }

pub @_const firstOf: (xs: Arr<Int32> = DYN) Int32 { // @error rules.const.type
    xs.get(0)
}

pub @_const addTo: (a: Int32, b: Int32 = 2) Int32 {
    a + b
}

pub FD: Int32 = firstOf()                  // @error types.const.not-constant
pub AK: Int32 = addTo(1)                   // no error: the default is a literal

// An operator with an @op_* overload is a call of that function: constant only when it is @_const.
pub V2: Struct {
    pub x: Int32 = 0
}

pub @op_add: (a: V2, b: V2) V2 {
    V2 { a.x + b.x }
}

pub @op_eq: (a: V2, b: V2) Bool {
    a.x == b.x
}

pub A: V2 = V2 { 1 }
pub B: V2 = A + A                          // @error types.const.not-constant
pub BX: Int32 = (A + A).x                  // @error types.const.not-constant
pub EQ: Bool = A == A                      // @error types.const.not-constant
pub MV: Mutable<V2> = A + A                     // @error types.global.mut-init
@_static_assert(A == A, "eq")             // @error types.static-assert.not-constant

// s[i] on a Str is kira::str::at, which is not constexpr, even on a folded Str constant.
pub SEP: Str = ","
pub SC: Char = SEP[0]                      // @error types.const.not-constant
pub MC: Mutable<Char> = SEP[0]                  // @error types.global.mut-init
@_static_assert(SEP[0] == ',', "sep")     // @error types.static-assert.not-constant
@_static_assert(","[0] == ',', "lit")     // @error types.static-assert.not-constant

// A struct that contains itself has no C++ spelling, so it is no literal type: a constant of
// it is built at run time, and reading it is no constant.
pub Node: Struct {
    pub v: Int32 = 0
    pub next: Maybe<Node> = null
}

pub Na: Struct {
    pub b: Maybe<Nb> = null
}

pub Nb: Struct {
    pub a: Maybe<Na> = null
}

pub N0: Node = Node { }                    // no error: built at run time from literals, in no order
pub HEAD: Mutable<Node> = Node { }
pub NV: Int32 = N0.v                       // @error types.const.not-constant
pub NA0: Na = Na { }
pub NAB: Maybe<Nb> = NA0.b                 // @error types.const.not-constant

// A generic struct instance is literal when its arguments make its fields so.
pub Box<T>: Struct {
    pub v: T
}

pub BL: Box<List<Int32>> = Box<List<Int32>> { @listOf() }
pub BLN: Size = BL.v.size()                // @error types.const.not-constant

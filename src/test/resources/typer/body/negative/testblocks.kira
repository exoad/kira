// Test blocks (stage 3b) that are refused: a check that names no member, a value by position,
// a name both a parameter and a member, an effect, an identity with no members, a nested block
// whose type shares a member name.

pub Pt: Struct {
    pub x: Int32 = 0
    pub y: Int32 = 0
}

pub Node: Struct {
    pub value: Int32 = 0
}

pub Tree: Struct {
    pub value: Int32 = 0
    pub left: Node
}

loud: () Int32 {
    trace(1)
    return 1
}

pub refused: (p: Pt, t: Tree, k: Int32, x: Int32, f: (v: Int32) Int32, xs: List<Int32>) Void {
    a: Bool = p == Pt { k > 0 }                                    // @error types.test.unnamed
    b: Bool = p == Pt { y }                                        // @error types.test.check
    c: Bool = p == Pt { x == 1 }                                   // @error types.test.clash
    d: Bool = p == Pt { y == loud() }                              // @error types.test.effect
    e: Bool = k == Int32 { k > 0 }                                 // @error types.test.identity
    g: Bool = f == (Int32) Int32 { k > 0 }                         // @error types.test.identity
    l: Bool = xs == List<Int32> { size() > 0 }                     // @error types.test.identity
    h: Bool = t == Tree { left == Node { value == 1 } }            // @error types.test.nested
    n: Bool = p == Pt { z == 1 }                                   // @error types.name.unknown
}

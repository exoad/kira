ambiguous.left as left
ambiguous.right as right

// A name two used modules export is ambiguous as a call and as a value; qualify it.

pub run: () Int32 {
    a: Int32 = percent(5)                  // @error types.call.ambiguous
    b: Int32 = SCALE                       // @error types.name.ambiguous
    c: Int32 = left.percent(5)
    return a + b + c
}

ambiguous.left as left
ambiguous.right as right

// A name two imports export is in scope bare through neither (stage 5): qualify it, or alias one.

pub run: () Int32 {
    a: Int32 = percent(5)                  // @error types.use.bare
    b: Int32 = SCALE                       // @error types.use.bare
    c: Int32 = left.percent(5)
    a + b + c
}

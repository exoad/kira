module "fixture:body.operators"

// Operators (design 3.3): identical operand types, no widening, a literal side takes the other
// side's type. R1, R11, R12, R14, R16, R17.

pub enum Mode: Int32 {
    MODE_OFF = 0,
    MODE_ON = 1
}

pub fx arithmetic: (a: Int32, b: Int32, u: UInt8, v: UInt8, x: Float32, y: Float64, n: Size, big: Int64) Void {
    s1: Int32 = a + b                      // @type Int32
    s2: UInt8 = u + v                      // @type UInt8
    s3: UInt8 = u & 7                      // @type UInt8 const=7:UInt8 @ 7
    s4: Float32 = x * 1000.0 + 0.5         // @type Float32
    s5: Float32 = x * 1000.0               // @type Float32 const=1000.0:Float32 @ 1000.0
    s6: Float64 = y / 3.0                  // @type Float64
    s7: Int32 = a % 10                     // @type Int32 const=10:Int32 @ 10
    s8: Size = n * 4 + 1                   // @type Size
    s9: Int64 = big - 1                    // @type Int64 const=1:Int64 @ 1
    s10: Int64 = 1000000 * 1000000         // @type Int64 const=1000000000000:Int64
    s11: Int32 = a << 2                    // @type Int32
    s12: UInt32 = 1 << 31                  // @type UInt32 const=2147483648:UInt32
    s13: Int32 = a >> 1                    // @type Int32 const=1:Int32 @ 1
    s14: UInt8 = ~u                        // @type UInt8
    s15: Int32 = -a                        // @type Int32
    s16: Int32 = (a + 1) * (b - 2)         // @type Int32
    s17: UInt32 = 0xFF ^ 0x0F              // @type UInt32 const=240:UInt32
    s18: Int32 = a | b                     // @type Int32
    s19: UInt8 = 200 + 100                 // @type UInt8 const=44:UInt8
    s20: Float64 = 1 + y                   // @type Float64 const=1.0:Float64 @ 1
    s21: Int32 = 7 / 2                     // @type Int32 const=3:Int32
    s22: Int32 = -7 % 3                    // @type Int32 const=-1:Int32
    s23: Float32 = -x                      // @type Float32
}

pub fx comparisons: (a: Int32, b: Int32, x: Float32, n: Size, s: Str, ch: Char, m: Mode, flag: Bool) Void {
    c1: Bool = a < b                       // @type Bool
    c2: Bool = n < s.length()              // @type Bool
    c3: Bool = x < 0.0                     // @type Float32 const=0.0:Float32 @ 0.0
    c4: Bool = c1 && !c2                   // @type Bool
    c5: Bool = ch < 'z'                    // @type Bool
    c6: Bool = ch == '-'                   // @type Char const='-' @ '-'
    c7: Bool = s == "kira"                 // @type Bool
    c8: Bool = m == Mode.MODE_ON           // @type Bool
    c9: Bool = 0 < n                       // @type Size const=0:Size @ 0
    c10: Bool = a + b > 250                // @type Int32 const=250:Int32 @ 250
    c11: Bool = flag == c1                 // @type Bool
    c12: Bool = flag || a != b             // @type Bool
    c13: Bool = !(a >= b)                  // @type Bool
    c14: Bool = 2 == 2                     // @type Bool const=true
    c15: Bool = 1.5 < 2.5                  // @type Bool const=true
    c16: Bool = s < "kira"                 // @type Bool
    c17: Bool = s >= s                     // @type Bool
}

pub fx strings: (s: Str, t: Str, a: Int32) Void {
    j: Str = s + t                         // @type Str
    k: Str = "<" + s + ">"                 // @type Str
    ch: Char = s[0]                        // @type Char place=Index(Param(s), STR)
    idx: Char = s[1]                       // @type Size const=1:Size @ 1
    interp: Str = "x=${a} y=${s}"          // @type Str
    folded: Str = "a" + "b"                // @type Str const="ab"
    same: Bool = s == t                    // @type Bool
}

pub LIMIT: Int32 = 10
pub HALF: Float32 = 0.5
pub SHIFT: UInt32 = 1 << 4

pub fx constants: (a: Int32) Int32 {
    b: Int32 = a * LIMIT                   // @type Int32 const=10:Int32 sym=fixture:body.operators.LIMIT @ LIMIT
    c: Int32 = LIMIT + 1                   // @type Int32 const=11:Int32
    d: Float32 = HALF * 2.0                // @type Float32 const=1.0:Float32
    return b + c                           // @type Int32
}

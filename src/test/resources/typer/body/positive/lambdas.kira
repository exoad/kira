// Lambdas (design 3.3, 5.6, D24): checked against the expected Fx;
// captures by value (TyperBodyModelTest checks the capture lists).

pub scaleBy: (k: Int32) Fx<Tuple1<Int32>, Int32> {
    (x: Int32) Int32 {            // @type Fx<Tuple1<Int32>, Int32>
        x * k                       // @type Int32 place=Param(k) @ k
    }
}

pub shared: () Fx<Tuple0, Int32> {
    counter: Ref<Int32> = Ref<Int32> { value = 0 }; // @type Ref<Int32>
    () Int32 {                    // @type Fx<Tuple0, Int32>
        counter.value = counter.value + 1  // @type Void
        counter.value               // @type Int32 member=Field(Ref.value: Int32)
    }
}

pub store: () Int32 {
    add: Fx<Tuple2<Int32, Int32>, Int32> = (a: Int32, b: Int32) Int32 { a + b } // @type Fx<Tuple2<Int32, Int32>, Int32>
    three: Int32 = add(1, 2)               // @type Int32 call=FN_VALUE
    three
}

pub nested: (base: Int32) Fx<Tuple1<Int32>, Fx<Tuple1<Int32>, Int32>> {
    (a: Int32) Fx<Tuple1<Int32>, Int32> {
        (b: Int32) Int32 {
            base + a + b            // @type Int32
        }
    }
}

pub Gain: Struct {
    pub k: Int32 = 3

    pub scaler: () Fx<Tuple1<Int32>, Int32> {
        (x: Int32) Int32 {
            x * k                   // @type Int32 place=Field(This(Gain).k) @ k
        }
    }
}

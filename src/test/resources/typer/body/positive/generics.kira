module "fixture:body.generics"

// Receivers of a type parameter (design 5.5): the members of T's bounds are reachable on a T
// value, dispatched statically through the bound (a trait bound is a TRAIT call, `Num` a MAGIC
// one whose `Num` results are T again). A List takes an array literal from its context (spec),
// a magic call whose C++ binding is constexpr is a constant, and a `mut fx` on a class
// reference or on a lambda's own local is no write to a capture.

pub trait Shape {
    pub fx area: () Float64;
    pub fx describe: () Str {
        return "shape"
    }
}

pub struct Square: Shape {
    pub side: Float64 = 2.0

    override pub fx area: () Float64 {
        return side * side
    }
}

pub class Named {
    require pub name: Str
    pub mut hits: Int32 = 0

    pub mut fx hit: () Void {
        hits += 1
    }
}

pub class Tagged: Named {
    pub tag: Int32 = 0
}

pub fx areaOf<T: Shape>: (s: T) Float64 {
    return s.area()                        // @type Float64 call=TRAIT(Shape.area)
}

pub fx describe<T: Shape>: (s: T) Str {
    return s.describe()                    // @type Str call=TRAIT(Shape.describe)
}

pub fx magnitude<T: Num>: (x: T) T {
    return x.abs()                         // @type T call=MAGIC(Num.abs)
}

pub fx widen<T: Num>: (x: T) Int64 {
    return x.toInt64()                     // @type Int64 call=MAGIC(Num.toInt64)
}

pub fx same<T: Num>: (a: T, b: T) Bool {
    return a.equals(b)                     // @type Bool call=MAGIC(Equatable.equals)
}

pub fx nameOf<T: Named>: (n: T) Str {
    return n.name                          // @type Str member=Field(Named.name: Str)
}

pub fx touch<T: Named>: (n: T) Int32 {
    n.hit()                                // @type Void call=METHOD(Named.hit)
    return n.hits                          // @type Int32 member=Field(Named.hits: Int32)
}

pub fx uses: () Float64 {
    sq: Square = Square { }                // @type Square
    a: Float64 = areaOf<Square>(sq)        // @type Float64 call=FREE(areaOf)
    m: Int32 = magnitude<Int32>(-4)        // @type Int32 call=FREE(magnitude)
    t: Tagged = Tagged { "t" }             // @type Tagged
    h: Int32 = touch<Tagged>(t)            // @type Int32 call=FREE(touch)
    return a
}

pub fx lists: () Int32 {
    xs: List<Int32> = [1, 2, 3]            // @type List<Int32> @ [1, 2, 3]
    ys: List<Float32> = [1.0, 2.5]         // @type List<Float32> @ [1.0, 2.5]
    zs: List<Str> = ["a"]                  // @type List<Str> @ ["a"]
    return xs.get(0)                       // @type Int32 call=MAGIC(List.get)
}

pub NEG: Int32 = -3
pub POS: Int32 = NEG.abs()                 // @type Int32 call=MAGIC(Num.abs)
pub HALF: Float32 = 0.5
pub BITS: UInt32 = bitCast<UInt32>(HALF)   // @type UInt32 call=MAGIC(bitCast)
pub mut LEVEL: Int32 = POS * 2             // @type Int32

pub fx sharedWrites: (counter: Named) Fx<Tuple0, Void> {
    return fx() Void {                     // @type Fx<Tuple0, Void>
        counter.hit()                      // @type Void call=METHOD(Named.hit)
        mut own: List<Int32> = List<Int32> { }
        own.add(1)                         // @type Void call=MAGIC(List.add)
    }
}

pub class Tally {
    pub mut n: Int32 = 0

    pub mut fx bump: () Void {
        n += 1
    }

    pub fx bumper: () Fx<Tuple0, Void> {
        return fx() Void {
            bump()                         // @type Void call=METHOD(Tally.bump)
        }
    }
}

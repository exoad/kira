// Classes, structs, traits and generics (design 5.5): construction (R9), member access (R4),
// the implicit receiver, `this`, upcasts, virtual and trait dispatch, identity and memberwise
// equality (R16).

pub Speaker: Any {
    pub speak: () Str;
    pub loud: () Str {
        speak() + "!"               // @type Str call=TRAIT(Speaker.speak) @ speak()
    }
}

pub Animal: Any {
    pub name: Str
    pub mut age: Int32 = 0

    pub describe: () Str {
        name                        // @type Str place=Field(This(Animal).name) sym=Animal.name
    }

    pub sound: () Str {
        "..."                       // @type Str
    }

    pub mut birthday: () Void {
        age += 1                           // @type Int32 place=Field(This(Animal).age) @ age
    }
}

pub Dog: Animal, Speaker {
    pub mut tricks: Int32 = 0

    override pub sound: () Str {
        "woof"                      // @type Str
    }

    override pub speak: () Str {
        sound()                     // @type Str call=VIRTUAL(Dog.sound)
    }

    pub me: () Dog {
        this                        // @type Dog place=This(Dog)
    }

    pub next: () Int32 {
        this.tricks + 1             // @type Int32 member=Field(Dog.tricks: Int32) @ this.tricks
    }

    pub greet: () Str {
        "${name} (${age})"          // @type Str place=Field(This(Dog).name) @ name
    }
}

pub Point: Struct {
    pub x: Int32 = 0
    pub y: Int32 = 0

    pub sum: () Int32 {
        x + y                       // @type Int32
    }

    pub mut shift: (dx: Int32) Void {
        x += dx                            // @type Int32 place=Field(This(Point).x) @ x
    }
}

pub Box<T>: Any {
    pub value: T

    pub get: () T {
        value                       // @type T
    }
}

pub classes: () Void {
    d: Dog = Dog { "Rex" }                 // @type Dog
    d2: Dog = Dog { name = "Bo", tricks = 2 } // @type Dog
    a: Animal = d                          // @type Dog coerce=Upcast(Dog -> Animal)
    s: Speaker = d                         // @type Dog coerce=Upcast(Dog -> Speaker)
    n: Str = d.name                        // @type Str member=Field(Animal.name: Str)
    t: Str = s.speak()                     // @type Str call=TRAIT(Speaker.speak)
    lt: Str = s.loud()                     // @type Str call=TRAIT(Speaker.loud)
    u: Str = a.sound()                     // @type Str call=VIRTUAL(Animal.sound)
    v: Str = a.describe()                  // @type Str call=METHOD(Animal.describe)
    w: Str = d.speak()                     // @type Str call=VIRTUAL(Dog.speak)
    mut p: Point = Point { 1, 2 }          // @type Point
    q: Point = Point { y = 5 }             // @type Point
    total: Int32 = p.sum()                 // @type Int32 call=METHOD(Point.sum)
    p.shift(3)                             // @type Void call=METHOD(Point.shift)
    p.x = 7                                // @type Int32 member=Field(Point.x: Int32) place=Field(Local(p).x) @ p.x
    b: Box<Int32> = Box<Int32> { value = 5 } // @type Box<Int32>
    got: Int32 = b.get()                   // @type Int32 call=METHOD(Box.get)
    bv: Int32 = b.value                    // @type Int32 member=Field(Box.value: Int32)
    same: Bool = d == a                    // @type Dog coerce=Upcast(Dog -> Animal) @ d
    pts: Bool = p == q                     // @type Bool
    ma: Maybe<Animal> = d                  // @type Dog coerce=WrapSome(Animal)
    d.birthday()                           // @type Void call=METHOD(Animal.birthday)
    words: Tuple2<Str, Int32> = Tuple2<Str, Int32> { "a", 1 } // @type Tuple2<Str, Int32>
    first: Str = words.first               // @type Str member=Field(Tuple2.first: Str)
}

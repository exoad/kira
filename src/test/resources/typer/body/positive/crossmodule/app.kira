crossmodule.lib as xlib
crossmodule.lib.Meter as Meter
crossmodule.lib.SCALE as SCALE
crossmodule.lib.percent as percent

// Names from a used module: its pub functions, constants, enums and classes, and the module's
// own name as a qualifier.

pub run: () Int32 {
    a: Int32 = percent(5)                  // @type Int32 call=FREE(percent)
    b: Int32 = xlib.percent(5, 10)         // @type Int32 call=FREE(percent)
    c: Int32 = SCALE                       // @type Int32 const=100:Int32 sym=crossmodule:lib.SCALE
    d: Int32 = xlib.SCALE                  // @type Int32 member=Module(crossmodule:lib.SCALE) const=100:Int32
    m: Meter = Meter { 30 }                // @type Meter
    h: Int32 = m.half()                    // @type Int32 call=METHOD(Meter.half)
    a + b + c + d + h               // @type Int32
}

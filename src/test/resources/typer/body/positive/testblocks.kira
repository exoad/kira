// Test blocks (stage 3b): `value == T { check, ... }`, named checks ANDed, the members of T bare
// by with's scope rule, the subject read as T inside the block and narrowed after it.

pub Pt: Struct {
    pub x: Int32 = 0
    pub y: Int32 = 0

    pub sum: () Int32 {
        return x + y
    }
}

pub Line: Struct {
    pub start: Pt
    pub end: Pt
    pub closed: Bool = false

    pub length: () Int32 {
        return end.x - start.x
    }
}

pub Shape: Any {
    pub area: () Int32;
}

pub Circle: Shape {
    pub radius: Int32

    override pub area: () Int32 {
        return radius
    }
}

LIMIT: Int32 = 4

probe: () Pt {
    return Pt { 1, 2 }
}

pub checks: (p: Pt, line: Line, m: Maybe<Pt>, s: Shape, k: Int32) Void {
    a: Bool = p == Pt { x == 0 }                                   // @type Int32 place=Field(Param(p).x) @ x
    b: Bool = p == Pt { x == k, y > LIMIT }                        // @type Bool
    c: Bool = p == Pt { sum() > 2 }                                // @type Int32 call=METHOD(Pt.sum) @ sum()
    d: Bool = line == Line { start == Pt { x == 0 }, length() > 1 } // @type Pt place=Field(Param(line).start) @ start
    e: Bool = line == Line { closed }                              // @type Bool place=Field(Param(line).closed) @ closed
    f: Bool = m == Pt { x == 1 || y == 1 }                         // @type Bool
    g: Bool = p != Pt { x == 0 }                                   // @type Bool
    h: Bool = s == Circle { radius > 2 }                           // @type Int32 place=Field(Param(s).radius) @ radius
    n: Bool = probe() == Pt { y == 2 }                             // @type Bool
}

// Inside the block the subject reads as what the identity test proved; after it, as lane B's tests do.
pub narrowing: (m: Maybe<Pt>, s: Shape) Int32 {
    inside: Bool = m == Pt { x == m.y }                            // @type Int32 member=Field(Pt.y: Int32) @ m.y
    if m == Pt { x > 0 } {
        return m.x                                                 // @type Pt place=Param(m) @ m
    }
    if s != Circle { radius > 1 } {
        return 0
    }
    return s.radius                                                // @type Circle place=Param(s) @ s
}

// The outer scope comes after the members: a field of the enclosing type, then the module.
pub Grid: Struct {
    pub limit: Int32 = 3

    pub inside: (p: Pt) Bool {
        return p == Pt { x < limit, y < LIMIT }                    // @type Int32 place=Field(This(Grid).limit) @ limit
    }
}

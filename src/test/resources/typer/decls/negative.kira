// Each declaration below must give a diagnostic; the golden records code, place and message.

// An unknown type.
pub value: Missing = 1

// An alias cycle, and an alias that only reaches one.
pub Pong as Ping
pub Ping as Pong
pub Ping as Echo

// A duplicate declaration.
pub twice: () Void { }
pub twice: () Void { }

// A type with two parents that hold state.
pub First: Any {
    pub a: Int32 = 0
}
pub Second: Any {
    pub b: Int32 = 0
}
pub Both: First, Second { }

// A parent that holds state after a stateless one.
pub Marker: Any { }
pub Late: Marker, First { }

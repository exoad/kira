kira.time as time
kira.test as test

// kira:time's utcStamp (K5): C++'s civil_from_days and py's ordinal write the same text, the milliseconds floored.

pub stamp: (ns: Int64) Str {
    return utcStamp(ns)
}

pub main: () Int32 {
    t: Suite = Suite { title = "utcstamp - kira:time utcStamp" }
    t.checkStr(utcStamp(0), "1970-01-01T00:00:00.000Z", "the epoch")
    t.checkStr(utcStamp(1700000000123456789), "2023-11-14T22:13:20.123Z", "a stamp's milliseconds are floored")
    t.checkStr(utcStamp(999999), "1970-01-01T00:00:00.000Z", "a nanosecond short of a millisecond is none")
    t.checkStr(utcStamp(1000000), "1970-01-01T00:00:00.001Z", "and a millisecond is one")
    t.checkStr(utcStamp(-1), "1969-12-31T23:59:59.999Z", "a nanosecond before 1970 floors to the millisecond before")
    t.checkStr(utcStamp(-1000000), "1969-12-31T23:59:59.999Z", "as a whole millisecond before does")
    t.checkStr(utcStamp(-1000001), "1969-12-31T23:59:59.998Z", "and one more nanosecond floors past it")
    t.checkStr(utcStamp(-86400000000000), "1969-12-31T00:00:00.000Z", "a day before 1970")
    t.checkStr(utcStamp(-2208988800000000000), "1900-01-01T00:00:00.000Z", "1900")
    t.checkStr(utcStamp(-2203891200000000000), "1900-03-01T00:00:00.000Z", "1900 has no leap day")
    t.checkStr(utcStamp(951782400000000000), "2000-02-29T00:00:00.000Z", "2000 has one")
    t.checkStr(utcStamp(951868800000000000), "2000-03-01T00:00:00.000Z", "and March follows it")
    t.checkStr(utcStamp(1709164800000000000), "2024-02-29T00:00:00.000Z", "2024's leap day")
    t.checkStr(utcStamp(4107542400000000000), "2100-03-01T00:00:00.000Z", "2100 has none")
    t.checkStr(utcStamp(9223372036854775807), "2262-04-11T23:47:16.854Z", "the last Int64")
    t.checkStr(utcStamp(-9223372036854775807 - 1), "1677-09-21T00:12:43.145Z", "the first Int64")
    return t.finish()
}

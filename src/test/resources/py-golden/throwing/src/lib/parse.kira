// Throws for app:main to catch: one module's throw, another's try.

pub number: (s: Str) Int64 {
    v: Maybe<Int64> = s.toInt64()
    if v.isNone() {
        throw "not a number: ${s}"
    }
    v.unwrap()
}

pub checked: (x: Int32) Result<Int32, Str> {
    x < 0 ? Result.error("negative: ${x}") : Result.success(x * 2)
}

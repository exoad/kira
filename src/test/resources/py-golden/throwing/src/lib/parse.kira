module "lib:parse"

// Throws for app:main to catch: one module's throw, another's try.

pub fx number: (s: Str) Int64 {
    v: Maybe<Int64> = s.toInt64()
    if v.isNone() {
        throw "not a number: ${s}"
    }
    return v.unwrap()
}

pub fx checked: (x: Int32) Result<Int32, Str> {
    if x < 0 {
        return Result.error("negative: ${x}")
    }
    return Result.success(x * 2)
}

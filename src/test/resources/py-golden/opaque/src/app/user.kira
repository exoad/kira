// A module that uses opaque.kira's handles: each call goes through opaque.kira's checked wrapper.

golden.py.opaque.app.conn as conn
golden.py.opaque.app.conn.Conn as Conn
golden.py.opaque.app.opaque as opaque
golden.py.opaque.app.opaque.Counter as Counter
golden.py.opaque.app.opaque.counter as counter
golden.py.opaque.app.opaque.dialer as dialer
golden.py.opaque.app.opaque.maybeCounter as maybeCounter
golden.py.opaque.app.opaque.sameObject as sameObject

Pair: Mutable<Any> {
    pub left: Counter
    pub spare: Mutable<Maybe<Counter>> = null
}

labelOf: (c: Counter) Str {
    try {
        c.label()
    } on e: Str {
        "no label, ${e}"
    }
}

main: () Void {
    a: Mutable<Counter> = counter("a")
    all: Mutable<List<Counter>> = @listOf(a, counter(""))
    trace(a.bump(2))
    trace(all[0].bump(3))
    trace(sameObject(a, all[0]))
    copied: List<Counter> = all
    trace(sameObject(copied[1], all[1]))
    p: Mutable<Pair> = Pair { a }
    p.spare = maybeCounter("")
    trace(p.spare.isNone())
    p.spare = maybeCounter("c")
    trace(p.spare.value.bump(4))
    trace(p.left.total())
    trace(labelOf(a))
    trace(labelOf(all[1]))
    pair: Tuple2<List<Int32>, Int32> = Tuple2<List<Int32>, Int32> { @listOf(1, 2), 0 }
    trace(a.absorb(pair))
    kept: List<Int32> = pair.first
    trace(kept.size())
    c: Conn = dialer()
    try {
        trace(c.wait())
    } on e: Str {
        trace(e)
    }
}

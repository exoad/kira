module "app:opaque"

// @_opaque handles (D70): the sidecar makes the object and Kira calls its methods by their
// Kira names; user.kira holds them in fields, Lists and Maybes, never copied.

use "app:conn"

pub @_opaque class Counter {
    pub mut fx bump: (by: Int32) Int32
    pub fx total: () Int32
    pub @_extern(raises = "ValueError") fx label: () Str
    pub fx wrong: () Str
    pub fx absorb: (pair: Tuple2<List<Int32>, Int32>) Int32
}

pub @_extern fx counter: (label: Str) Counter

pub @_extern fx maybeCounter: (label: Str) Maybe<Counter>

pub @_extern fx sameObject: (a: Counter, b: Counter) Bool

pub @_extern fx broken: () Counter

pub @_extern fx dialer: () Conn

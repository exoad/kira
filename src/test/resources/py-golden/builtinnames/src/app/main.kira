golden.py.builtinnames.app.other as other
golden.py.builtinnames.app.other.twice as twice

pub globals: Int32 = 5
pub type: Mutable<Int32> = 3

pub Pt: Mutable<Any> {
    pub x: Mutable<Int32> = 0
    pub tags: List<Int32> = List<Int32> { }
}

check: (n: Int32) Int32 {
    if n > 4 {
        throw "big ${n}"
    }
    n
}

pub main: () Int32 {
    a: Mutable<Pt> = Pt { 1 }
    b: Mutable<Pt> = a
    b.x = 2
    b.tags.add(type)
    trace("${a.x} ${a.tags.size()} ${b.x} ${b.tags.size()}")
    trace(globals + twice())
    try {
        trace(check(type))
        trace(check(globals))
    } on e: Str {
        trace(e)
    }
    type = 9
    trace(type)
    0
}

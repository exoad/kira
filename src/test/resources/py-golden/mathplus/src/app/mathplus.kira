module "app:mathplus"

use "kira:math"
use "kira:test"

// kira:math's K5 additions: hypot, atan2 and exp where every libm agrees to the bit, and floorMod, Python's %.

pub fx mod: (a: Float64, b: Float64) Float64 {
    return floorMod(a, b)
}

pub fx hyp: (x: Float64, y: Float64) Float64 {
    return hypot(x, y)
}

pub fx angle: (y: Float64, x: Float64) Float64 {
    return atan2(y, x)
}

pub fx power: (v: Float64) Float64 {
    return exp(v)
}

fx shown: (v: Float64) Str {
    return "${v}"
}

pub fx main: () Int32 {
    return checks(0.0)
}

// Infinity and NaN from a zero no compiler sees, as MSVC refuses a constant 0.0 / 0.0.
fx checks: (zero: Float64) Int32 {
    t: Suite = Suite { title = "mathplus - kira:math hypot, atan2, exp and floorMod" }
    inf: Float64 = 1.0 / zero
    nan: Float64 = zero / zero
    t.checkStr(shown(hypot(3.0, 4.0)), "5", "hypot(3, 4)")
    t.checkStr(shown(hypot(-5.0, 12.0)), "13", "hypot(-5, 12)")
    t.checkStr(shown(hypot(0.0, -0.0)), "0", "hypot of zeros")
    t.checkStr(shown(hypot(inf, nan)) + " " + shown(hypot(nan, 1.0)), "inf nan", "an infinity wins over a NaN, a NaN over a number")
    t.check(hypot(1.0e308, 1.0e308) > 1.4e308 && hypot(1.0e308, 1.0e308) < inf, "hypot past the largest double's square is no overflow")
    t.checkStr(shown(atan2(0.0, -1.0)) + " " + shown(atan2(-0.0, -1.0)), "3.141592653589793 -3.141592653589793", "atan2 takes y first and its sign")
    t.checkStr(shown(atan2(1.0, 0.0)) + " " + shown(atan2(1.0, 1.0)), "1.5707963267948966 0.7853981633974483", "a quarter and an eighth turn")
    t.checkStr(shown(atan2(-0.0, 0.0)) + " " + shown(atan2(0.0, -0.0)), "-0 3.141592653589793", "and the zeros' signs")
    t.checkStr(shown(atan2(inf, inf)) + " " + shown(atan2(-inf, -inf)), "0.7853981633974483 -2.356194490192345", "and the infinities")
    t.checkStr(shown(exp(0.0)) + " " + shown(exp(-0.0)), "1 1", "exp of zeros")
    t.checkStr(shown(exp(1000.0)) + " " + shown(exp(inf)), "inf inf", "exp past the largest double is inf")
    t.checkStr(shown(exp(-1000.0)) + " " + shown(exp(-inf)) + " " + shown(exp(nan)), "0 0 nan", "and below the least is 0")
    t.checkStr(shown(floorMod(5.0, 3.0)) + " " + shown(floorMod(-5.0, 3.0)), "2 1", "floorMod takes the divisor's sign")
    t.checkStr(shown(floorMod(5.0, -3.0)) + " " + shown(floorMod(-5.0, -3.0)), "-1 -2", "a negative divisor's too")
    t.checkStr(shown(floorMod(5.5, 2.0)) + " " + shown(floorMod(-7.25, 0.5)), "1.5 0.25", "fractions")
    t.checkStr(shown(floorMod(-0.0, 3.0)) + " " + shown(floorMod(0.0, -3.0)) + " " + shown(floorMod(-0.0, -3.0)), "0 -0 -0", "a zero takes the divisor's sign")
    t.checkStr(shown(floorMod(-1.0e-300, 360.0)), "360", "a tiny negative angle rounds to the divisor, as Python's does")
    t.checkStr(shown(floorMod(-720.5, 360.0)) + " " + shown(floorMod(1.0e300, 3.0)), "359.5 0", "turns, and a large one exactly")
    t.checkStr(shown(floorMod(5.0, inf)) + " " + shown(floorMod(-5.0, inf)), "5 inf", "an infinite divisor")
    t.checkStr(shown(floorMod(5.0, -inf)) + " " + shown(floorMod(-5.0, -inf)), "-inf -5", "a negative one")
    t.checkStr(shown(floorMod(-0.0, inf)) + " " + shown(floorMod(0.0, -inf)), "0 -0", "and zeros over infinities")
    t.checkStr(shown(floorMod(inf, 3.0)) + " " + shown(floorMod(nan, 3.0)) + " " + shown(floorMod(3.0, nan)), "nan nan nan", "an infinite dividend or a NaN is a NaN")
    t.checkStr(shown(floorMod(5.0, 0.0)) + " " + shown(floorMod(5.0, -0.0)), "nan nan", "and a zero divisor, where Python raises")
    return t.finish()
}

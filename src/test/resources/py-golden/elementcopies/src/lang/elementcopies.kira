Pt: Mutable<Any> {
    pub x: Mutable<Int32> { 0 }
    pub tags: List<Int32> { }
}

Holder: Mutable<Any> {
    pub at: Mutable<Pt> { }
}

World: Mutable<Any> {
    pub pts: Mutable<List<Pt>> { }

    pub above: (n: Int32) Pt {
        result: Mutable<Maybe<Pt>> { null }
        found: Mutable<Bool> { false }
        pIndex: Mutable<Size> { 0 }
        while pIndex < pts.size() {
            p: Pt { pts.get(pIndex) }
            if p.x > n {
                result = p
                found = true
                break
            }
            pIndex += 1
        }
        found ? result.value : Pt { }
    }

    pub sum: () Int32 {
        t: Mutable<Int32> { 0 }
        pIndex: Mutable<Size> { 0 }
        while pIndex < pts.size() {
            p: Pt { pts.get(pIndex) }
            t += p.x
            pIndex += 1
        }
        t
    }
}

GRID: List<List<Int32>> { @listOf(@listOf(1, 2), @listOf(3)) }

first: (xs: List<Pt>) Pt {
    result: Mutable<Maybe<Pt>> { null }
    found: Mutable<Bool> { false }
    pIndex: Mutable<Size> { 0 }
    while pIndex < xs.size() {
        p: Pt { xs.get(pIndex) }
        result = p
        found = true
        break
    }
    found ? result.value : Pt { }
}

firstOf: (v: View<Pt>) Pt {
    result: Mutable<Maybe<Pt>> { null }
    found: Mutable<Bool> { false }
    pIndex: Mutable<Size> { 0 }
    while pIndex < v.size() {
        p: Pt { v.get(pIndex) }
        result = p
        found = true
        break
    }
    found ? result.value : Pt { }
}

pick: (xs: List<Pt>, want: Int32) Pt {
    result: Mutable<Maybe<Pt>> { null }
    found: Mutable<Bool> { false }
    pIndex: Mutable<Size> { 0 }
    while pIndex < xs.size() {
        p: Pt { xs.get(pIndex) }
        if p.x == want {
            result = want > 0 ? p : Pt { }
            found = true
            break
        }
        pIndex += 1
    }
    found ? result.value : Pt { }
}

firstRow: (g: List<List<Int32>>) List<Int32> {
    result: Mutable<List<Int32>> { }
    found: Mutable<Bool> { false }
    rIndex: Mutable<Size> { 0 }
    while rIndex < g.size() {
        r: List<Int32> { g.get(rIndex) }
        result = r
        found = true
        break
    }
    found ? result : List<Int32> { }
}

gridRow: () List<Int32> {
    result: Mutable<List<Int32>> { }
    found: Mutable<Bool> { false }
    rIndex: Mutable<Size> { 0 }
    while rIndex < GRID.size() {
        r: List<Int32> { GRID.get(rIndex) }
        result = r
        found = true
        break
    }
    found ? result : List<Int32> { }
}

main: () Void {
    pts: Mutable<List<Pt>> { }
    pts.add(Pt { 1 })
    pts.add(Pt { 2 })
    q: Mutable<Pt> { first(pts) }
    q.x = 99
    v: Mutable<Pt> { firstOf(pts) }
    v.x = 98
    s: Mutable<Pt> { pick(pts, 2) }
    s.x = 50
    trace("${pts[0].x} ${pts[1].x}")

    g: Mutable<List<List<Int32>>> { }
    g.add(@listOf(1, 2))
    r: Mutable<List<Int32>> { firstRow(g) }
    r.add(3)
    c: Mutable<List<Int32>> { gridRow() }
    c.add(9)
    trace("${g[0].size()} ${GRID[0].size()} ${gridRow().size()}")

    h: Mutable<Holder> { }
    h.at = first(pts)
    h.at.tags.add(5)
    h.at.x = 7
    trace("${pts[0].x} ${pts[0].tags.size()} ${h.at.x} ${h.at.tags.size()}")

    w: Mutable<World> { }
    w.pts = pts
    a: Mutable<Pt> { w.above(1) }
    a.x = 40
    a.tags.add(6)
    trace("${w.pts[1].x} ${w.pts[1].tags.size()} ${a.x} ${w.sum()}")
}

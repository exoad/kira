module "app:signals"

// kira:os onSignal (D78), which driver.py runs once per case: Ctrl-C sets a flag the loop polls,
// so the program sends its ESTOP and ends as it chooses. raiseInt is Ctrl-C to this process.

use "kira:os"
use "kira:sync"
use "kira:time"

@_extern
fx raiseInt: () Void

pub fx main: () Int32 {
    a: List<Str> = args()
    how: Str = if a.size() > 1 { a[1] } else { "flag" }
    stop: Atomic<Bool> = Atomic<Bool> { value = false }
    if how == "flag" {
        onInt: Bool = onSignal(SIGNAL_INT, stop)
        onTerm: Bool = onSignal(SIGNAL_TERM, stop)
        println("installed ${onInt} ${onTerm}")
        mut ticks: Int32 = 0
        while !stop.load() && ticks < 500 {
            ticks += 1
            if ticks == 3 {
                raiseInt()
            }
            sleepMs(10)
        }
        println("ESTOP after ${ticks} ticks")
    } else if how == "thread" {
        spawn("installer", fx() Void {
            println("from a thread: ${onSignal(SIGNAL_INT, stop)}")
        }).join()
    } else if how == "unhandled" {
        raiseInt()
        sleepMs(100)
        println("never")
    }
    println("${how} done")
    return 0
}

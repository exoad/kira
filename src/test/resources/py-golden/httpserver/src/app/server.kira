kira.http as http
kira.os as os
kira.sync as sync
kira.test as test
kira.time as time

// kira:http's server (K7): route and admit answer as the driver's BaseHTTPRequestHandler does, byte for byte, and a
// throw, panic or exit in a handler ends the process (D76); main serves itself through kira:http's client.

withHeader: (name: Str, value: Str) HttpAnswer {
    h: Mutable<Map<Str, Str>> = Map<Str, Str> { }
    h.put(name, value)
    HttpAnswer { status = 200, headers = h }
}

pub route: (r: HttpRequest) HttpAnswer {
    if r.path == "/text" {
        HttpAnswer { status = 200, contentType = "text/plain; charset=utf-8", body = "hello".bytes() }
    } else if r.path == "/json" {
        h: Mutable<Map<Str, Str>> = Map<Str, Str> { }
        h.put("Cache-Control", "no-store")
        h.put("Location", "/text")
        HttpAnswer { status = 200, body = "{\"ok\": true}".bytes(), headers = h }
    } else if r.path == "/missing" {
        HttpAnswer { status = 404 }
    } else if r.path == "/refused" {
        HttpAnswer { status = 409, body = "{\"ok\": false}".bytes() }
    } else if r.path == "/drop" {
        HttpAnswer { status = 0 }
    } else if r.path == "/slow" {
        sleepMs(800)
        HttpAnswer { status = 200, contentType = "text/plain", body = "slow".bytes() }
    } else {
        if r.path == "/throw" {
            throw "from the handler"
        }
        if r.path == "/panic" {
            assert(false, "a handler's panic")
        }
        if r.path == "/exit" {
            exit(9)
        }
        r.path == "/s100" ? HttpAnswer { status = 100, contentType = "text/plain", body = "low".bytes() }
            : r.path == "/s999" ? HttpAnswer { status = 999, contentType = "text/plain", body = "high".bytes() }
            : r.path == "/latin" ? withHeader("X-Name", "café")
            // Each a program error, which ends the process.
            : r.path == "/length" ? withHeader("content-length", "1")
            : r.path == "/ctype" ? withHeader("Content-Type", "text/html")
            : r.path == "/break" ? withHeader("X-Note", "one\r\nX-Injected: two")
            : r.path == "/lf" ? withHeader("X-Note", "one\ntwo")
            : r.path == "/ctypebreak" ? HttpAnswer { status = 200, contentType = "text/plain\r\nX-Injected: 1" }
            : r.path == "/notlatin" ? withHeader("X-Price", "5 €")
            : r.path == "/s1000" ? HttpAnswer { status = 1000, body = "x".bytes() }
            : r.path == "/s99" ? HttpAnswer { status = 99, body = "x".bytes() }
            : HttpAnswer { status = 200, contentType = "text/plain", body = "${r.method} ${r.path} '${r.host}' ${r.body.size()}: ${Str.of(r.body)}".bytes() }
    }
}

// A body of at most 64 bytes is read, any for /open; any other length is refused unread, the length it saw in the body.
pub admit: (path: Str, n: Int64) HttpAnswer {
    if path != "/open" && (n < 0 || n > 64) {
        code: Int32 = n < 0 ? 400 : 413
        HttpAnswer { status = code, contentType = "text/plain", body = "length ${n}".bytes() }
    } else {
        HttpAnswer { status = 0 }
    }
}

pub bind: (host: Str, port: Int32, post: Bool) Maybe<HttpServer> {
    post ? httpServerWithPost(host, port, route, admit)
        : httpServer(host, port, route)
}

pub serveOn: (s: HttpServer) Bool {
    s.serve()
}

pub stop: (s: HttpServer) Void {
    s.shutdown()
}

pub why: () Str {
    httpError()
}

// serve on the main thread, which an onSignal handler ends as it ends kira:os's waits (D78): the driver's SIGINT 300 ms
// in; the port is free after.
pub serveOnSignal: () Str {
    flag: Atomic<Bool> = Atomic<Bool> { value = false }
    installed: Bool = onSignal(SIGNAL_INT, flag)
    s: HttpServer = httpServer("127.0.0.1", 0, route).value
    before: Int64 = monoNowMs()
    served: Bool = s.serve()
    took: Int64 = monoNowMs() - before
    reason: Str = httpError()
    again: Maybe<HttpServer> = httpServer("127.0.0.1", s.port(), route)
    freed: Bool = again.isSome()
    if freed {
        again.value.shutdown()
    }
    "installed ${installed}: serve ${served}, the flag ${flag.load()}, early ${took < 5000}, freed ${freed}: ${reason}"
}

bodyOf: (r: Maybe<HttpReply>) Str {
    r.isNone() ? "none: " + httpError()
        : "${r.value.status} ${Str.of(r.value.body)}"
}

pub main: () Int32 {
    t: Suite = Suite { title = "httpserver - kira:http's server on py" }
    s: HttpServer = httpServerWithPost("127.0.0.1", 0, route, admit).value
    port: Int32 = s.port()
    t.check(port > 0, "port 0 binds a free port, which port() says")
    t.check(httpServer("127.0.0.1", port, route).isNone() && httpError() != "", "a second server on it is none, httpError saying why")
    third: Maybe<HttpServer> = httpServer("127.0.0.1", 0, route)
    t.check(third.isSome() && httpError() == "", "a bind that works clears the reason")
    third.value.shutdown()
    served: Atomic<Bool> = Atomic<Bool> { value = false }
    th: Thread = spawn("serve", () Void {
        served.store(s.serve())
    })
    url: Str = "http://127.0.0.1:${port}"
    t.checkStr(bodyOf(httpGet(url + "/text", 5000)), "200 hello", "kira:http's client reads its server's 200")
    t.checkStr(bodyOf(httpGet(url + "/refused", 5000)), "409 {\"ok\": false}", "and a 409 with its body")
    t.check(httpGet(url + "/missing", 5000).value.status == 404, "and a 404 without one, Python's error page")
    t.checkStr(bodyOf(httpGet(url + "/drop", 5000)), "none: Remote end closed connection without response", "a status of 0 answers nothing")
    t.checkStr(bodyOf(httpPost(url + "/echo", "hi".bytes(), "text/plain", 5000)), "200 POST /echo '127.0.0.1:${port}' 2: hi", "a POST's body reaches the handler")
    one: List<UInt8> = @listOf(65)
    t.checkStr(bodyOf(httpPost(url + "/echo", one, "text/plain", 5000)), "200 POST /echo '127.0.0.1:${port}' 1: A", "one byte too")
    t.check(!s.serve() && httpError() == "the server is serving", "a second serve while it serves is false")
    s.shutdown()
    th.join()
    t.check(served.load(), "shutdown ends serve, which is true")
    after: Maybe<HttpServer> = httpServer("127.0.0.1", port, route)
    t.check(after.isSome(), "and frees its port")
    after.value.shutdown()
    t.check(s.serve() && httpError() == "", "a serve after it returns true at once")
    idle: HttpServer = httpServer("127.0.0.1", 0, route).value
    idle.shutdown()
    t.check(idle.serve(), "and so does one after a shutdown before any serve")
    idle.shutdown()
    again: Maybe<HttpServer> = httpServer("127.0.0.1", idle.port(), route)
    t.check(again.isSome(), "which freed its port at once")
    again.value.shutdown()
    unbound: HttpServer = HttpServer { }
    t.check(!unbound.serve() && httpError() == "the server is unbound" && unbound.port() == -1, "an HttpServer no call bound serves nothing")
    base: HttpAnswer = HttpAnswer { body = "x".bytes() }
    answer: Mutable<HttpAnswer> = base
    answer.body.add(33)
    answer.headers.put("A", "b")
    request: HttpRequest = HttpRequest { body = "a".bytes() }
    other: Mutable<HttpRequest> = request
    other.body.add(98)
    reply: HttpReply = HttpReply { status = 1, body = "r".bytes() }
    copied: Mutable<HttpReply> = reply
    copied.body.add(115)
    t.check(base.body.size() == 1 && base.headers.size() == 0 && request.body.size() == 1 && reply.body.size() == 1, "each struct is a value, its List and Map copied with it")
    same: HttpReply = HttpReply { status = 1, body = "r".bytes() }
    t.check(same == reply && copied != reply && other != request && answer.body.size() == 2, "and compared field by field")
    t.finish()
}

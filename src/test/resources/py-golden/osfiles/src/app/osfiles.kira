kira.os as os
kira.test as test

// kira:os's py-only files (K4): tempDir, removeTree, setModifiedS, glob, walkFiles, which, pythonExecutable and
// moduleDir, with lastError's category and readText's strict UTF-8.

slashed: (paths: List<Str>, root: Str) Str {
    mut out: List<Str> = @listOf()
    for p: Str in paths {
        out.add(p.replace("\\", "/").replace(root.replace("\\", "/") + "/", ""))
    }
    out.joinToString(",")
}

// The kind the last kira:os call on this thread left, whichever module made it (D86).
pub kind: () Str {
    lastErrorKind()
}

pub reason: () Str {
    lastError()
}

// moduleDir for the driver, which loads this module through a linked directory and with no file.
pub here: () Str {
    moduleDir()
}

pub main: () Int32 {
    t: Suite = Suite { title = "osfiles - kira:os on py" }
    made: Maybe<Str> = tempDir("kira-osfiles-")
    t.check(made.isSome() && isDir(made.value), "tempDir makes a directory")
    if made.isNone() {
        t.finish()
    } else {
        root: Str = made.value
        t.check(root.contains("kira-osfiles-"), "named from its prefix")
        t.check(makeDirs(root + "/a/b") && writeFile(root + "/a/b/x.txt", "x".bytes()) && writeFile(root + "/a/y.txt", "y".bytes()), "a small tree")
        t.check(writeFile(root + "/z.md", "z".bytes()) && writeFile(root + "/.hidden.md", "h".bytes()), "with a hidden file")
        t.checkStr(slashed(walkFiles(root), root), ".hidden.md,a/b/x.txt,a/y.txt,z.md", "walkFiles finds every file, sorted")
        t.checkStr(slashed(glob(root + "/*.md"), root), "z.md", "glob matches by pattern, a leading dot only by name")
        t.checkStr(slashed(glob(root + "/a/*"), root), "a/b,a/y.txt", "and lists a directory's entries, sorted")
        t.check(glob(root + "/nothing*").isEmpty() && walkFiles(root + "/nope").isEmpty(), "and both are empty where nothing is")
        t.check(setModifiedS(root + "/z.md", 1000000000.0) && modifiedS(root + "/z.md").value == 1000000000.0, "setModifiedS sets what modifiedS reads")
        t.check(!setModifiedS(root + "/nope", 1.0) && lastErrorKind() == "NotFound", "and is NotFound for a missing file")
        t.check(readText(root + "/nope").isNone() && lastError().startsWith("OSError: [Errno 2] "), "lastError names OSError for its FileNotFoundError")
        bad: List<UInt8> = @listOf(255, 10)
        t.check(writeFile(root + "/bad.txt", bad) && readText(root + "/bad.txt").isNone(), "readText of bytes that are not UTF-8 is none")
        t.check(lastError().startsWith("ValueError: 'utf-8' codec can't decode byte 0xff") && lastErrorKind() == "Other", "with ValueError's reason, kind Other")
        t.check(readFile(root + "/bad.txt").value.size() == 2, "while readFile reads them")
        t.check(which("kira-no-such-program-xyz").isNone() && lastErrorKind() == "", "which finds no missing program, and that is no error")
        t.check(isFile(pythonExecutable()), "pythonExecutable is the interpreter's file")
        t.check(isFile(moduleDir() + "/osfiles_kira.py"), "moduleDir holds this module's own file")
        t.check(removeTree(root) && !exists(root), "removeTree removes the tree")
        t.check(!removeTree(root) && lastErrorKind() == "NotFound", "and a second time is NotFound")
        t.finish()
    }
}

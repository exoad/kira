kira.math as math

// The shifts, the bitwise compound assignments and kira:math's functions, where Python's own
// differ from Kira's: `<<` wraps into its type, signed ones included; `>>` is arithmetic on a
// negative value; `>>>` shifts a signed value's bits as its unsigned counterpart's; a count is
// any integer type, a constant one bare and any other checked (a count outside 0 until the
// width stops the program, which the shiftcount golden holds); sqrt, pow, floor, ceil, round,
// sin, cos, tan and abs are C's, a Float64 for every argument, NaN or an infinity where Python
// raises, and round takes a half away from zero. The expected output is the C++ backend's run
// of this same module, built with zig c++ (musl) and with MSVC, which agree; MinGW-w64's C
// library differs from C's round, taking 0.49999999999999994 to 1.

// A Float64 as trace prints it, every NaN as nan: a NaN's sign is the machine's (x86's default
// NaN is negative, which C++ prints as -nan), not Kira's.
show: (v: Float64) Void {
    if v != v {
        trace("nan")
    } else {
        trace(v)
    }
}

ratio: (a: Float64, b: Float64) Float64 {
    a / b
}

lessOne: (v: Size) Size {
    v - 1
}

lessOneU64: (v: UInt64) UInt64 {
    v - 1
}

shlI8: (v: Int8, n: Int32) Int8 {
    v << n
}

shrI8: (v: Int8, n: Int32) Int8 {
    v >> n
}

ushrI8: (v: Int8, n: Int32) Int8 {
    v >>> n
}

constantsI8: (v: Int8) Str {
    "${v << 0} ${v << 1} ${v << 7} ${v >> 0} ${v >> 1} ${v >> 7} ${v >>> 0} ${v >>> 1} ${v >>> 7}"
}

compoundI8: (v: Int8, n: Int32) Str {
    a: Mutable<Int8> = v
    a &= 0x3C
    b: Mutable<Int8> = v
    b |= 0x3C
    c: Mutable<Int8> = v
    c ^= 0x3C
    d: Mutable<Int8> = v
    d <<= n
    e: Mutable<Int8> = v
    e >>= n
    g: Mutable<Int8> = v
    g >>>= n
    h: Mutable<Int8> = v
    h <<= 7
    k: Mutable<Int8> = v
    k >>>= 1
    "${a} ${b} ${c} ${d} ${e} ${g} ${h} ${k}"
}

lineI8: (v: Int8) Void {
    l: Mutable<Str> = "Int8 ${v} <<"
    r: Mutable<Str> = "Int8 ${v} >>"
    u: Mutable<Str> = "Int8 ${v} >>>"
    n: Mutable<Int32> = 0
    while n < 8 {
        l += " ${shlI8(v, n)}"
        r += " ${shrI8(v, n)}"
        u += " ${ushrI8(v, n)}"
        n += 1
    }
    trace(l)
    trace(r)
    trace(u)
    trace(constantsI8(v))
    trace(compoundI8(v, 0))
    trace(compoundI8(v, 1))
    trace(compoundI8(v, 7))
}


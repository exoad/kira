shlSize: (v: Size, n: Int32) Size {
    return v << n
}

shrSize: (v: Size, n: Int32) Size {
    return v >> n
}

ushrSize: (v: Size, n: Int32) Size {
    return v >>> n
}

constantsSize: (v: Size) Str {
    return "${v << 0} ${v << 1} ${v << 31} ${v << 32} ${v << 63} ${v >> 0} ${v >> 1} ${v >> 31} ${v >> 32} ${v >> 63} ${v >>> 0} ${v >>> 1} ${v >>> 31} ${v >>> 32} ${v >>> 63}"
}

compoundSize: (v: Size, n: Int32) Str {
    mut a: Size = v
    a &= 0x3C
    mut b: Size = v
    b |= 0x3C
    mut c: Size = v
    c ^= 0x3C
    mut d: Size = v
    d <<= n
    mut e: Size = v
    e >>= n
    mut g: Size = v
    g >>>= n
    mut h: Size = v
    h <<= 63
    mut k: Size = v
    k >>>= 1
    return "${a} ${b} ${c} ${d} ${e} ${g} ${h} ${k}"
}

lineSize: (v: Size) Void {
    mut l: Str = "Size ${v} <<"
    mut r: Str = "Size ${v} >>"
    mut u: Str = "Size ${v} >>>"
    mut n: Int32 = 0
    while n < 64 {
        l += " ${shlSize(v, n)}"
        r += " ${shrSize(v, n)}"
        u += " ${ushrSize(v, n)}"
        n += 1
    }
    trace(l)
    trace(r)
    trace(u)
    trace(constantsSize(v))
    trace(compoundSize(v, 0))
    trace(compoundSize(v, 1))
    trace(compoundSize(v, 63))
}

shlByU8: (v: UInt32, n: UInt8) UInt32 {
    return v << n
}

shrBySize: (v: Int64, n: Size) Int64 {
    return v >> n
}

ushrBy64: (v: Int16, n: Int64) Int16 {
    return v >>> n
}

bit64: (n: Int32) Int64 {
    return 1 << n
}

byte: (n: Int32) UInt8 {
    return 1 << n
}

mixed: (a: UInt16, b: UInt16, n: Int32) UInt16 {
    return (a << n | b >> n) ^ (a & b) << 2
}

Flags: Any {
    pub mut bits: UInt8 = 0

    pub mut set: (n: Int32) Void {
        bits |= 1 << n
    }

    pub mut clear: (n: Int32) Void {
        bits &= ~(1 << n)
    }

    pub mut flip: (n: Int32) Void {
        bits ^= 1 << n
    }
}

at: (i: Size) Size {
    trace("at ${i}")
    return i
}

given: (v: Int32) Int32 {
    trace("value ${v}")
    return v
}

indexed: () Void {
    mut xs: List<Int32> = List<Int32> { }
    xs.add(0x0F)
    xs.add(-16)
    xs.add(0x70000000)
    xs[at(0)] |= given(0xF0)
    xs[at(0)] &= given(0x3C)
    xs[at(0)] ^= given(-1)
    xs[at(1)] >>= given(2)
    xs[at(1)] >>>= given(28)
    xs[at(2)] <<= given(1)
    xs[2] <<= 1
    xs[at(2)] >>>= 31
    trace(xs[0])
    trace(xs[1])
    trace(xs[2])
}

counts: () Void {
    trace(shlByU8(1, 31))
    trace(shlByU8(0xFFFFFFFF, 4))
    trace(shrBySize(-9223372036854775807 - 1, 63))
    trace(shrBySize(-5, 1))
    trace(ushrBy64(-1, 15))
    trace(ushrBy64(-32768, 0))
    trace(bit64(0))
    trace(bit64(62))
    trace(bit64(63))
    trace(byte(7))
    trace(mixed(0xF00F, 0x0FF0, 4))
    trace(mixed(0xFFFF, 0xFFFF, 15))
    mut f: Flags = Flags { }
    f.set(0)
    f.set(7)
    f.set(3)
    trace(f.bits)
    f.clear(0)
    f.flip(7)
    f.flip(1)
    trace(f.bits)
}

rounding: (v: Float64) Void {
    trace("of")
    show(v)
    show(floor(v))
    show(ceil(v))
    show(round(v))
    show(floor(v) - v)
    show(round(v) - v)
}

root: (v: Float64) Void {
    show(sqrt(v))
    show(abs(v))
}

trig: (v: Float64) Void {
    show(sin(v))
    show(cos(v))
    show(tan(v))
}

power: (a: Float64, b: Float64) Void {
    show(pow(a, b))
}

maths: () Void {
    inf: Float64 = ratio(1.0, 0.0)
    nan: Float64 = ratio(0.0, 0.0)
    mut vs: List<Float64> = List<Float64> { }
    vs.add(0.0)
    vs.add(-0.0)
    vs.add(0.5)
    vs.add(-0.5)
    vs.add(1.5)
    vs.add(-1.5)
    vs.add(2.5)
    vs.add(-2.5)
    vs.add(0.4)
    vs.add(-0.4)
    vs.add(0.49999999999999994)
    vs.add(-0.49999999999999994)
    vs.add(1.0)
    vs.add(-1.0)
    vs.add(2.0)
    vs.add(4503599627370497.0)
    vs.add(-4503599627370497.0)
    vs.add(1e300)
    vs.add(-1e300)
    vs.add(inf)
    vs.add(-inf)
    vs.add(nan)
    mut i: Size = 0
    while i < vs.size() {
        rounding(vs[i])
        root(vs[i])
        i += 1
    }
    trace("trig")
    trig(0.0)
    trig(-0.0)
    trig(0.5)
    trig(-1.0)
    trig(2.0)
    trig(inf)
    trig(-inf)
    trig(nan)
    trace("pow")
    power(2.0, 10.0)
    power(2.0, 0.5)
    power(-2.0, 3.0)
    power(-2.0, 2.0)
    power(-8.0, 1.0 / 3.0)
    power(-1.5, 0.5)
    power(0.0, -1.0)
    power(-0.0, -1.0)
    power(-0.0, -2.0)
    power(0.0, -1.5)
    power(-0.0, -1.5)
    power(-0.0, 3.0)
    power(-0.0, 0.5)
    power(0.0, 0.0)
    power(10.0, 309.0)
    power(-10.0, 309.0)
    power(-10.0, 310.0)
    power(10.0, -400.0)
    power(-10.0, -401.0)
    power(nan, 0.0)
    power(nan, 1.0)
    power(1.0, nan)
    power(-1.0, inf)
    power(-1.0, -inf)
    power(inf, -1.0)
    power(-inf, -1.0)
    power(-inf, -2.0)
    power(-inf, 3.0)
    power(-inf, 2.0)
    power(inf, 0.5)
    power(0.5, -inf)
    power(0.5, inf)
    power(2.0, -inf)
    power(2.0, inf)
    power(-0.0, -inf)
    power(0.0, -inf)
    power(0.0, inf)
    power(-2.0, 1e300)
    power(-2.0, 1024.0)
    power(-2.0, 1025.0)
    power(-2.0, -1080.0)
    power(-2.0, -1081.0)
}

main: () Void {
    topSize: Size = lessOne(0)
    highSize: Size = topSize - 0x5A5A5A5A
    topU64: UInt64 = lessOneU64(0)
    lineI8(0)
    lineI8(1)
    lineI8(-1)
    lineI8(-128)
    lineI8(127)
    lineI8(0x5A)
    lineI16(0)
    lineI16(1)
    lineI16(-1)
    lineI16(-32768)
    lineI16(32767)
    lineI16(0x5A5A)
    lineI32(0)
    lineI32(1)
    lineI32(-1)
    lineI32(-2147483647 - 1)
    lineI32(2147483647)
    lineI32(0x5A5A5A5A)
    lineI64(0)
    lineI64(1)
    lineI64(-1)
    lineI64(-9223372036854775807 - 1)
    lineI64(9223372036854775807)
    lineI64(0x5A5A5A5A5A5A5A5A)
    lineU8(0)
    lineU8(1)
    lineU8(255)
    lineU8(128)
    lineU8(127)
    lineU8(0xA5)
    lineU16(0)
    lineU16(1)
    lineU16(65535)
    lineU16(32768)
    lineU16(32767)
    lineU16(0xA5A5)
    lineU32(0)
    lineU32(1)
    lineU32(4294967295)
    lineU32(2147483648)
    lineU32(2147483647)
    lineU32(0xA5A5A5A5)
    lineU64(0)

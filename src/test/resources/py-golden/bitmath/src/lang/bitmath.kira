shlByU8: (v: UInt32, n: UInt8) UInt32 {
    v << n
}

shrBySize: (v: Int64, n: Size) Int64 {
    v >> n
}

ushrBy64: (v: Int16, n: Int64) Int16 {
    v >>> n
}

bit64: (n: Int32) Int64 {
    1 << n
}

byte: (n: Int32) UInt8 {
    1 << n
}

mixed: (a: UInt16, b: UInt16, n: Int32) UInt16 {
    (a << n | b >> n) ^ (a & b) << 2
}

Flags: Mutable<Any> {
    pub bits: Mutable<UInt8> = 0

    pub set: (n: Int32) Void {
        bits |= 1 << n
    }

    pub clear: (n: Int32) Void {
        bits &= ~(1 << n)
    }

    pub flip: (n: Int32) Void {
        bits ^= 1 << n
    }
}

at: (i: Size) Size {
    trace("at ${i}")
    i
}

given: (v: Int32) Int32 {
    trace("value ${v}")
    v
}

indexed: () Void {
    xs: Mutable<List<Int32>> = List<Int32> { }
    xs.add(0x0F)
    xs.add(-16)
    xs.add(0x70000000)
    xs[at(0)] |= given(0xF0)
    xs[at(0)] &= given(0x3C)
    xs[at(0)] ^= given(-1)
    xs[at(1)] >>= given(2)
    xs[at(1)] >>>= given(28)
    xs[at(2)] <<= given(1)
    xs[2] <<= 1
    xs[at(2)] >>>= 31
    trace(xs[0])
    trace(xs[1])
    trace(xs[2])
}

counts: () Void {
    trace(shlByU8(1, 31))
    trace(shlByU8(0xFFFFFFFF, 4))
    trace(shrBySize(-9223372036854775807 - 1, 63))
    trace(shrBySize(-5, 1))
    trace(ushrBy64(-1, 15))
    trace(ushrBy64(-32768, 0))
    trace(bit64(0))
    trace(bit64(62))
    trace(bit64(63))
    trace(byte(7))
    trace(mixed(0xF00F, 0x0FF0, 4))
    trace(mixed(0xFFFF, 0xFFFF, 15))
    f: Mutable<Flags> = Flags { }
    f.set(0)
    f.set(7)
    f.set(3)
    trace(f.bits)
    f.clear(0)
    f.flip(7)
    f.flip(1)
    trace(f.bits)
}

rounding: (v: Float64) Void {
    trace("of")
    show(v)
    show(floor(v))
    show(ceil(v))
    show(round(v))
    show(floor(v) - v)
    show(round(v) - v)
}

root: (v: Float64) Void {
    show(sqrt(v))
    show(abs(v))
}

trig: (v: Float64) Void {
    show(sin(v))
    show(cos(v))
    show(tan(v))
}

power: (a: Float64, b: Float64) Void {
    show(pow(a, b))
}

maths: () Void {
    inf: Float64 = ratio(1.0, 0.0)
    nan: Float64 = ratio(0.0, 0.0)
    vs: Mutable<List<Float64>> = List<Float64> { }
    vs.add(0.0)
    vs.add(-0.0)
    vs.add(0.5)
    vs.add(-0.5)
    vs.add(1.5)
    vs.add(-1.5)
    vs.add(2.5)
    vs.add(-2.5)
    vs.add(0.4)
    vs.add(-0.4)
    vs.add(0.49999999999999994)
    vs.add(-0.49999999999999994)
    vs.add(1.0)
    vs.add(-1.0)
    vs.add(2.0)
    vs.add(4503599627370497.0)
    vs.add(-4503599627370497.0)
    vs.add(1e300)
    vs.add(-1e300)
    vs.add(inf)
    vs.add(-inf)
    vs.add(nan)
    i: Mutable<Size> = 0
    while i < vs.size() {
        rounding(vs[i])
        root(vs[i])
        i += 1
    }
    trace("trig")
    trig(0.0)
    trig(-0.0)
    trig(0.5)
    trig(-1.0)
    trig(2.0)
    trig(inf)
    trig(-inf)
    trig(nan)
    trace("pow")
    power(2.0, 10.0)
    power(2.0, 0.5)
    power(-2.0, 3.0)
    power(-2.0, 2.0)
    power(-8.0, 1.0 / 3.0)
    power(-1.5, 0.5)
    power(0.0, -1.0)
    power(-0.0, -1.0)
    power(-0.0, -2.0)
    power(0.0, -1.5)
    power(-0.0, -1.5)
    power(-0.0, 3.0)
    power(-0.0, 0.5)
    power(0.0, 0.0)
    power(10.0, 309.0)
    power(-10.0, 309.0)
    power(-10.0, 310.0)
    power(10.0, -400.0)
    power(-10.0, -401.0)
    power(nan, 0.0)
    power(nan, 1.0)
    power(1.0, nan)
    power(-1.0, inf)
    power(-1.0, -inf)
    power(inf, -1.0)
    power(-inf, -1.0)
    power(-inf, -2.0)
    power(-inf, 3.0)
    power(-inf, 2.0)
    power(inf, 0.5)
    power(0.5, -inf)
    power(0.5, inf)
    power(2.0, -inf)
    power(2.0, inf)
    power(-0.0, -inf)
    power(0.0, -inf)
    power(0.0, inf)
    power(-2.0, 1e300)
    power(-2.0, 1024.0)
    power(-2.0, 1025.0)
    power(-2.0, -1080.0)
    power(-2.0, -1081.0)
}

main: () Void {
    topSize: Size = lessOne(0)
    highSize: Size = topSize - 0x5A5A5A5A
    topU64: UInt64 = lessOneU64(0)
    lineI8(0)
    lineI8(1)
    lineI8(-1)
    lineI8(-128)
    lineI8(127)
    lineI8(0x5A)
    lineI16(0)
    lineI16(1)
    lineI16(-1)
    lineI16(-32768)
    lineI16(32767)
    lineI16(0x5A5A)
    lineI32(0)
    lineI32(1)
    lineI32(-1)
    lineI32(-2147483647 - 1)
    lineI32(2147483647)
    lineI32(0x5A5A5A5A)
    lineI64(0)
    lineI64(1)

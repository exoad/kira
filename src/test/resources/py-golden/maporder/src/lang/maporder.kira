// A Map's order (D27), its methods and m[k] = v; expected.txt is the C++ backend's run.

ticks: Mutable<Int32> = 0
keyAt: Mutable<Int32> = 0
seen: Mutable<Map<Str, Int32>> = Map<Str, Int32> { }

next: () Int32 {
    ticks += 1
    ticks
}

nextKey: () Str {
    keyAt += 1
    "k${keyAt}"
}

keysOf: (m: Map<Str, Int32>) Str {
    ks: Arr<Str> = m.keys()
    s: Mutable<Str> = ""
    i: Mutable<Size> = 0
    while i < ks.size() {
        if i > 0 {
            s = s + " "
        }
        s = s + "${ks[i]}=${m.get(ks[i]).unwrapOr(-1)}"
        i += 1
    }
    "{" + s + "}"
}

valuesOf: (m: Map<Str, Int32>) Str {
    vs: Arr<Int32> = m.valuesArr()
    s: Mutable<Str> = ""
    i: Mutable<Size> = 0
    while i < vs.size() {
        s = s + " ${vs[i]}"
        i += 1
    }
    "[" + s + " ]"
}

bytesText: (b: Arr<UInt8>) Str {
    s: Mutable<Str> = ""
    i: Mutable<Size> = 0
    while i < b.size() {
        s = s + " ${b[i]}"
        i += 1
    }
    "bytes${s} (${b.size()})"
}

maybeText: (v: Maybe<Int32>) Str {
    v.isSome() ? "some ${v.value}" : "none"
}

Index: Mutable<Any> {
    pub byName: Mutable<Map<Str, Int32>> = Map<Str, Int32> { }
    pub count: Mutable<Int32> = 0

    pub add: (name: Str) Int32 {
        if !byName.containsKey(name) {
            count += 1
            byName[name] = count
        }
        byName.get(name).value
    }
}

main: () Void {
    m: Mutable<Map<Str, Int32>> = Map<Str, Int32> { }
    trace(m.isEmpty())
    m.put("b", 1)
    m.put("a", 2)
    m["c"] = 3
    trace(keysOf(m))
    m.put("b", 10)
    m["a"] = 20
    trace(keysOf(m))
    trace(valuesOf(m))
    trace(maybeText(m.remove("b")))
    trace(maybeText(m.remove("b")))
    trace(keysOf(m))
    m.put("b", 100)
    trace(keysOf(m))
    trace(maybeText(m.get("a")))
    trace(maybeText(m.get("zz")))
    trace(m.get("zz").unwrapOr(7))
    trace(m.size())
    trace(m.containsKey("c"))
    trace(m.containsKey("C"))
    trace(m.containsValue(100))
    trace(m.containsValue(2))
    trace(m.isEmpty())

    // The key is located before the value runs (D33), which sees the Map without it.
    m["n"] = m.size() as Int32
    trace(keysOf(m))
    m[nextKey()] = next()
    m[nextKey()] = next() + keyAt
    trace(keysOf(m))
    m.clear()
    trace(m.size())
    trace(keysOf(m))
    m["k9"] = 9
    m.put("k1", 1)
    trace(keysOf(m))

    order: Mutable<Map<Int32, Str>> = Map<Int32, Str> { }
    i: Mutable<Int32> = -3
    while i <= 3 {
        order[i * 7] = "v${i}"
        i += 1
    }
    order.remove(0)
    order.remove(-21)
    order[0] = "back"
    order[-7] = "again"
    ks: Arr<Int32> = order.keys()
    line: Mutable<Str> = ""
    j: Mutable<Size> = 0
    while j < ks.size() {
        line = line + " ${ks[j]}:${order.get(ks[j]).value}"
        j += 1
    }
    trace(line)

    flags: Mutable<Map<Bool, Int32>> = Map<Bool, Int32> { }
    flags[true] = 1
    flags[false] = 2
    flags[true] = 3
    trace(flags.get(true).value * 10 + flags.get(false).value)
    trace(flags.size())
    chars: Mutable<Map<Char, Int32>> = Map<Char, Int32> { }
    chars['z'] = 26
    chars['a'] = 1
    cs: Arr<Char> = chars.keys()
    trace("${cs[0]}${cs[1]} ${chars.get('a').value}")
    table: Mutable<Map<UInt8, UInt8>> = Map<UInt8, UInt8> { }
    table[0xFE] = 1
    table[3] = 0x80
    table[0x10] = 255
    table[3] = 7
    trace(bytesText(table.keys()))
    trace(bytesText(table.valuesArr()))
    wide: Mutable<Map<UInt64, Int64>> = Map<UInt64, Int64> { }
    top: Mutable<UInt64> = 0
    top -= 1
    wide[top] = -9223372036854775807
    wide[0] = 1
    trace(wide.get(top).value)
    trace(wide.keys()[0])
    signed: Mutable<Map<Int8, Bool>> = Map<Int8, Bool> { }
    signed[-128] = true
    trace(signed.containsKey(-128))
    trace(signed.containsKey(127))

    // containsValue compares with ==: a NaN is never found.
    f: Mutable<Map<Str, Float64>> = Map<Str, Float64> { }
    nan: Float64 = 0.0 / 0.0
    f["nan"] = nan
    f["zero"] = -0.0
    trace(f.containsValue(nan))
    trace(f.containsValue(0.0))
    trace(f.size())

    ix: Mutable<Index> = Index { }
    trace(ix.add("x"))
    trace(ix.add("y"))
    trace(ix.add("x"))
    trace(ix.byName.size())
    seen["one"] = 1
    seen.put("two", 2)
    seen["one"] = 11
    trace(keysOf(seen))
}

golden.py.importname.app.lib as lib
golden.py.importname.app.lib.bump as bump

// _k_run() returns main's code to a Python caller, and the guard exits with it (D85).

pub viaLib: () Int32 {
    bump()
}

pub main: (args: List<Str>) Int32 {
    println("main ran with ${args.size()} arguments, lib at ${bump()}")
    3
}

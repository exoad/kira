kira.test as test

// ranges: `a..b` is a Range<T> with both ends in it, and `x in r` is a Bool anywhere (lane RANGE,
// owner 2026-11-01). `x in a..b` builds no Range: x runs once, then each end. A loop over a..b holds b,
// written or held in a Range; `a..<b` leaves b out (owner 2026-11-09), and a counter below its end (`while i < n`) does too.
// cpp-golden/ranges holds this file with a Box, a user type answering in, which py refuses.

trail: Mutable<Str> { "" }

seen: (tag: Str, v: Int32) Int32 {
    trail = trail + tag
    v
}

span: (tag: Str, lo: Int32, hi: Int32) Range<Int32> {
    trail = trail + tag
    lo..hi
}

pub main: () Int32 {
    t: Suite { title = "ranges - Range<T> and x in r" }
    t.check(9 in 9..13 && 13 in 9..13 && 10 in 9..13, "both ends are in")
    t.check(!(8 in 9..13) && !(14 in 9..13), "one past either end is not")
    b: UInt8 { 255 }
    t.check(b in 0..255 && !(b in 0..254) && (0 as UInt8) in 0..10, "a UInt8 at its limits")
    f: Float64 { 2.5 }
    t.check(f in 0..2.5 && !(f in 0.0..2.4) && -0.5 in -1..0, "a float range")
    t.check(!(seen("x", 5) in seen("a", 1)..seen("b", 4)), "x is outside")
    t.checkStr(trail, "xab", "x runs first, then each end once")
    trail = ""
    t.check(seen("y", 3) in span("r", 1, 3), "a Range from a call holds its end")
    t.checkStr(trail, "yr", "x runs before the range")
    r: Range<Int32> { 1..4 }
    t.check(r.begin == 1 && r.end == 4 && r.contains(4) && 4 in r && !(5 in r), "a Range value")
    sum: Mutable<Int32> { 0 }
    while i: Int32 in r {
        sum += i
    }
    t.check(sum == 10, "a loop over a Range includes its end")
    sum = 0
    while j: Int32 in 1..4 {
        sum += j
    }
    t.check(sum == 10, "a loop over a literal range holds its end too")
    sum = 0
    while j: Int32 in 1..<4 {
        sum += j
    }
    t.check(sum == 6, "a loop over 1..<4 leaves its end out")
    xs: List<Int32> { @listOf(5, 6, 7) }
    sum = 0
    while i: Size in 0..<xs.size() {
        sum += xs[i]
    }
    word: Str { "" }
    none: Size { 0 }
    while i: Size in 0..<word.length() {
        sum += 100
    }
    while i: Size in none..<none {
        sum += 100
    }
    t.check(sum == 18, "a loop below a List's size counts its indexes, and an empty one none")
    lasts: Mutable<Int32> { 0 }
    while q: UInt8 in 250..255 {
        lasts += 1
    }
    t.check(lasts == 6, "a loop up to UInt8's largest holds it and stops before the step")
    steps: Mutable<Int32> { 0 }
    top: Range<Int8> { 120..127 }
    while k: Int8 in top {
        steps += 1
    }
    t.check(steps == 8, "a Range up to Int8's largest stops there")
    empty: Range<Int32> { 5..4 }
    while e: Int32 in empty {
        steps += 100
    }
    t.check(steps == 8 && !(5 in empty), "a Range whose end is below its begin is empty")
    // a..<b leaves b out: empty when a is not below b, and never wrapping at an unsigned 0
    taken: Mutable<Int32> { 0 }
    z8: UInt8 { 0 }
    z16: UInt16 { 0 }
    z32: UInt32 { 0 }
    z64: UInt64 { 0 }
    zs: Size { 0 }
    while a8: UInt8 in 0..<z8 {
        taken += 1
    }
    while a16: UInt16 in 0..<z16 {
        taken += 1
    }
    while a32: UInt32 in 0..<z32 {
        taken += 1
    }
    while a64: UInt64 in 0..<z64 {
        taken += 1
    }
    while asz: Size in 0..<zs {
        taken += 1
    }
    while ab: UInt8 in 7..<z8 {
        taken += 1
    }
    t.check(taken == 0, "a loop up to an unsigned 0 with ..< takes no step, on every width")
    lasts = 0
    while mq: UInt8 in 250..<255 {
        lasts += 1
    }
    t.check(lasts == 5, "a loop up to UInt8's largest with ..< stops below it")
    four: Int32 { 4 }
    t.check(3 in 1..<4 && 1 in 1..<4 && !(4 in 1..<4) && !(four in 1..<3) && !(0 in 1..<4), "x in a..<b leaves b out")
    ro: Range<Int32> { 1..<4 }
    sum = 0
    while mr: Int32 in ro {
        sum += mr
    }
    t.check(!(4 in ro) && 3 in ro && ro.contains(1) && !ro.contains(4) && sum == 6, "a Range value of ..< leaves its end out and walks to just below it")
    nothing: Range<Size> { 0..<zs }
    taken = 0
    while mn: Size in nothing {
        taken += 1
    }
    t.check(taken == 0 && !(0 in nothing), "a ..< Range at an unsigned 0 holds nothing and walks no step")
    sum = 0
    while mb: Int32 in 0..<10 {
        if mb == 2 {
            continue
        }
        if mb == 5 {
            break
        }
        sum += mb
    }
    t.check(sum == 8, "break and continue work in a ..< loop")
    t.finish()
}

kira.test as test

// ranges: `a..b` is a Range<T> with both ends in it, and `x in r` is a Bool anywhere (lane RANGE,
// owner 2026-11-01). `x in a..b` builds no Range: x runs once, then each end. A loop over a..b holds b,
// written or held in a Range; a counter below its end (`while i < n`) leaves the end out.
// cpp-golden/ranges holds this file with a Box, a user type answering in, which py refuses.

trail: Mutable<Str> { "" }

seen: (tag: Str, v: Int32) Int32 {
    trail = trail + tag
    v
}

span: (tag: Str, lo: Int32, hi: Int32) Range<Int32> {
    trail = trail + tag
    lo..hi
}

pub main: () Int32 {
    t: Suite { title = "ranges - Range<T> and x in r" }
    t.check(9 in 9..13 && 13 in 9..13 && 10 in 9..13, "both ends are in")
    t.check(!(8 in 9..13) && !(14 in 9..13), "one past either end is not")
    b: UInt8 { 255 }
    t.check(b in 0..255 && !(b in 0..254) && (0 as UInt8) in 0..10, "a UInt8 at its limits")
    f: Float64 { 2.5 }
    t.check(f in 0..2.5 && !(f in 0.0..2.4) && -0.5 in -1..0, "a float range")
    t.check(!(seen("x", 5) in seen("a", 1)..seen("b", 4)), "x is outside")
    t.checkStr(trail, "xab", "x runs first, then each end once")
    trail = ""
    t.check(seen("y", 3) in span("r", 1, 3), "a Range from a call holds its end")
    t.checkStr(trail, "yr", "x runs before the range")
    r: Range<Int32> { 1..4 }
    t.check(r.begin == 1 && r.end == 4 && r.contains(4) && 4 in r && !(5 in r), "a Range value")
    sum: Mutable<Int32> { 0 }
    ri: Mutable<Int32> { r.begin }
    while ri <= r.end {
        sum += ri
        ri += 1
    }
    t.check(sum == 10, "a counter from a Range's begin to its end includes its end")
    sum = 0
    j: Mutable<Int32> { 1 }
    while j <= 4 {
        sum += j
        j += 1
    }
    t.check(sum == 10, "a counter up to a literal end holds it too")
    sum = 0
    j = 1
    while j < 4 {
        sum += j
        j += 1
    }
    t.check(sum == 6, "a counter below its end leaves it out")
    xs: List<Int32> { @listOf(5, 6, 7) }
    sum = 0
    i: Mutable<Size> { 0 }
    while i < xs.size() {
        sum += xs[i]
        i += 1
    }
    word: Str { "" }
    none: Size { 0 }
    i = 0
    while i < word.length() {
        sum += 100
        i += 1
    }
    i = none
    while i < none {
        sum += 100
        i += 1
    }
    t.check(sum == 18, "a counter below a List's size counts its indexes, and an empty one none")
    lasts: Mutable<Int32> { 0 }
    q: Mutable<UInt8> { 250 }
    more: Mutable<Bool> { true }
    while more {
        lasts += 1
        if q == 255 {
            more = false
        } else {
            q += 1
        }
    }
    t.check(lasts == 6, "a loop up to UInt8's largest holds it and stops before the step")
    steps: Mutable<Int32> { 0 }
    top: Range<Int8> { 120..127 }
    k: Mutable<Int8> { top.begin }
    more = true
    while more {
        steps += 1
        if k == top.end {
            more = false
        } else {
            k += 1
        }
    }
    t.check(steps == 8, "a Range up to Int8's largest stops there")
    empty: Range<Int32> { 5..4 }
    e: Mutable<Int32> { empty.begin }
    while e <= empty.end {
        steps += 100
        e += 1
    }
    t.check(steps == 8 && !(5 in empty), "a Range whose end is below its begin is empty")
    t.finish()
}

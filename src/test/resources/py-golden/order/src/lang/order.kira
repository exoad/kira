module "lang:order"

// Kira's evaluation order on the py target. D33: a call's receiver and arguments, and an
// operator's operands, run left to right, and an assignment locates its target (each index)
// before its value runs. OQ-1: an immutable value's operand, a compound assignment's target
// included, is read before a call beside it that writes it. Construction: the given values as
// written, then the defaults in declaration order, then `initially`. && and || short-circuit.
// The expected output is the C++ backend's run of this same module.

mut ticks: Int32 = 0
mut idx: Size = 0
mut slots: List<Int32> = List<Int32> { }
mut gs: Str = "a"

fx next: () Int32 {
    ticks += 1
    return ticks
}

fx nextSize: () Size {
    idx += 1
    return idx
}

fx sub: (a: Int32, b: Int32) Int32 {
    return a - b
}

fx bumpIdx: () Int32 {
    idx += 1
    return 99
}

fx changeS: () Int32 {
    gs = "b"
    return 1
}

fx pairS: (s: Str, k: Int32) Str {
    return "${s}${k}"
}

class Box {
    require pub mut v: Int32

    pub fx pair: (a: Int32, b: Int32) Int32 {
        return v * 100 + a * 10 + b
    }
}

fx makeBox: () Box {
    ticks += 1
    return Box { ticks }
}

class Counter {
    pub mut n: Int32 = 0

    pub mut fx bump: () Int32 {
        n += 10
        return 1
    }

    pub mut fx run: () Int32 {
        n += bump()
        return n
    }

    pub mut fx runPlain: () Int32 {
        n = n + bump()
        return n
    }
}

class Track {
    require pub a: Int32
    pub b: Int32 = next()
    require pub c: Int32
    pub d: Int32 = next()
    pub mut seen: Int32 = 0

    initially {
        seen = next()
    }
}

fx show: (t: Track) Str {
    return "a=${t.a} b=${t.b} c=${t.c} d=${t.d} seen=${t.seen}"
}

fx main: () Void {
    trace(sub(next(), next()))
    trace(next() - next())
    trace(sub(sub(next(), next()), next()))
    trace("${next()}/${next()}")
    trace(sub(ticks, next()))
    trace("${ticks}/${next()}")
    ticks += next()
    trace(ticks)
    ticks = ticks + next()
    trace(ticks)
    trace(makeBox().pair(next(), next()))
    slots.add(0)
    slots.add(0)
    slots.add(0)
    slots.add(0)
    idx = 0
    slots[nextSize()] = next()
    trace(slots[1])
    idx = 0
    slots[idx] = bumpIdx()
    trace(slots[0])
    trace(slots[1])
    trace(idx)
    idx = 0
    slots[nextSize()] += next()
    trace(slots[1])
    trace(idx)
    idx = 2
    slots[idx] += bumpIdx()
    trace(slots[2])
    trace(slots[3])
    trace(pairS(gs, changeS()))
    gs = "a"
    trace("${gs}:${changeS()}")
    gs = "a"
    trace(gs + "${changeS()}")
    mut c: Counter = Counter { }
    trace(c.run())
    trace(c.runPlain())
    ticks = 0
    t: Track = Track { a = next(), c = next() }
    trace(show(t))
    ticks = 0
    u: Track = Track { c = next(), a = next() }
    trace(show(u))
    ticks = 0
    if ticks > 0 && next() > 0 {
        trace("no")
    }
    if ticks == 0 || next() > 0 {
        trace("yes")
    }
    trace(ticks)
    mut steps: Int32 = 0
    while next() < 5 && steps < 100 {
        steps += 1
    }
    trace(steps)
    trace(ticks)
}

golden.py.modules.lib.units as units

pub total: Mutable<Int32> = 0

// Starts from lib:units' constants, which every module reads as it loads.
pub start: Mutable<List<Int32>> = @listOf(SCALE, 7)

pub record: (m: Meter, raw: Int32) Int32 {
    total += m.read(raw)
    bump(1)
}

pub fresh: (label: Str) Meter {
    Meter { label }
}

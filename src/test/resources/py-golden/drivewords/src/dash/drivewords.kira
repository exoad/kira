module "dash:drivewords"

// webdrive_fake.py's reading of a page's text frame in Kira: split() into words, then "c" and
// six ints (the control, which the newest of a read carries), and message's "hold", "cmd" and
// six ints, "p" and "hidden"; a word that int() refuses drops a control or a command. split()
// takes Python's whitespace over ASCII and the ints are Int64s. The expected output is the C++
// backend's run of main, then the driver's run of readFrame, a frame's bytes read with Str.of
// (D55), against the hand-written reader.

fx space: (c: Char) Bool {
    return c == ' ' || (c >= '\t' && c <= '\r') || (c >= (28 as Char) && c <= (31 as Char))
}

// s.split()
pub fx words: (s: Str) List<Str> {
    mut out: List<Str> = List<Str> { }
    mut i: Size = 0
    while i < s.length() {
        while i < s.length() && space(s[i]) {
            i += 1
        }
        if i == s.length() {
            break
        }
        mut j: Size = i
        while j < s.length() && !space(s[j]) {
            j += 1
        }
        out.add(s.substring(i, j))
        i = j
    }
    return out
}

// words[1:7] as ints, joined by spaces, or none when one is not an int.
fx sixInts: (w: List<Str>) Maybe<Str> {
    mut out: Str = ""
    mut k: Size = 1
    while k < 7 {
        v: Maybe<Int64> = w[k].toInt64()
        if v.isNone() {
            return null
        }
        out = out + " ${v.value}"
        k += 1
    }
    return out
}

// One frame's words as what the fake car does with them.
pub fx read: (text: Str) Str {
    w: List<Str> = words(text)
    if w.isEmpty() {
        return "nothing"
    }
    w0: Str = w[0]
    if w0 == "c" && w.size() >= 7 {
        return "control" + sixInts(w).unwrapOr(" dropped")
    }
    if w0 == "hold" && w.size() >= 2 {
        return if w[1] == "1" { "hold take" } else { "hold release" }
    }
    if w0 == "cmd" && w.size() >= 7 {
        return "command" + sixInts(w).unwrapOr(" dropped")
    }
    if w0 == "p" && w.size() >= 2 {
        return "ping " + w[1]
    }
    if w0 == "hidden" {
        return "hidden"
    }
    return "ignored"
}

// A frame as the loop reads it: data.decode("utf-8", "replace") (Str.of, D55), then read.
pub fx readFrame: (data: View<UInt8>) Str {
    return read(Str.of(data))
}

fx main: () Void {
    trace(read("c 1 0 1500 0 3 1"))
    trace(read("  c\t7 -250 +1600 2 3 0  extra\r\n"))
    trace(read("c 1 2 3 4 5"))
    trace(read("c 1 2 3 4 5 x"))
    trace(read("c 1 2 3 4 5 9223372036854775808"))
    trace(read("hold 1"))
    trace(read("hold 0"))
    trace(read("hold"))
    trace(read("cmd 4 2 1 0 0 3"))
    trace(read("cmd 4 2 1 0 0 3.0"))
    trace(read("p 1234"))
    trace(read("hidden now"))
    trace(read(""))
    trace(read(" \t${(11 as Char)}${(31 as Char)} "))
    trace(read("C 1 2 3 4 5 6"))
    trace(words("a${(28 as Char)}b${(12 as Char)}c d").size())
    hold: List<UInt8> = [0x68, 0x6F, 0x6C, 0x64, 0x20, 0x31, 0xFF]
    trace(readFrame(hold))
    c: List<UInt8> = [0x63, 0x20, 0x31, 0x20, 0x32, 0x20, 0x33, 0x20, 0x34, 0x20, 0x35, 0x20, 0x36, 0xE2, 0x82]
    trace(readFrame(c))
}

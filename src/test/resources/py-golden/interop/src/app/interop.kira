// What hand-written Python sees of a Kira module (driver.py uses it): a pub class keeps its
// name and its constructor takes the `require` fields; a pub field is an attribute and a pub
// method a method; private members are _name. Maybe is None or the value. A program error
// (a zero divisor, an overflow, the value of a null Maybe) is a RuntimeError.

pub Account: Any {
    pub owner: Str
    limit: Int32
    pub mut balance: Int32 = 0
    mut history: List<Int32> = List<Int32> { }
    pub mut note: Maybe<Str> = null

    pub mut deposit: (amount: Int32) Int32 {
        balance += amount
        history.add(amount)
        balance
    }

    pub mut withdraw: (amount: Int32) Maybe<Int32> {
        if balance - amount < -limit {
            null
        } else {
            balance -= amount
            history.add(-amount)
            balance
        }
    }

    pub moves: () Size {
        history.size()
    }

    pub move: (i: Size) Int32 {
        history[i]
    }

    pub noteOr: (fallback: Str) Str {
        note.unwrapOr(fallback)
    }
}

// Immutable: a value whose copies are indistinguishable, so Python shares it.
pub Point: Any {
    pub x: Float64
    pub y: Float64

    pub plus: (other: Point) Point {
        Point { x + other.x, y + other.y }
    }
}

pub div: (a: Int32, b: Int32) Int32 {
    a / b
}

pub rem: (a: Int32, b: Int32) Int32 {
    a % b
}

pub add: (a: Int32, b: Int32) Int32 {
    a + b
}

pub mul64: (a: Int64, b: Int64) Int64 {
    a * b
}

pub valueOf: (m: Maybe<Float64>) Float64 {
    m.value
}

pub orZero: (m: Maybe<Float64>) Float64 {
    m.isNull() ? 0.0 : m.value
}

pub isSome: (m: Maybe<Int32>) Bool {
    m.isSome()
}

pub isNone: (m: Maybe<Int32>) Bool {
    m.isNone()
}

pub ratio: (a: Float64, b: Float64) Float64 {
    a / b
}

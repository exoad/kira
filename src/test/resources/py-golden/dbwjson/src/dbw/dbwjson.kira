module "dbw:dbwjson"

use "kira:json"

// dbwcodec.py's load() and Spec over dbw.json with kira:json: the tables Spec builds, as one Json in
// canon()'s order, or what load and Spec raise in their words. The expected output is main's C++ run.

HEADER_BYTES: Int64 = 10
CRC_BYTES: Int64 = 2

fx crc16: (data: List<UInt8>) Int64 {
    mut crc: UInt32 = 0xFFFF
    mut i: Size = 0
    while i < data.size() {
        crc = crc ^ ((data[i] as UInt32) << 8)
        mut k: Int32 = 0
        while k < 8 {
            if (crc & 0x8000) != 0 {
                crc = ((crc << 1) ^ 0x1021) & 0xFFFF
            } else {
                crc = (crc << 1) & 0xFFFF
            }
            k += 1
        }
        i += 1
    }
    return crc as Int64
}

// Python's int(text, 16) of a JSON value: a 0x prefix, hex digits; none where it raises ValueError.
fx hex: (v: Json) Maybe<Int64> {
    t: Str = v.asStr().unwrapOr("").trim()
    digits: Str = if t.startsWith("0x") || t.startsWith("0X") {
        t.substring(2, t.size())
    } else {
        t
    }
    if digits.isEmpty() || digits.size() > 15 {
        return null
    }
    mut n: Int64 = 0
    mut i: Size = 0
    while i < digits.size() {
        c: Char = digits[i]
        mut d: Int64 = -1
        if c >= '0' && c <= '9' {
            d = (c as Int64) - 48
        } else if c >= 'a' && c <= 'f' {
            d = (c as Int64) - 87
        } else if c >= 'A' && c <= 'F' {
            d = (c as Int64) - 55
        }
        if d < 0 {
            return null
        }
        n = n * 16 + d
        i += 1
    }
    return n
}

// Python's v != n for a JSON value and an integer: a Bool is 0 or 1, a Str never equal.
fx differs: (v: Json, n: Int64) Bool {
    if v.isBool() {
        b: Int64 = if v.asBool().unwrap() {
            1
        } else {
            0
        }
        return b != n
    }
    if v.isInt() {
        return v.asInt64().unwrap() != n
    }
    return v.asFloat64().unwrapOr(0.5) != (n as Float64)
}

// struct.calcsize of a little-endian format; -1 for one this port does not read.
fx calcsize: (fmt: Str) Int64 {
    if !fmt.startsWith("<") {
        return -1
    }
    mut size: Int64 = 0
    mut count: Int64 = -1
    mut i: Size = 1
    while i < fmt.size() {
        c: Char = fmt[i]
        if c >= '0' && c <= '9' {
            if count < 0 {
                count = 0
            }
            count = count * 10 + ((c as Int64) - 48)
        } else {
            mut width: Int64 = 0
            if c == 'x' || c == 'c' || c == 'b' || c == 'B' || c == '?' || c == 's' || c == 'p' {
                width = 1
            } else if c == 'h' || c == 'H' || c == 'e' {
                width = 2
            } else if c == 'i' || c == 'I' || c == 'l' || c == 'L' || c == 'f' {
                width = 4
            } else if c == 'q' || c == 'Q' || c == 'd' {
                width = 8
            } else {
                return -1
            }
            times: Int64 = if count < 0 {
                1
            } else {
                count
            }
            size += width * times
            count = -1
        }
        i += 1
    }
    return size
}

// A Python dict's key as json.dumps writes it: a Str as itself, a number, Bool or null as its JSON.
fx key: (v: Json) Str {
    if v.isStr() {
        return v.asStr().unwrap()
    }
    return v.dump()
}

fx byName: (rows: Json, name: Str, value: Str) Json {
    out: Json = Json.obj()
    mut i: Size = 0
    while i < rows.size() {
        out.put(key(rows.at(i).get(name)), rows.at(i).get(value))
        i += 1
    }
    return out
}

fx rowsBy: (rows: Json, name: Str) Json {
    out: Json = Json.obj()
    mut i: Size = 0
    while i < rows.size() {
        out.put(key(rows.at(i).get(name)), rows.at(i))
        i += 1
    }
    return out
}

pub fx tables: (path: Str, text: Str) Str {
    data: Json = Json.parse(text)
    if Json.error() != "" {
        return "SpecError: cannot read " + path + ": " + Json.error()
    }
    fr: Json = data.get("framing")
    magic: Json = Json.arr()
    mut i: Size = 0
    while i < fr.get("magic").size() {
        b: Maybe<Int64> = hex(fr.get("magic").at(i))
        if b.isNull() {
            return "ValueError: invalid literal for int() with base 16: '" + fr.get("magic").at(i).asStr().unwrapOr("") + "'"
        }
        if b.value > 255 {
            return "ValueError: bytes must be in range(0, 256)"
        }
        magic.add(Json.of(b.value))
        i += 1
    }
    if differs(fr.get("header_bytes"), HEADER_BYTES) || differs(fr.get("crc_bytes"), CRC_BYTES) {
        return "SpecError: the frame shape in dbw.json is not the one this codec implements"
    }
    check: Maybe<Int64> = hex(fr.get("crc").get("check"))
    if check.isNull() {
        return "ValueError: invalid literal for int() with base 16: '" + fr.get("crc").get("check").asStr().unwrapOr("") + "'"
    }
    if crc16("123456789".bytes()) != check.value {
        return "SpecError: crc16 does not give the spec's check value"
    }
    vcu: Json = data.get("timing").get("vcu")
    gap: Json = vcu.get("FRAME_GAP_MS")
    gapUs: Json = if gap.isInt() {
        Json.of(gap.asInt64().unwrap() * 1000)
    } else {
        Json.of(gap.asFloat64().unwrap() * 1000.0)
    }
    messages: Json = Json.obj()
    byId: Json = Json.obj()
    all: Json = data.get("messages")
    i = 0
    while i < all.size() {
        m: Json = all.at(i)
        mut fields: Json = m.get("fields")
        if fields.isStr() {
            same: Str = fields.asStr().unwrap()
            colon: Maybe<Size> = same.find(":")
            if colon.isNull() {
                return "IndexError: list index out of range"
            }
            other: Str = same.substring(colon.value + 1, same.size())
            mut j: Size = 0
            while j < all.size() && all.at(j).get("name").asStr().unwrapOr("") != other {
                j += 1
            }
            if j == all.size() {
                return "StopIteration"
            }
            fields = all.at(j).get("fields")
        }
        entry: Json = Json.obj()
        entry.put("name", m.get("name"))
        entry.put("id", m.get("id"))
        entry.put("dir", m.get("dir"))
        entry.put("fields", fields)
        entry.put("size", m.get("size"))
        entry.put("struct", m.get("struct"))
        entry.put("frozen", m.get("frozen"))
        if differs(m.get("size"), calcsize(m.get("struct").asStr().unwrap())) {
            return "SpecError: " + key(m.get("name")) + ": struct and size disagree"
        }
        messages.put(key(m.get("name")), entry)
        byId.put(key(m.get("id")), entry)
        i += 1
    }
    enums: Json = Json.obj()
    enumNames: Json = Json.obj()
    names: List<Str> = data.get("enums").keys()
    i = 0
    while i < names.size() {
        values: Json = data.get("enums").get(names[i]).get("values")
        enums.put(names[i], byName(values, "name", "value"))
        enumNames.put(names[i], byName(values, "value", "name"))
        i += 1
    }
    p: Json = data.get("protocol")
    c: Json = Json.obj()
    c.put("magic", magic)
    c.put("major", p.get("major"))
    c.put("minor", p.get("minor"))
    c.put("min_vcu_minor", p.get("min_vcu_minor"))
    c.put("max_payload", fr.get("max_payload"))
    c.put("timing_vcu", vcu)
    c.put("timing_host", data.get("timing").get("host"))
    c.put("frame_gap_us", gapUs)
    c.put("messages", messages)
    c.put("by_id", byId)
    c.put("fault_bits", byName(data.get("fault_bits"), "name", "bit"))
    c.put("fault_names", byName(data.get("fault_bits"), "bit", "name"))
    c.put("info_bits", byName(data.get("info_bits"), "name", "bit"))
    c.put("bumper_flag_bits", byName(data.get("bumper_flag_bits"), "name", "bit"))
    c.put("reasons", rowsBy(data.get("reasons"), "name"))
    c.put("reason_by_value", rowsBy(data.get("reasons"), "value"))
    c.put("nack_codes", byName(data.get("nack_codes"), "name", "code"))
    c.put("nack_names", byName(data.get("nack_codes"), "code", "name"))
    c.put("enums", enums)
    c.put("enum_names", enumNames)
    c.put("status_line", data.get("status_line"))
    return c.dump()
}

fx field: (name: Str, kind: Str) Json {
    f: Json = Json.obj()
    f.put("name", Json.of(name))
    f.put("type", Json.of(kind))
    return f
}

fx message: (name: Str, id: Int64, fmt: Str, size: Int64, fields: Json) Json {
    m: Json = Json.obj()
    m.put("name", Json.of(name))
    m.put("id", Json.of(id))
    m.put("dir", Json.of("host_to_vcu"))
    m.put("size", Json.of(size))
    m.put("struct", Json.of(fmt))
    m.put("frozen", Json.of(false))
    m.put("fields", fields)
    return m
}

fx row: (a: Str, x: Json, b: Str, y: Json) Json {
    r: Json = Json.obj()
    r.put(a, x)
    r.put(b, y)
    return r
}

fx spec: (header: Int64, check: Str, configSize: Int64) Json {
    d: Json = Json.obj()
    d.put("spec", Json.of("bibo-dbw"))
    d.put("protocol", row("major", Json.of(1), "minor", Json.of(0)))
    d.get("protocol").put("min_vcu_minor", Json.of(0))
    fr: Json = Json.obj()
    magic: Json = Json.arr()
    magic.add(Json.of("0xFB"))
    magic.add(Json.of("0xB1"))
    fr.put("magic", magic)
    fr.put("header_bytes", Json.of(header))
    fr.put("crc_bytes", Json.of(2.0))
    fr.put("max_payload", Json.of(52))
    fr.put("crc", row("name", Json.of("CRC-16/CCITT-FALSE"), "check", Json.of(check)))
    d.put("framing", fr)
    timing: Json = Json.obj()
    timing.put("vcu", row("FRAME_GAP_MS", Json.of(20), "HB_TIMEOUT_MS", Json.of(150)))
    timing.put("host", row("HB_PERIOD_MS", Json.of(50), "LINK_LOST_S", Json.of(1.5)))
    d.put("timing", timing)
    hb: Json = Json.arr()
    hb.add(field("host_ms", "u32"))
    hb.add(field("mode", "u8"))
    cfg: Json = Json.arr()
    cfg.add(field("servo_min_us", "u16"))
    cfg.add(field("bumper_filter_ms", "u8"))
    all: Json = Json.arr()
    all.add(message("HEARTBEAT", 1, "<IB", 5, hb))
    all.add(message("CONFIG_SET", 5, "<HB", configSize, cfg))
    all.add(message("VCU_HELLO", 32768, "<BBBBIBBBB8s24s", 44, Json.arr()))
    all.add(message("CONFIG_REPORT", 32774, "<HB", 3, Json.of("same_as:CONFIG_SET")))
    all.add(message("HEARTBEAT", 2, "<IB", 5, hb))
    d.put("messages", all)
    bits: Json = Json.arr()
    bits.add(row("bit", Json.of(0), "name", Json.of("ESTOP")))
    bits.add(row("bit", Json.of(1), "name", Json.of("HEARTBEAT_TIMEOUT")))
    bits.add(row("bit", Json.of(0), "name", Json.of("ESTOP_AGAIN")))
    d.put("fault_bits", bits)
    d.put("info_bits", Json.arr())
    d.get("info_bits").add(row("bit", Json.of(0), "name", Json.of("SETPOINT_LIVE")))
    d.put("bumper_flag_bits", Json.arr())
    reasons: Json = Json.arr()
    reasons.add(row("value", Json.of(0), "name", Json.of("NONE")))
    reasons.add(row("value", Json.of(257), "name", Json.of("LIDAR_STALE")))
    reasons.at(1).put("recoverable", Json.of(true))
    reasons.at(1).put("doc", Json.of("the lidar's newest scan is older than 400 ms — stop"))
    d.put("reasons", reasons)
    d.put("nack_codes", Json.arr())
    d.get("nack_codes").add(row("code", Json.of(1), "name", Json.of("UNKNOWN_TYPE")))
    states: Json = Json.arr()
    states.add(row("name", Json.of("BOOT"), "value", Json.of(0)))
    states.add(row("name", Json.of("ARMED"), "value", Json.of(4)))
    enums: Json = Json.obj()
    enums.put("State", row("values", states, "doc", Json.of("the VCU's state")))
    d.put("enums", enums)
    d.put("status_line", row("doc", Json.of("one line"), "format", Json.null()))
    return d
}

fx main: () Void {
    trace(tables("dbw.json", spec(10, "0x29B1", 3).pretty(1, true)))
    trace(tables("dbw.json", spec(10, "29b1", 3).dump()))
    trace(tables("dbw.json", spec(11, "0x29B1", 3).dump()))
    trace(tables("dbw.json", spec(10, "0x29B2", 3).dump()))
    trace(tables("dbw.json", spec(10, "0xZZ", 3).dump()))
    trace(tables("dbw.json", spec(10, "0x29B1", 4).dump()))
    trace(tables("/home/jack/bibo/dbw/dbw.json", "{\"framing\": {\"magic\": [\"0xFB\",]}}"))
}

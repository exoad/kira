// Containers of containers are shared all the way down (stage 4): each name below sees what
// the other changes.

kira.tuples as tuples

Book: Mutable<Any> {
    pub pages: Mutable<Map<Str, List<Int32>>> = Map<Str, List<Int32>> { }
    pub last: Mutable<Maybe<List<Int32>>> = null

    pub note: (key: Str, v: Int32) Void {
        row: Mutable<List<Int32>> = pages.get(key).unwrapOr(List<Int32> { })
        row.add(v)
        pages.put(key, row)
        last = row
    }
}

show: (xs: List<Int32>) Str {
    s: Mutable<Str> = "["
    for i: Size in 0..xs.size() {
        if i > 0 {
            s = s + " "
        }
        s = s + "${xs[i]}"
    }
    s + "]"
}

grid: (rows: Size, cols: Size) List<List<Int32>> {
    out: Mutable<List<List<Int32>>> = List<List<Int32>> { }
    for r: Size in 0..rows {
        row: Mutable<List<Int32>> = List<Int32> { }
        for c: Size in 0..cols {
            row.add((r * 10 + c) as Int32)
        }
        out.add(row)
        row.add(-1)
    }
    out
}

total: (g: List<List<Int32>>) Int32 {
    t: Mutable<Int32> = 0
    for row: List<Int32> in g {
        for v: Int32 in row {
            t += v
        }
    }
    t
}

main: () Void {
    g: Mutable<List<List<Int32>>> = grid(2, 3)
    trace("${show(g[0])} ${show(g[1])} ${total(g)}")
    row: Mutable<List<Int32>> = g[0]
    row.add(99)
    g[1][0] = 7
    g[0].add(5)
    trace("${show(g[0])} ${show(g[1])} ${show(row)}")
    h: Mutable<List<List<Int32>>> = g
    h[0][0] = -5
    h.add(row)
    row.add(100)
    trace("${show(g[0])} ${h.size()} ${show(h[2])} ${g.size()}")
    g[1] = row
    row.add(101)
    trace("${show(g[1])} ${g.contains(h[2])}")
    fixed: Arr<List<Int32>, 2> = Arr<List<Int32>, 2> { }
    trace("${fixed[0].size()} ${fixed.size()}")

    // a Map of Lists, through a class, and its copies
    b: Mutable<Book> = Book { }
    b.note("a", 1)
    b.note("a", 2)
    b.note("b", 3)
    snap: Mutable<Map<Str, List<Int32>>> = b.pages
    b.note("a", 4)
    trace("${show(snap.get("a").unwrap())} ${show(b.pages.get("a").unwrap())} ${show(b.last.unwrap())}")
    got: Mutable<List<Int32>> = b.pages.get("b").unwrap()
    got.add(30)
    trace(show(b.pages.get("b").unwrap()))
    es: Arr<Tuple2<Str, List<Int32>>> = b.pages.entries()
    trace("${es[0].first} ${show(es[0].second)} ${es.size()}")
    vs: Arr<List<Int32>> = b.pages.valuesArr()
    trace(show(vs[1]))

    // a Map of Maps, a List of Maps, a Maybe of a List
    mm: Mutable<Map<Str, Map<Str, Int32>>> = Map<Str, Map<Str, Int32>> { }
    inner: Mutable<Map<Str, Int32>> = Map<Str, Int32> { }
    inner["x"] = 1
    mm["one"] = inner
    inner["y"] = 2
    trace("${mm.get("one").unwrap().size()} ${inner.size()}")
    lm: Mutable<List<Map<Str, Int32>>> = List<Map<Str, Int32>> { }
    lm.add(inner)
    lm[0]["z"] = 3
    trace("${lm[0].size()} ${inner.size()}")
    m: Maybe<List<Int32>> = row
    row.add(102)
    trace(show(m.unwrap()))
    none: Maybe<List<Int32>> = null
    trace(none.isNone())
}

module "dash:linkwatch"

// linkwatch.py's parsers in Kira, over Str and Char with no regex: parse_link reads `iw dev X
// link` (the regexes' ^ and $ are lines split on \n, \s is Python's whitespace), parse_wireless
// a /proc/net/wireless level, first_managed the first managed interface of `iw dev` (lines as
// splitlines() cuts them). Whitespace is Python's isspace() over ASCII: space, \t \n \v \f \r
// and \x1c to \x1f. The expected output is the C++ backend's run of main, then the driver's run
// of these against the hand-written ones.

pub class Link {
    pub mut connected: Bool = false
    pub mut ssid: Str = ""
    pub mut freqMhz: Maybe<Int64> = null
    pub mut dbm: Maybe<Int64> = null
    pub mut txMbps: Maybe<Float64> = null
    pub mut rxMbps: Maybe<Float64> = null
}

fx space: (c: Char) Bool {
    return c == ' ' || (c >= '\t' && c <= '\r') || (c >= (28 as Char) && c <= (31 as Char))
}

fx digit: (c: Char) Bool {
    return c >= '0' && c <= '9'
}

// Where s stops being whitespace from `at` on.
fx skipSpace: (s: Str, at: Size) Size {
    mut i: Size = at
    while i < s.length() && space(s[i]) {
        i += 1
    }
    return i
}

fx lstrip: (s: Str) Str {
    return s.substring(skipSpace(s, 0), s.length())
}

fx rstrip: (s: Str) Str {
    mut n: Size = s.length()
    while n > 0 && space(s[n - 1]) {
        n -= 1
    }
    return s.substring(0, n)
}

fx strip: (s: Str) Str {
    return rstrip(lstrip(s))
}

fx allSpace: (s: Str) Bool {
    return skipSpace(s, 0) == s.length()
}

// The digits at the start of s (\d+ over ASCII), "" for none.
fx digitsAt: (s: Str) Str {
    mut n: Size = 0
    while n < s.length() && digit(s[n]) {
        n += 1
    }
    return s.substring(0, n)
}

// The rest of the first line whose start, after whitespace, is `key` and whose rest `value`
// takes: "^\s*<key><value>" with re.M, and the line's rest after the key for `value` to read.
fx after: (lines: List<Str>, key: Str, at: Size) Maybe<Size> {
    mut i: Size = at
    while i < lines.size() {
        if lstrip(lines[i]).startsWith(key) {
            return i
        }
        i += 1
    }
    return null
}

fx rest: (line: Str, key: Str) Str {
    return lstrip(line).substring(key.length(), lstrip(line).length())
}

// ^\s*Not connected\.?\s*$
fx notConnected: (line: Str) Bool {
    s: Str = lstrip(line)
    if !s.startsWith("Not connected") {
        return false
    }
    mut tail: Str = s.substring(13, s.length())
    if tail.startsWith(".") {
        tail = tail.substring(1, tail.length())
    }
    return allSpace(tail)
}

// The first int a "^\s*<key>(-?\d+)" line gives, signed when `signed`.
fx intAfter: (lines: List<Str>, key: Str, signed: Bool) Maybe<Int64> {
    mut at: Size = 0
    while at < lines.size() {
        i: Maybe<Size> = after(lines, key, at)
        if i.isNone() {
            return null
        }
        r: Str = rest(lines[i.value], key)
        sign: Str = if signed && r.startsWith("-") { "-" } else { "" }
        d: Str = digitsAt(r.substring(sign.length(), r.length()))
        if !d.isEmpty() {
            return (sign + d).toInt64()
        }
        at = i.value + 1
    }
    return null
}

// The first float a "^\s*<key>([\d.]+) MBit/s" line gives.
fx rateAfter: (lines: List<Str>, key: Str) Maybe<Float64> {
    mut at: Size = 0
    while at < lines.size() {
        i: Maybe<Size> = after(lines, key, at)
        if i.isNone() {
            return null
        }
        r: Str = rest(lines[i.value], key)
        mut n: Size = 0
        while n < r.length() && (digit(r[n]) || r[n] == '.') {
            n += 1
        }
        if n > 0 && r.substring(n, r.length()).startsWith(" MBit/s") {
            return r.substring(0, n).toFloat64()
        }
        at = i.value + 1
    }
    return null
}

// parse_link: none when the text is neither "Not connected" nor "Connected to ...".
pub fx parseLink: (text: Str) Maybe<Link> {
    out: Link = Link { }
    lines: List<Str> = text.split("\n")
    mut i: Size = 0
    while i < lines.size() {
        if notConnected(lines[i]) {
            return out
        }
        i += 1
    }
    if !text.substring(skipSpace(text, 0), text.length()).startsWith("Connected to ") {
        return null
    }
    out.connected = true
    s: Maybe<Size> = after(lines, "SSID:", 0)
    if s.isSome() {
        mut r: Str = rest(lines[s.value], "SSID:")
        if r.startsWith(" ") {
            r = r.substring(1, r.length())
        }
        out.ssid = rstrip(r)
    }
    out.freqMhz = intAfter(lines, "freq: ", false)
    out.dbm = intAfter(lines, "signal: ", true)
    out.txMbps = rateAfter(lines, "tx bitrate: ")
    out.rxMbps = rateAfter(lines, "rx bitrate: ")
    return out
}

// A line break as splitlines() takes one: \n, \r, \v, \f, \x1c, \x1d, \x1e.
fx lineBreak: (c: Char) Bool {
    return c == '\n' || c == '\r' || c == (11 as Char) || c == (12 as Char) || (c >= (28 as Char) && c <= (30 as Char))
}

// text.splitlines(): \r\n is one break, and the text after the last break is a line only
// when it is not empty.
pub fx splitLines: (text: Str) List<Str> {
    mut out: List<Str> = List<Str> { }
    mut start: Size = 0
    mut i: Size = 0
    while i < text.length() {
        if lineBreak(text[i]) {
            out.add(text.substring(start, i))
            if text[i] == '\r' && i + 1 < text.length() && text[i + 1] == '\n' {
                i += 1
            }
            start = i + 1
        }
        i += 1
    }
    if start < text.length() {
        out.add(text.substring(start, text.length()))
    }
    return out
}

// s.split(): the words between runs of whitespace.
pub fx words: (s: Str) List<Str> {
    mut out: List<Str> = List<Str> { }
    mut i: Size = skipSpace(s, 0)
    while i < s.length() {
        mut j: Size = i
        while j < s.length() && !space(s[j]) {
            j += 1
        }
        out.add(s.substring(i, j))
        i = skipSpace(s, j)
    }
    return out
}

// parse_wireless: the link level of iface in dBm, a positive reading less 256, and none for a
// level that is no finite number (int() raises on an infinity there).
pub fx parseWireless: (text: Str, iface: Str) Maybe<Int64> {
    lines: List<Str> = splitLines(text)
    mut i: Size = 0
    while i < lines.size() {
        line: Str = lines[i]
        if strip(line).startsWith(iface + ":") {
            colon: Size = line.find(":").unwrapOr(0)
            f: List<Str> = words(line.substring(colon + 1, line.length()))
            if f.size() < 3 {
                return null
            }
            level: Maybe<Float64> = f[2].toFloat64()
            if level.isNone() || level.value - level.value != 0.0 {
                return null
            }
            v: Int64 = level.value as Int64
            return if v > 0 { v - 256 } else { v }
        }
        i += 1
    }
    return null
}

// first_managed: the interface named on the line before the first "type managed".
pub fx firstManaged: (text: Str) Maybe<Str> {
    lines: List<Str> = splitLines(text)
    mut name: Str = ""
    mut i: Size = 0
    while i < lines.size() {
        s: Str = strip(lines[i])
        if s.startsWith("Interface ") {
            name = words(s)[1]
        } else if s == "type managed" && !name.isEmpty() {
            return name
        }
        i += 1
    }
    return null
}

fx intText: (m: Maybe<Int64>) Str {
    return if m.isNone() { "None" } else { m.value as Str }
}

fx floatText: (m: Maybe<Float64>) Str {
    return if m.isNone() { "None" } else { m.value as Str }
}

fx linkText: (text: Str) Str {
    p: Maybe<Link> = parseLink(text)
    if p.isNone() {
        return "None"
    }
    l: Link = p.unwrap()
    return "connected=${l.connected} ssid=[${l.ssid}] freq=${intText(l.freqMhz)} dbm=${intText(l.dbm)} tx=${floatText(l.txMbps)} rx=${floatText(l.rxMbps)}"
}

fx main: () Void {
    five: Str = "Connected to b8:f8:53:f8:ce:84 (on wlan0)\n\tSSID: Fios-2CTx6\n\tfreq: 5280\n\tRX: 34530416 bytes (202326 packets)\n\tTX: 113467223 bytes (111939 packets)\n\tsignal: -45 dBm\n\trx bitrate: 600.4 MBit/s 80MHz HE-MCS 11 HE-NSS 1 HE-GI 0 HE-DCM 0\n\ttx bitrate: 540.3 MBit/s 80MHz HE-MCS 10 HE-NSS 1 HE-GI 0 HE-DCM 0\n"
    two: Str = "Connected to 3c:84:6a:11:22:33 (on wlan0)\n\tSSID: WhoopWhoop\n\tfreq: 2437.0\n\tsignal: -71 dBm\n\trx bitrate: 65.0 MBit/s MCS 7\n\ttx bitrate: 72.2 MBit/s MCS 7 short GI\n"
    trace(linkText(five))
    trace(linkText(two))
    trace(linkText("Not connected.\n"))
    trace(linkText("  Not connected  \r\n"))
    trace(linkText(""))
    trace(linkText("command failed: No such device (-19)\n"))
    trace(linkText("Connected to x\n\tSSID:  my phone  net \r\n\tsignal: - 4\n\tsignal: -7x\n"))
    trace(linkText("\n Connected to x\n\tfreq: \n freq: 12abc\n\trx bitrate: 1. MBit/s\n\ttx bitrate: .5 MBit/\n\ttx bitrate: 3 MBit/s"))
    trace(linkText("Connected to x\nNot connected.."))
    trace(linkText("Connected to x\n  \n Not connected. \t"))
    wireless: Str = "Inter-| sta\n face | tus | link level noise\n wlan0: 0000   70.  -40.  -256\n"
    trace(intText(parseWireless(wireless, "wlan0")))
    trace(intText(parseWireless(" wlan0: 0000   70.  200.  -256\n", "wlan0")))
    trace(intText(parseWireless(" wlan0: 0000   70.\n", "wlan0")))
    trace(intText(parseWireless(" wlan0: 0000 70 x\n wlan0: 1 2 -3", "wlan0")))
    trace(intText(parseWireless(" eth0: 1 2 3\r wlan0:\t1\t2\t-9.75", "wlan0")))
    trace(intText(parseWireless(" wlan0: 1 2 nan", "wlan0")))
    trace(intText(parseWireless("", "wlan0")))
    managed: Maybe<Str> = firstManaged("phy#0\n\tInterface p2p0\n\t\ttype P2P-device\n\tInterface wlan0\n\t\ttype managed\n")
    trace(managed.unwrapOr("None"))
    trace(firstManaged("").unwrapOr("None"))
    trace(firstManaged("type managed\nInterface  wlan1  x\r\n type managed ").unwrapOr("None"))
    trace(words("  a\tbb  c ").size())
    trace(splitLines("a\r\nb\rc\n\nd\n").size())
}

kira.os as os

// kira:os's Datagram and Ready (D84), value types: built with the declaration's defaults, changed only as a new
// value (`with`), compared field by field, as a field, in a List, a Map and a Maybe, and returned anew.

pub Seen: Struct {
    pub last: Datagram = Datagram { }
    pub ready: Maybe<Ready> = null
}

pub made: (size: Size, host: Str) Datagram {
    Datagram { size = size, host = host }
}

bumped: (d: Datagram) Datagram {
    d with {
        port = port + 1
    }
}

show: (d: Datagram) Void {
    println("${d.size} ${d.host}:${d.port}")
}

pub main: () Int32 {
    d: Datagram = Datagram { 3, "10.0.0.2", 9 }
    e: Mutable<Datagram> = d with {
        port = 10
    }
    show(d)
    show(e)
    trace(d == e)
    trace(d != e)
    e = e with {
        port = 9
    }
    trace(d == e)

    r: Ready = Ready { }
    trace(r.handle)
    trace(r.events)
    p: Ready = Ready { events = POLL_READ | POLL_ERROR }
    trace(p.handle)
    trace(p.events)

    s: Mutable<Seen> = Seen { }
    show(s.last)
    trace(s.ready.isNone())
    s = s with {
        last = d
        ready = p
    }
    t: Seen = s with {
        last = bumped(last) with {
            port = 1
        }
    }
    show(s.last)
    show(t.last)
    trace(s.ready.unwrap() == p)

    ds: Mutable<List<Datagram>> = @listOf(d, made(1, "a"))
    kept: List<Datagram> = List<Datagram> { values = ds.toArr() }
    ds.add(made(2, "b"))
    trace(kept.size())
    trace(ds.contains(Datagram { 1, "a", 0 }))
    trace(ds.contains(Datagram { 1, "a", 1 }))
    show(ds[2])

    byHost: Mutable<Map<Str, Ready>> = Map<Str, Ready> { }
    byHost["x"] = p
    trace(byHost.containsValue(Ready { -1, 5 }))

    f: Mutable<Datagram> = made(5, "c")
    f = bumped(f)
    f = bumped(f)
    show(f)
    f.port
}

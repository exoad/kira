// Radix literals past Int64 as an unsigned type's bits, and the \uXXXX escape.

pub main: () Int32 {
    all: UInt64 { 0xFFFFFFFFFFFFFFFF }
    top: UInt64 { 0x8000000000000000 }
    half: UInt32 { 0x80000000 }
    minus: Int64 { 0xFFFFFFFFFFFFFFFF }
    trace("${all} ${top} ${half} ${minus}")
    s: Str { "caf\u00e9 A\u00DF" }
    hex: Mutable<Str> { "" }
    bItems: List<UInt8> { s.bytes() }
    bIndex: Mutable<Size> { 0 }
    while bIndex < bItems.size() {
        b: UInt8 { bItems.get(bIndex) }
        hex = hex + b.toHex().padStart(2, '0')
        bIndex += 1
    }
    trace(hex)
    trace("${s == "café Aß"}")
    0
}

// Foreign opaque handle: no body (like @_magic class Int32). C pointer in emit.
pub @_opaque MiniSurface: Any

@_extern miniCreate: (w: Int32, h: Int32, title: Str) MiniSurface

@_extern miniClosed: (s: MiniSurface) Int32

@_extern miniClear: (s: MiniSurface, color: Int32) Void

@_extern miniPresent: (s: MiniSurface) Void

@_extern miniDestroy: (s: MiniSurface) Void

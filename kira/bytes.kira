module "kira:bytes"

// Byte-order-explicit reads and writes over borrowed byte views, and a strict
// decimal parser over a borrowed character view. None of these allocate, so
// they are available in the freestanding profile too; fromHex's List is hosted.
//
// Every `read*Le` reads little-endian at byte offset `at` and panics when
// the view is too short; every `write*Le` is the inverse over a `MutView`.
// The `*Be` set is its big-endian twin (D53): the same widths, the same
// signedness and the same panic, the most significant byte first.

pub @_magic fx readU16Le: (buf: View<UInt8>, at: Size) UInt16;
pub @_magic fx readU32Le: (buf: View<UInt8>, at: Size) UInt32;
pub @_magic fx readU64Le: (buf: View<UInt8>, at: Size) UInt64;
pub @_magic fx readF32Le: (buf: View<UInt8>, at: Size) Float32;
pub @_magic fx readF64Le: (buf: View<UInt8>, at: Size) Float64;

pub @_magic fx writeU16Le: (buf: MutView<UInt8>, at: Size, value: UInt16) Void;
pub @_magic fx writeU32Le: (buf: MutView<UInt8>, at: Size, value: UInt32) Void;
pub @_magic fx writeU64Le: (buf: MutView<UInt8>, at: Size, value: UInt64) Void;
pub @_magic fx writeF32Le: (buf: MutView<UInt8>, at: Size, value: Float32) Void;
pub @_magic fx writeF64Le: (buf: MutView<UInt8>, at: Size, value: Float64) Void;

pub @_magic fx readU16Be: (buf: View<UInt8>, at: Size) UInt16;
pub @_magic fx readU32Be: (buf: View<UInt8>, at: Size) UInt32;
pub @_magic fx readU64Be: (buf: View<UInt8>, at: Size) UInt64;
pub @_magic fx readF32Be: (buf: View<UInt8>, at: Size) Float32;
pub @_magic fx readF64Be: (buf: View<UInt8>, at: Size) Float64;

pub @_magic fx writeU16Be: (buf: MutView<UInt8>, at: Size, value: UInt16) Void;
pub @_magic fx writeU32Be: (buf: MutView<UInt8>, at: Size, value: UInt32) Void;
pub @_magic fx writeU64Be: (buf: MutView<UInt8>, at: Size, value: UInt64) Void;
pub @_magic fx writeF32Be: (buf: MutView<UInt8>, at: Size, value: Float32) Void;
pub @_magic fx writeF64Be: (buf: MutView<UInt8>, at: Size, value: Float64) Void;

// Strict: an optional sign, then decimal digits and nothing else; none on
// any other text or on overflow. Locale-free.
pub @_magic fx parseInt64: (text: View<Char>) Maybe<Int64>;

// Where pattern first occurs in data at or after start, -1 for nowhere: bytes.find's answer, an empty
// pattern found at start unless start is past the end.
pub @_magic fx findBytes: (data: View<UInt8>, pattern: View<UInt8>, start: Size) Int64;
// CRC-16/XMODEM (polynomial 0x1021, no reflection, no final XOR) of data from init, as binascii.crc_hqx.
pub @_magic fx crc16Xmodem: (data: View<UInt8>, init: UInt16) UInt16;
// bytes.fromhex: hex pairs in either case, ASCII whitespace between pairs; none for any other text.
pub @_magic fx fromHex: (text: Str) Maybe<List<UInt8>>;

module "kira:stl"

pub @_magic class Any
pub @_magic class Void
pub @_magic class Never

pub @_magic class Bool

pub @_magic @_global true: Bool = Bool { }
pub @_magic @_global false: Bool = Bool { }

pub trait Equatable<T> {
    pub fx equals(other: T): Bool;
}

pub trait Hashable {
    pub fx hashCode(): Int64;
}

pub @_magic class Str: Equatable<Str>, Hashable {
    pub fx length(): Int32;
    pub fx isEmpty(): Bool;
    pub fx substring(start: Int32, end: Int32): Str;
    pub fx charAt(index: Int32): Str;
    pub fx contains(value: Str): Bool;
    pub fx startsWith(prefix: Str): Bool;
    pub fx endsWith(suffix: Str): Bool;
    pub fx split(delimiter: Str): List<Str>;
    pub fx trim(): Str;
    pub fx toLower(): Str;
    pub fx toUpper(): Str;
}

pub @_magic class Num: Equatable<Num>, Hashable {
    pub fx abs(): Num;
    pub fx toInt32(): Int32;
    pub fx toInt64(): Int64;
    pub fx toFloat32(): Float32;
    pub fx toFloat64(): Float64;
}

pub @_magic class Int8: Num
pub @_magic class Int16: Num
pub @_magic class Int32: Num
pub @_magic class Int64: Num
pub @_magic class Float32: Num
pub @_magic class Float64: Num

pub alias Int as Int32
pub alias Float as Float32

pub trait Tuple<T> {
    pub fx size(): Int32
}

pub @_magic class Tuple0: Tuple<Void> {
    pub fx size(): Int32 {
        return 0
    }
}

pub @_magic class Tuple1<T> : Tuple<Tuple1<T>> {
    require pub first: T

    pub fx size(): Int32 {
        return 1
    }
}

pub @_magic class Tuple2<A, B>: Tuple<Tuple2<A, B>> {
    require pub first: A
    require pub second: B

    pub fx size(): Int32 {
        return 2
    }
}

pub alias Pair<A, B> as Tuple2<A, B>

pub @_magic class Tuple3<A, B, C>: Tuple<Tuple3<A, B, C>> {
    require pub first: A
    require pub second: B
    require pub third: C

    pub fx size(): Int32 {
        return 3
    }
}

pub @_magic class Tuple4<A, B, C, D>: Tuple<Tuple4<A, B, C, D>> {
    require pub first: A
    require pub second: B
    require pub third: C
    require pub fourth: D

    pub fx size(): Int32 {
        return 4
    }
}

pub @_magic class Tuple5<A, B, C, D, E>: Tuple<Tuple5<A, B, C, D, E>> {
    require pub first: A
    require pub second: B
    require pub third: C
    require pub fourth: D
    require pub fifth: E

    pub fx size(): Int32 {
        return 5
    }
}

pub @_magic class Tuple6<A, B, C, D, E, F>: Tuple<Tuple6<A, B, C, D, E, F>> {
    require pub first: A
    require pub second: B
    require pub third: C
    require pub fourth: D
    require pub fifth: E
    require pub sixth: F

    pub fx size(): Int32 {
        return 6
    }
}

pub @_magic class Tuple7<A, B, C, D, E, F, G>: Tuple<Tuple7<A, B, C, D, E, F, G>> {
    require pub first: A
    require pub second: B
    require pub third: C
    require pub fourth: D
    require pub fifth: E
    require pub sixth: F
    require pub seventh: G

    pub fx size(): Int32 {
        return 7
    }
}

pub @_magic class Tuple8<A, B, C, D, E, F, G, H>: Tuple<Tuple8<A, B, C, D, E, F, G, H>> {
    require pub first: A
    require pub second: B
    require pub third: C
    require pub fourth: D
    require pub fifth: E
    require pub sixth: F
    require pub seventh: G
    require pub eighth: H

    pub fx size(): Int32 {
        return 8
    }
}

pub @_magic class Tuple9<A, B, C, D, E, F, G, H, I>: Tuple<Tuple9<A, B, C, D, E, F, G, H, I>> {
    require pub first: A
    require pub second: B
    require pub third: C
    require pub fourth: D
    require pub fifth: E
    require pub sixth: F
    require pub seventh: G
    require pub eighth: H
    require pub ninth: I

    pub fx size(): Int32 {
        return 9
    }
}

pub trait Iterable<T> {
    pub fx size(): Int32
    pub fx isEmpty(): Bool;
}

pub @_magic class Arr<T>: Iterable<T> {
    pub fx get(index: Int32): T;
    pub fx set(index: Int32, value: T): Void;
    pub fx contains(value: T): Bool;
    pub fx clone(): Arr<T>;
}

pub @_magic class List<T>: Iterable<T> {
    require values: Arr<T>

    pub fx add(value: T): Void;
    pub fx addAll(values: Arr<T>): Void;
    pub fx get(index: Int32): T;
    pub fx set(index: Int32, value: T): Void;
    pub fx removeAt(index: Int32): T;
    pub fx clear(): Void;
    pub fx contains(value: T): Bool;
    pub fx toArr(): Arr<T>;
}

pub @_magic class Map<K, V> {
    require values: Arr<Tuple2<K, V>>

    pub fx size(): Int32;
    pub fx isEmpty(): Bool;
    pub fx put(key: K, value: V): Void;
    pub fx get(key: K): Maybe<V>;
    pub fx remove(key: K): Maybe<V>;
    pub fx containsKey(key: K): Bool;
    pub fx containsValue(value: V): Bool;
    pub fx keys(): Arr<K>;
    pub fx valuesArr(): Arr<V>;
    pub fx entries(): Arr<Tuple2<K, V>>;
    pub fx clear(): Void;
}

pub @_magic class Set<T> {
    require values: Arr<T>

    pub fx size(): Int32;
    pub fx isEmpty(): Bool;
    pub fx add(value: T): Bool;
    pub fx remove(value: T): Bool;
    pub fx contains(value: T): Bool;
    pub fx toArr(): Arr<T>;
    pub fx clear(): Void;
}

pub @_magic class Maybe<T> {
    require pub value: T

    pub fx isSome(): Bool;
    pub fx isNone(): Bool;
    pub fx unwrap(): T;
    pub fx unwrapOr(defaultValue: T): T;
}

pub @_magic class Result<T, E> {
    require pub value: T
    require pub error: E

    pub fx isOk(): Bool;
    pub fx isErr(): Bool;
    pub fx unwrap(): T;
    pub fx unwrapErr(): E;
}

pub @_magic class Stack<T> {
    require values: List<T>

    pub fx size(): Int32;
    pub fx isEmpty(): Bool;
    pub fx push(value: T): Void;
    pub fx pop(): Maybe<T>;
    pub fx peek(): Maybe<T>;
    pub fx clear(): Void;
}

pub @_magic class Queue<T> {
    require values: List<T>

    pub fx size(): Int32;
    pub fx isEmpty(): Bool;
    pub fx enqueue(value: T): Void;
    pub fx dequeue(): Maybe<T>;
    pub fx peek(): Maybe<T>;
    pub fx clear(): Void;
}

pub @_magic class Deque<T> {
    require values: List<T>

    pub fx size(): Int32;
    pub fx isEmpty(): Bool;
    pub fx pushFront(value: T): Void;
    pub fx pushBack(value: T): Void;
    pub fx popFront(): Maybe<T>;
    pub fx popBack(): Maybe<T>;
    pub fx clear(): Void;
}

pub @_magic class Exception {
    require pub message: Str
}

pub @_magic fx print(value: Any): Void;
pub @_magic fx println(value: Any): Void;
pub @_magic fx eprint(value: Any): Void;

pub @_magic fx sqrt(value: Float64): Float64;
pub @_magic fx pow(base: Float64, exponent: Float64): Float64;
pub @_magic fx floor(value: Float64): Float64;
pub @_magic fx ceil(value: Float64): Float64;
pub @_magic fx round(value: Float64): Float64;
pub @_magic fx sin(value: Float64): Float64;
pub @_magic fx cos(value: Float64): Float64;
pub @_magic fx tan(value: Float64): Float64;
pub @_magic fx abs(value: Float64): Float64;
pub @_magic fx min(a: Float64, b: Float64): Float64;
pub @_magic fx max(a: Float64, b: Float64): Float64;

pub @_magic fx assert(condition: Bool, message: Str): Void;
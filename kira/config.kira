// A project's configuration: project.kira at its root holds `PROJECT: Project = Project { } with { ... }`,
// typed against these declarations and read before anything else. Each default is kira.yaml's.

// How `--target cpp` lays out and names its files (kira.yaml's build.cpp).
pub Cpp: Any {
    // "beside" (X.kira.hxx next to X.kira) or "tree" (under outDir, mirroring each module's name)
    pub layout: Str = "beside"
    pub outDir: Str = "gen/kira"
    // where the runtime is installed, relative to the root; "" is outDir
    pub runtimeDir: Str = ""
    pub lineDirectives: Bool = true
    // a module's dotted name, or a glob of them, to its C++ namespace (`a::b` nests)
    pub namespaces: Map<Str, Str> = Map<Str, Str> { }
    // module globs that emit a header only, and those compiled freestanding
    pub headerOnly: List<Str> = List<Str> { }
    pub freestanding: List<Str> = List<Str> { }
    pub headerExt: Str = ".kira.hxx"
    pub sourceExt: Str = ".kira.cxx"
}

// One project: its name starts every module's (srcDir's a/b.kira is `name.a.b`).
pub Project: Any {
    pub name: Str = ""
    pub author: Str = ""
    pub version: Str = ""
    pub srcDir: Str = "src"
    // path globs under the root whose files are not this project's modules
    pub srcExclude: List<Str> = List<Str> { }
    // "c", "cpp", "js", "py", "neko" or "none"
    pub target: Str = "c"
    // the C target's extra .c or .o files and the flags after them
    pub cSources: List<Str> = List<Str> { }
    pub linkFlags: List<Str> = List<Str> { }
    pub minify: Bool = true
    pub cpp: Cpp = Cpp { }
    // the typer for C and JS: "off", "lenient" or "strict"
    pub types: Str = "off"
    // a file for the compiler's symbol dump; "" for none
    pub emitIr: Str = ""
    // each dependency's name and path, the stdlib's among them
    pub dependencies: Map<Str, Str> = Map<Str, Str> { }
}

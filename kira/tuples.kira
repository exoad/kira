// Fixed-arity product types. `Tuple2` doubles as the entry type for `Map`,
// so `kira:collections` leans on this module.

pub Tuple<T>: Any {
    pub size: () Int32
}

// The type of a function value: `P` is the parameter tuple (`Tuple0` for
// none), `R` the return type. A `mut` in a parameter position of `P`
// (`Fx<Tuple1<mut T>, Void>`, D24) means the callee gets the argument by
// reference.
pub @_magic Fx<P, R>: Any

// A tuple of one type whose length each use fixes, the axiom under variadics: the elements of
// @listOf, @arrOf and @setOf are one (a Map's keys and values in turn). A variadic parameter of
// one is not built yet.
pub @_magic TupleN<T>: Any

pub @_magic Tuple0: Tuple<Void> {
    pub size: () Int32 {
        0
    }
}

pub @_magic Tuple1<T> : Tuple<Tuple1<T>> {
    pub first: T

    pub size: () Int32 {
        1
    }
}

pub @_magic Tuple2<A, B>: Tuple<Tuple2<A, B>> {
    pub first: A
    pub second: B

    pub size: () Int32 {
        2
    }
}

pub Tuple2<A, B> as Pair<A, B>

pub @_magic Tuple3<A, B, C>: Tuple<Tuple3<A, B, C>> {
    pub first: A
    pub second: B
    pub third: C

    pub size: () Int32 {
        3
    }
}

pub @_magic Tuple4<A, B, C, D>: Tuple<Tuple4<A, B, C, D>> {
    pub first: A
    pub second: B
    pub third: C
    pub fourth: D

    pub size: () Int32 {
        4
    }
}

pub @_magic Tuple5<A, B, C, D, E>: Tuple<Tuple5<A, B, C, D, E>> {
    pub first: A
    pub second: B
    pub third: C
    pub fourth: D
    pub fifth: E

    pub size: () Int32 {
        5
    }
}

pub @_magic Tuple6<A, B, C, D, E, F>: Tuple<Tuple6<A, B, C, D, E, F>> {
    pub first: A
    pub second: B
    pub third: C
    pub fourth: D
    pub fifth: E
    pub sixth: F

    pub size: () Int32 {
        6
    }
}

pub @_magic Tuple7<A, B, C, D, E, F, G>: Tuple<Tuple7<A, B, C, D, E, F, G>> {
    pub first: A
    pub second: B
    pub third: C
    pub fourth: D
    pub fifth: E
    pub sixth: F
    pub seventh: G

    pub size: () Int32 {
        7
    }
}

pub @_magic Tuple8<A, B, C, D, E, F, G, H>: Tuple<Tuple8<A, B, C, D, E, F, G, H>> {
    pub first: A
    pub second: B
    pub third: C
    pub fourth: D
    pub fifth: E
    pub sixth: F
    pub seventh: G
    pub eighth: H

    pub size: () Int32 {
        8
    }
}

pub @_magic Tuple9<A, B, C, D, E, F, G, H, I>: Tuple<Tuple9<A, B, C, D, E, F, G, H, I>> {
    pub first: A
    pub second: B
    pub third: C
    pub fourth: D
    pub fifth: E
    pub sixth: F
    pub seventh: G
    pub eighth: H
    pub ninth: I

    pub size: () Int32 {
        9
    }
}

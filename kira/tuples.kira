// Fixed-arity product types. `T2` doubles as the entry type for `Map`,
// so `kira:collections` leans on this module. T7 and up are generated on use, not declared here.

pub Tuple<T>: Any {
    pub size: () Int32
}

// The type of a function value: `P` is the parameter tuple (`T0` for
// none), `R` the return type. A `mut` in a parameter position of `P`
// (`Fx<T1<mut T>, Void>`, D24) means the callee gets the argument by
// reference.
pub @_magic Fx<P, R>: Any

// A tuple of one type whose length each use fixes, the axiom under variadics: the elements of
// @listOf, @arrOf and @setOf are one (a Map's keys and values in turn). A variadic parameter of
// one is not built yet.
pub @_magic TupleN<T>: Any

pub @_magic T0: Tuple<Void> {
    pub size: () Int32 {
        0
    }
}

pub @_magic T1<T> : Tuple<T1<T>> {
    pub first: T

    pub size: () Int32 {
        1
    }
}

pub @_magic T2<A, B>: Tuple<T2<A, B>> {
    pub first: A
    pub second: B

    pub size: () Int32 {
        2
    }
}

pub T2<A, B> as Pair<A, B>

pub @_magic T3<A, B, C>: Tuple<T3<A, B, C>> {
    pub first: A
    pub second: B
    pub third: C

    pub size: () Int32 {
        3
    }
}

pub @_magic T4<A, B, C, D>: Tuple<T4<A, B, C, D>> {
    pub first: A
    pub second: B
    pub third: C
    pub fourth: D

    pub size: () Int32 {
        4
    }
}

pub @_magic T5<A, B, C, D, E>: Tuple<T5<A, B, C, D, E>> {
    pub first: A
    pub second: B
    pub third: C
    pub fourth: D
    pub fifth: E

    pub size: () Int32 {
        5
    }
}

pub @_magic T6<A, B, C, D, E, F>: Tuple<T6<A, B, C, D, E, F>> {
    pub first: A
    pub second: B
    pub third: C
    pub fourth: D
    pub fifth: E
    pub sixth: F

    pub size: () Int32 {
        6
    }
}

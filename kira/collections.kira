// Container types. `Arr`, `List` and `Map` are the three the C backend lowers
// today; `Set` / `Stack` / `Queue` / `Deque` are
// declared so signatures typecheck but still resolve prelude-side.
//
// Containers are values (D44): assigning copies, and every method that
// changes its receiver is a `mut fx`, callable only on a mutable place.
// Lengths and indices are `Size` (D2).

pub Iterable<T>: Any {
    pub size: () Size
    pub isEmpty: () Bool;
}

// A borrowed, read-only window onto contiguous elements (D5). A view is never
// returned when it was taken from a local, and never stored in a class field.
pub @_magic View<T>: Iterable<T> {
    pub size: () Size;
    pub isEmpty: () Bool;
    pub get: (index: Size) T;
    pub from: (at: Size) View<T>;
    pub slice: (at: Size, n: Size) View<T>;
    // A new List holding a copy of the view's elements (D52): what a view
    // keeps past the call that lent it, `buf.slice(at, n).toList()`.
    pub toList: () List<T>;
}

// The mutable counterpart of `View`; converts to `View<T>` implicitly.
pub @_magic MutView<T>: Iterable<T> {
    pub size: () Size;
    pub isEmpty: () Bool;
    pub get: (index: Size) T;
    // Not `mut`: the view itself does not change, only the element it points
    // at (a `T*` with `T& operator[]`, design section 6). A MutView is passed
    // by value and never as a `mut` parameter (5.1), so a `mut fx` here would
    // reject `buf.set(i, v)` on every MutView parameter, its main use.
    pub set: (index: Size, value: T) Void;
    pub from: (at: Size) MutView<T>;
    pub slice: (at: Size, n: Size) MutView<T>;
    pub view: () View<T>;
    // View.toList's twin (D52): a `mut` List's slice is a MutView.
    pub toList: () List<T>;
}

// `Arr<T>` is the growable array; `Arr<T, N>` (D6) is the fixed-size one and
// the typer applies every method declared here to both spellings.
pub @_magic Arr<T>: Iterable<T> {
    pub size: () Size;
    pub isEmpty: () Bool;
    pub get: (index: Size) T;
    pub mut set: (index: Size, value: T) Void;
    pub contains: (value: T) Bool;
    pub clone: () Arr<T>;
    pub view: () View<T>;
    pub from: (at: Size) View<T>;
    pub slice: (at: Size, n: Size) View<T>;
}

pub @_magic List<T>: Iterable<T> {
    values: Arr<T>

    pub size: () Size;
    pub isEmpty: () Bool;
    pub mut add: (value: T) Void;
    pub mut addAll: (values: Arr<T>) Void;
    pub get: (index: Size) T;
    pub mut set: (index: Size, value: T) Void;
    pub mut removeAt: (index: Size) T;
    pub mut clear: () Void;
    pub contains: (value: T) Bool;
    pub toArr: () Arr<T>;
    pub view: () View<T>;
    pub from: (at: Size) View<T>;
    pub slice: (at: Size, n: Size) View<T>;
    // A List<Str> only (D58).
    pub joinToString: (separator: Str) Str;
    // Numbers, Chars or Strs (D61), stable; a float as Kotlin's compareTo: -0.0 below 0.0, NaN last.
    pub mut sort: () Void;
    // Numbers (D61), left to right from 0 (a float from +0.0): an Int32 or Int64 partial sum past T panics.
    // The sum stays a T, never widened: Int8, Int16 and the unsigned types wrap.
    pub sum: () T;
    // Numbers, Chars or Strs (D61); a float list holding a NaN gives a NaN.
    pub minOrNull: () Maybe<T>;
    pub maxOrNull: () Maybe<T>;
}

pub @_magic Map<K, V>: Any {
    values: Arr<Tuple2<K, V>>

    pub size: () Size;
    pub isEmpty: () Bool;
    pub mut put: (key: K, value: V) Void;
    pub get: (key: K) Maybe<V>;
    pub mut remove: (key: K) Maybe<V>;
    pub containsKey: (key: K) Bool;
    pub containsValue: (value: V) Bool;
    pub keys: () Arr<K>;
    pub valuesArr: () Arr<V>;
    pub entries: () Arr<Tuple2<K, V>>;
    pub mut clear: () Void;
}

pub @_magic Set<T>: Any {
    values: Arr<T>

    pub size: () Size;
    pub isEmpty: () Bool;
    pub mut add: (value: T) Bool;
    pub mut remove: (value: T) Bool;
    pub contains: (value: T) Bool;
    pub toArr: () Arr<T>;
    pub mut clear: () Void;
}

pub @_magic Stack<T>: Any {
    values: List<T>

    pub size: () Size;
    pub isEmpty: () Bool;
    pub mut push: (value: T) Void;
    pub mut pop: () Maybe<T>;
    pub peek: () Maybe<T>;
    pub mut clear: () Void;
}

pub @_magic Queue<T>: Any {
    values: List<T>

    pub size: () Size;
    pub isEmpty: () Bool;
    pub mut enqueue: (value: T) Void;
    pub mut dequeue: () Maybe<T>;
    pub peek: () Maybe<T>;
    pub mut clear: () Void;
}

pub @_magic Deque<T>: Any {
    values: List<T>

    pub size: () Size;
    pub isEmpty: () Bool;
    pub mut pushFront: (value: T) Void;
    pub mut pushBack: (value: T) Void;
    pub mut popFront: () Maybe<T>;
    pub mut popBack: () Maybe<T>;
    pub mut clear: () Void;
}

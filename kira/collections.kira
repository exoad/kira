module "kira:collections"

// Container types. `Arr`, `List` and `Map` are the three the C backend lowers
// today (see docs/backend-c.md); `Set` / `Stack` / `Queue` / `Deque` are
// declared so signatures typecheck but still resolve prelude-side.
//
// Containers are values (D44): assigning copies, and every method that
// changes its receiver is a `mut fx`, callable only on a mutable place.
// Lengths and indices are `Size` (D2).

pub trait Iterable<T> {
    pub fx size: () Size
    pub fx isEmpty: () Bool;
}

// A borrowed, read-only window onto contiguous elements (D5). A view is never
// returned when it was taken from a local, and never stored in a class field.
pub @_magic class View<T>: Iterable<T> {
    pub fx size: () Size;
    pub fx isEmpty: () Bool;
    pub fx get: (index: Size) T;
    pub fx from: (at: Size) View<T>;
    pub fx slice: (at: Size, n: Size) View<T>;
}

// The mutable counterpart of `View`; converts to `View<T>` implicitly.
pub @_magic class MutView<T>: Iterable<T> {
    pub fx size: () Size;
    pub fx isEmpty: () Bool;
    pub fx get: (index: Size) T;
    // Not `mut`: the view itself does not change, only the element it points
    // at (a `T*` with `T& operator[]`, design section 6). A MutView is passed
    // by value and never as a `mut` parameter (5.1), so a `mut fx` here would
    // reject `buf.set(i, v)` on every MutView parameter, its main use.
    pub fx set: (index: Size, value: T) Void;
    pub fx from: (at: Size) MutView<T>;
    pub fx slice: (at: Size, n: Size) MutView<T>;
    pub fx view: () View<T>;
}

// `Arr<T>` is the growable array; `Arr<T, N>` (D6) is the fixed-size one and
// the typer applies every method declared here to both spellings.
pub @_magic class Arr<T>: Iterable<T> {
    pub fx size: () Size;
    pub fx isEmpty: () Bool;
    pub fx get: (index: Size) T;
    pub mut fx set: (index: Size, value: T) Void;
    pub fx contains: (value: T) Bool;
    pub fx clone: () Arr<T>;
    pub fx view: () View<T>;
    pub fx from: (at: Size) View<T>;
    pub fx slice: (at: Size, n: Size) View<T>;
}

pub @_magic class List<T>: Iterable<T> {
    require values: Arr<T>

    pub fx size: () Size;
    pub fx isEmpty: () Bool;
    pub mut fx add: (value: T) Void;
    pub mut fx addAll: (values: Arr<T>) Void;
    pub fx get: (index: Size) T;
    pub mut fx set: (index: Size, value: T) Void;
    pub mut fx removeAt: (index: Size) T;
    pub mut fx clear: () Void;
    pub fx contains: (value: T) Bool;
    pub fx toArr: () Arr<T>;
    pub fx view: () View<T>;
    pub fx from: (at: Size) View<T>;
    pub fx slice: (at: Size, n: Size) View<T>;
}

pub @_magic class Map<K, V> {
    require values: Arr<Tuple2<K, V>>

    pub fx size: () Size;
    pub fx isEmpty: () Bool;
    pub mut fx put: (key: K, value: V) Void;
    pub fx get: (key: K) Maybe<V>;
    pub mut fx remove: (key: K) Maybe<V>;
    pub fx containsKey: (key: K) Bool;
    pub fx containsValue: (value: V) Bool;
    pub fx keys: () Arr<K>;
    pub fx valuesArr: () Arr<V>;
    pub fx entries: () Arr<Tuple2<K, V>>;
    pub mut fx clear: () Void;
}

pub @_magic class Set<T> {
    require values: Arr<T>

    pub fx size: () Size;
    pub fx isEmpty: () Bool;
    pub mut fx add: (value: T) Bool;
    pub mut fx remove: (value: T) Bool;
    pub fx contains: (value: T) Bool;
    pub fx toArr: () Arr<T>;
    pub mut fx clear: () Void;
}

pub @_magic class Stack<T> {
    require values: List<T>

    pub fx size: () Size;
    pub fx isEmpty: () Bool;
    pub mut fx push: (value: T) Void;
    pub mut fx pop: () Maybe<T>;
    pub fx peek: () Maybe<T>;
    pub mut fx clear: () Void;
}

pub @_magic class Queue<T> {
    require values: List<T>

    pub fx size: () Size;
    pub fx isEmpty: () Bool;
    pub mut fx enqueue: (value: T) Void;
    pub mut fx dequeue: () Maybe<T>;
    pub fx peek: () Maybe<T>;
    pub mut fx clear: () Void;
}

pub @_magic class Deque<T> {
    require values: List<T>

    pub fx size: () Size;
    pub fx isEmpty: () Bool;
    pub mut fx pushFront: (value: T) Void;
    pub mut fx pushBack: (value: T) Void;
    pub mut fx popFront: () Maybe<T>;
    pub mut fx popBack: () Maybe<T>;
    pub mut fx clear: () Void;
}

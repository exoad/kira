module "kira:math"

// Scalar math.
//
// The @_magic entries below lower to the matching `<math.h>` call, so the
// backend adds the include on first use (see kira/math.bind.yaml). The
// non-magic functions at the bottom are the stdlib written in Kira itself:
// they have real bodies compiled like user code, built on top of the magic
// surface (clamp/lerp are min/max in disguise).
//
// Each magic function takes a Float32 or a Float64 and returns the same type
// (D20): `@_infer` lets a call leave out `<T>`, which the typer takes from the
// arguments, so `sin(x)` with `x: Float32` is Float32 math, as bibo's C++ is.
// This is the only type-argument inference Kira has, and only the stdlib uses it.

pub @_magic @_infer fx sqrt<T: FloatNum>: (value: T) T;
pub @_magic @_infer fx pow<T: FloatNum>: (base: T, exponent: T) T;
pub @_magic @_infer fx floor<T: FloatNum>: (value: T) T;
pub @_magic @_infer fx ceil<T: FloatNum>: (value: T) T;
pub @_magic @_infer fx round<T: FloatNum>: (value: T) T;
pub @_magic @_infer fx sin<T: FloatNum>: (value: T) T;
pub @_magic @_infer fx cos<T: FloatNum>: (value: T) T;
pub @_magic @_infer fx tan<T: FloatNum>: (value: T) T;
pub @_magic @_infer fx abs<T: FloatNum>: (value: T) T;
pub @_magic @_infer fx min<T: FloatNum>: (a: T, b: T) T;
pub @_magic @_infer fx max<T: FloatNum>: (a: T, b: T) T;

pub fx clamp: (value: Float64, lo: Float64, hi: Float64) Float64 {
    return max(lo, min(value, hi))
}

pub fx lerp: (a: Float64, b: Float64, t: Float64) Float64 {
    return a + (b - a) * t
}

pub fx sign: (value: Float64) Int32 {
    if value > 0 {
        return 1
    } else if value < 0 {
        return -1
    } else {
        return 0
    }
}

pub fx step: (edge: Float64, value: Float64) Float64 {
    if value >= edge {
        return 1.0
    } else {
        return 0.0
    }
}

pub fx inverseLerp: (a: Float64, b: Float64, value: Float64) Float64 {
    return (value - a) / (b - a)
}

pub fx deg2rad: (degrees: Float64) Float64 {
    return degrees * 3.141592653589793 / 180.0
}

pub fx rad2deg: (radians: Float64) Float64 {
    return radians * 180.0 / 3.141592653589793
}

pub fx isBetween: (value: Float64, lo: Float64, hi: Float64) Bool {
    return value >= lo && value <= hi
}

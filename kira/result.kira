// Fallible-value types. `Maybe` is the return shape for the partial `Map` /
// `Stack` / `Queue` / `Deque` lookups in `kira:collections`.
//
// `Maybe` answers to both spellings (D40): `isNull` / `value` and
// `isNone` / `unwrap`.

pub @_magic Maybe<T>: Any {
    pub value: T

    pub isSome: () Bool;
    pub isNone: () Bool;
    pub isNull: () Bool;
    pub unwrap: () T;
    pub unwrapOr: (defaultValue: T) T;
}

pub @_magic Result<T, E>: Any {
    pub value: T
    pub error: E

    pub isOk: () Bool;
    pub isErr: () Bool;
    pub unwrap: () T;
    pub unwrapErr: () E;
}

pub @_magic Exception: Any {
    pub message: Str
}

// A shared, mutable cell (the spec's `Ref<T>`, D46): every copy of a `Ref`
// names the same `value`.
pub @_magic Ref<T>: Mutable<Any> {
    pub value: Mutable<T>
}

// A non-owning reference to a class instance. `upgrade` yields the live
// object, or none once every owning reference is gone.
pub @_magic Weak<T>: Any {
    pub upgrade: () Maybe<T>;
}

// An unchecked pointer for FFI seams: no lifetime, no bounds, no nullability.
// Only `@_extern` code hands these out.
pub @_magic Unsafe<T>: Any

module "kira:core"

// Root of the type lattice plus the primitive scalars every other stdlib
// module builds on. Everything here is `@_magic`: the declaration exists so
// the frontend can typecheck against it, and each backend supplies the real
// definition -- the C backend from the prelude (`kira/c/c_generator.c`), the
// C++ backend from the runtime named in `core.bind.yaml`.

pub @_magic class Any
pub @_magic class Void
pub @_magic class Never

pub @_magic class Bool

pub @_magic @_global true: Bool = Bool { }
pub @_magic @_global false: Bool = Bool { }

// `null` is not a keyword -- it is a built-in global of the bottom-ish type
// `Null`, exactly like `true` and `false` are globals of type `Bool`.
//
// `Null` is only assignable to `Maybe<T>` (see kira:result). Every other type
// is non-nullable, so a `Pet` always denotes a live object and a possibly
// absent one is spelled `Maybe<Pet>`.
pub @_magic class Null

pub @_magic @_global null: Null = Null { }

pub trait Equatable<T> {
    pub fx equals: (other: T) Bool;
}

pub trait Hashable {
    pub fx hashCode: () Int64;
}

// Every length and index is a `Size` (D2). `at` reads one code unit as a
// `Char` (D3); `charAt` keeps the older one-character `Str` form.
// `<`, `<=`, `>`, `>=` order by code point (D56): UTF-8's byte order on C++.
pub @_magic class Str: Equatable<Str>, Hashable {
    pub fx length: () Size;
    pub fx size: () Size;
    pub fx isEmpty: () Bool;
    pub fx substring: (start: Size, end: Size) Str;
    pub fx charAt: (index: Size) Str;
    pub fx at: (index: Size) Char;
    pub fx contains: (value: Str) Bool;
    pub fx startsWith: (prefix: Str) Bool;
    pub fx endsWith: (suffix: Str) Bool;
    pub fx find: (value: Str) Maybe<Size>;
    pub fx split: (delimiter: Str) List<Str>;
    pub fx trim: () Str;
    pub fx toLower: () Str;
    pub fx toUpper: () Str;
    pub fx toInt64: () Maybe<Int64>;
    pub fx toFloat64: () Maybe<Float64>;
    pub fx padStart: (width: Size, fill: Char) Str;
    pub fx view: () View<Char>;
    // The text's UTF-8, a new List of its bytes (D54): for text that is valid
    // UTF-8, `s.bytes()` is the same on every target, where `length()` counts what
    // the target's Str holds. A Char above 127 put into text is a raw byte on the
    // C++ target and a Latin-1 code point (two UTF-8 bytes) on py: only ASCII agrees.
    pub fx bytes: () List<UInt8>;
    // `Str.of(bytes: View<UInt8>) Str` (D55), its inverse, is called on the type:
    // the typer makes it, as it does Result.success, so it has no line here. Each
    // ill-formed part of the UTF-8 reads as one U+FFFD, as bytes.decode("utf-8",
    // "replace") reads it in Python.
}

pub @_magic class Num: Equatable<Num>, Hashable {
    pub fx abs: () Num;
    pub fx toInt32: () Int32;
    pub fx toInt64: () Int64;
    pub fx toFloat32: () Float32;
    pub fx toFloat64: () Float64;
}

// The integer types' parent (D51), as FloatNum is the floats'.
pub @_magic class IntNum: Num {
    // Lowercase hex digits, no prefix; a negative value is "-" and its magnitude's
    // digits ("-ff"), so `(v as UInt16).toHex()` gives the bits.
    pub fx toHex: () Str;
}

pub @_magic class Int8: IntNum
pub @_magic class Int16: IntNum
pub @_magic class Int32: IntNum
pub @_magic class Int64: IntNum

// Unsigned integers wrap (D8). `Size` is pointer-width and mixes with no
// other integer type: `i < s.length()` needs `i: Size`.
pub @_magic class UInt8: IntNum
pub @_magic class UInt16: IntNum
pub @_magic class UInt32: IntNum
pub @_magic class UInt64: IntNum
pub @_magic class Size: IntNum

// The bound of kira:math's float functions (D20): `sin<T: FloatNum>` takes a
// Float32 or a Float64 and returns the same type, inferred from the argument.
pub @_magic class FloatNum: Num {
    // `places` decimals, clamped to 0..9, rounded correctly as printf's %.*f (D50):
    // 0.25 is "0.2" with 1, 2.675 "2.67" with 2; any NaN is "nan", an infinity "inf".
    pub fx fixed: (places: Int32) Str;
}

pub @_magic class Float32: FloatNum
pub @_magic class Float64: FloatNum

// An 8-bit code unit. `==`, `!=` and the relational operators compare it
// (relational as unsigned, so every target agrees); nothing arithmetic
// applies. `c as UInt8` and `n as Char` convert.
pub @_magic class Char

pub alias Int as Int32
pub alias Float as Float32

// Reinterprets the bits of `value` as a `T` of the same width. The typer
// special-cases the call: `T` is always the explicit type argument and the
// argument must have `T`'s width.
pub @_magic fx bitCast<T>: (value: Any) T;

// The entry of the integer enum `E` whose value is `raw`, or none (D25): an
// enum has no methods, so this is the free intrinsic. The typer special-cases
// the call: `E` is the explicit type argument and `raw` is an integer.
pub @_magic fx enumOf<E>: (raw: Any) Maybe<E>;

// A fixed-capacity text buffer, `StrBuf<N>` (design section 10): N chars and no
// heap, so a freestanding module builds text in one. The typer takes exactly one
// constant argument, the capacity. Appends past N are dropped. `add` and `set`
// take a view of text; an interpolation passed to them (`buf.set("servo=${s}")`)
// never becomes a Str: it is appended piece by piece, `set` clearing first.
// `addFixed` rounds as FloatNum.fixed does (D50).
pub @_magic class StrBuf {
    pub fx size: () Size;
    pub fx isEmpty: () Bool;
    pub fx view: () View<Char>;
    pub mut fx clear: () Void;
    pub mut fx add: (text: View<Char>) Void;
    pub mut fx addChar: (c: Char) Void;
    pub mut fx addInt: (value: Int64) Void;
    pub mut fx addUInt: (value: UInt64) Void;
    pub mut fx addFixed: (value: Float64, places: Int32) Void;
    pub mut fx set: (text: View<Char>) Void;
}

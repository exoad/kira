// Ranges of numbers. `a..b` is a Range: it holds a, b and every number between, in `x in a..b`, in
// `contains` alike (owner 2026-11-01). `x in a..b` with a written range builds no
// Range: the backends lower it to two comparisons.

pub Range<T: Num>: Struct {
    pub begin: T
    pub end: T

    pub contains: (value: T) Bool {
        value >= begin && value <= end
    }

    pub @_op_in_: (value: T) Bool {
        contains(value)
    }
}
